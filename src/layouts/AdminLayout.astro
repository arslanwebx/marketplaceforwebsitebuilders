---
import '@/styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;

const adminNav = [
  { label: 'Overview', href: '/admin' },
  { label: 'Users & Builders', href: '/admin#users' },
  { label: 'Services Catalog', href: '/admin#services' },
  { label: 'Project Requests', href: '/admin#projects' },
  { label: 'Orders & Escrow', href: '/admin#orders' },
  { label: 'Transactions', href: '/admin#transactions' },
  { label: 'Moderation Queue', href: '/admin#moderation' }
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | CraftGrid Admin</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-[#0F172A] text-slate-100 min-h-screen flex flex-col font-sans antialiased">
    
    <!-- Top Admin Bar -->
    <header class="bg-slate-900 border-b border-slate-800 sticky top-0 z-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between h-16">
        <div class="flex items-center gap-6">
          <a href="/admin" class="flex items-center gap-2">
            <span class="w-8 h-8 rounded-lg bg-primary flex items-center justify-center font-bold text-white text-base">C</span>
            <span class="font-bold text-lg text-white">Craft<span class="text-primary">Grid</span> <span class="text-xs px-2 py-0.5 rounded bg-primary/20 text-primary border border-primary/30 uppercase ml-1">Admin Ops</span></span>
          </a>

          <nav class="hidden md:flex items-center gap-1">
            {adminNav.map(item => (
              <a
                href={item.href}
                class="px-3 py-1.5 rounded-lg text-xs font-medium text-slate-300 hover:text-white hover:bg-slate-800 transition"
              >
                {item.label}
              </a>
            ))}
          </nav>
        </div>

        <div class="flex items-center gap-4 text-xs">
          <span class="text-slate-400">Marcus Hayes (Platform Operations)</span>
          <a
            href="/"
            class="px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 transition"
          >
            ← Back to Marketplace
          </a>
        </div>
      </div>
    </header>

    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <slot />
    </main>

    <footer class="border-t border-slate-800 py-6 text-center text-xs text-slate-500">
      CraftGrid Platform Administration Console · Prototype Demonstration Only
    </footer>
  </body>
</html>
