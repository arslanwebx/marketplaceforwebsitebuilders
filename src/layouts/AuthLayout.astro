---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  subtitle?: string;
}

const { title, subtitle } = Astro.props;
---

<BaseLayout title={`${title} | CraftGrid`}>
  <div class="min-h-[calc(100vh-16rem)] flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-md w-full space-y-8 bg-white p-8 md:p-10 rounded-2xl border border-border shadow-card">
      <div class="text-center">
        <a href="/" class="inline-block mb-4">
          <img src="/brand/logo.svg" alt="CraftGrid" class="h-10 w-auto mx-auto" />
        </a>
        <h1 class="text-2xl font-bold tracking-tight text-dark">{title}</h1>
        {subtitle && (
          <p class="mt-2 text-sm text-secondary">{subtitle}</p>
        )}
      </div>

      <slot />
    </div>
  </div>
</BaseLayout>
