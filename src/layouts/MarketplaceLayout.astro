---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title?: string;
  description?: string;
  breadcrumbs?: { label: string; href?: string }[];
}

const { title, description, breadcrumbs } = Astro.props;
---

<BaseLayout title={title} description={description}>
  {breadcrumbs && breadcrumbs.length > 0 && (
    <div class="border-b border-border bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
        <nav class="flex items-center space-x-2 text-xs text-secondary" aria-label="Breadcrumb">
          <a href="/" class="hover:text-primary transition">Home</a>
          {breadcrumbs.map((crumb, idx) => (
            <span class="flex items-center space-x-2">
              <span class="text-slate-400">/</span>
              {crumb.href && idx < breadcrumbs.length - 1 ? (
                <a href={crumb.href} class="hover:text-primary transition">{crumb.label}</a>
              ) : (
                <span class="text-slate-900 font-medium">{crumb.label}</span>
              )}
            </span>
          ))}
        </nav>
      </div>
    </div>
  )}

  <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-10">
    <slot />
  </div>
</BaseLayout>
