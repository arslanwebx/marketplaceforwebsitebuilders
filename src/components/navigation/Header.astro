---
import { siteConfig } from '@/config/site';
import UserNavDropdown from './UserNavDropdown';
import RoleSwitcher from './RoleSwitcher';
import MobileMenu from './MobileMenu';

interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;
---

<header class="sticky top-0 z-40 w-full bg-white/95 backdrop-blur-md border-b border-border shadow-subtle transition-all">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 md:h-[72px]">
      
      <!-- Brand Logo -->
      <div class="flex items-center gap-6">
        <a href="/" class="flex items-center gap-3 group focus:outline-none" aria-label="CraftGrid Homepage">
          <img src="/brand/logo.svg" alt="CraftGrid" class="h-8 md:h-10 w-auto transition-transform" />
        </a>

        <!-- Prototype Role Indicator Switcher -->
        <div class="hidden lg:flex items-center">
          <RoleSwitcher client:load />
        </div>
      </div>

      <!-- Center Desktop Navigation -->
      <nav class="hidden md:flex items-center gap-1 lg:gap-2">
        
        <!-- Find Services with Dropdown -->
        <div class="relative group">
          <a
            href="/services"
            class:list={[
              "flex items-center gap-1.5 px-3 py-2 rounded-lg text-sm font-medium transition",
              currentPath.startsWith('/services')
                ? "text-primary bg-soft-primary"
                : "text-slate-700 hover:text-primary hover:bg-slate-50"
            ]}
          >
            <span>Find Services</span>
            <svg class="w-3.5 h-3.5 text-slate-400 group-hover:text-primary transition-transform group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </a>

          <!-- Hover Dropdown Menu -->
          <div class="absolute left-0 mt-1 w-80 rounded-xl bg-white shadow-dropdown border border-border py-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
            <div class="px-3 py-1.5 text-[11px] font-semibold text-slate-400 uppercase tracking-wider">
              Popular Website Categories
            </div>
            {siteConfig.nav.serviceDropdown.map(item => (
              <a
                href={item.href}
                class="flex flex-col px-3 py-2 rounded-lg mx-1 hover:bg-slate-50 transition"
              >
                <span class="text-sm font-medium text-slate-800 hover:text-primary">{item.label}</span>
                <span class="text-xs text-slate-500 font-normal">{item.description}</span>
              </a>
            ))}
            <div class="border-t border-border mt-1 pt-1.5 px-3">
              <a href="/services" class="text-xs font-semibold text-primary hover:text-primary-hover flex items-center justify-between py-1">
                <span>View all marketplace services</span>
                <span>→</span>
              </a>
            </div>
          </div>
        </div>

        <!-- Find Talent -->
        <a
          href="/talent"
          class:list={[
            "px-3 py-2 rounded-lg text-sm font-medium transition",
            currentPath.startsWith('/talent')
              ? "text-primary bg-soft-primary"
              : "text-slate-700 hover:text-primary hover:bg-slate-50"
          ]}
        >
          Find Talent
        </a>

        <!-- Browse Projects -->
        <a
          href="/projects"
          class:list={[
            "px-3 py-2 rounded-lg text-sm font-medium transition",
            currentPath.startsWith('/projects')
              ? "text-primary bg-soft-primary"
              : "text-slate-700 hover:text-primary hover:bg-slate-50"
          ]}
        >
          Browse Projects
        </a>

        <!-- How It Works -->
        <a
          href="/how-it-works"
          class:list={[
            "px-3 py-2 rounded-lg text-sm font-medium transition",
            currentPath === '/how-it-works'
              ? "text-primary bg-soft-primary"
              : "text-slate-700 hover:text-primary hover:bg-slate-50"
          ]}
        >
          How It Works
        </a>
      </nav>

      <!-- Right Header Actions (Auth / User Nav) -->
      <div class="flex items-center gap-3">
        <UserNavDropdown client:load currentPath={currentPath} />
        <MobileMenu client:load />
      </div>

    </div>
  </div>
</header>
