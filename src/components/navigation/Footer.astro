---
import { siteConfig } from '@/config/site';
---

<footer class="bg-white border-t border-border mt-auto">
  <!-- Main Footer Content -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-16 pb-12">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-8 lg:gap-12">
      
      <!-- Company Brand & Address Block -->
      <div class="lg:col-span-2 space-y-4">
        <a href="/" class="flex items-center gap-2" aria-label="CraftGrid Homepage">
          <img src="/brand/logo.svg" alt="CraftGrid" class="h-7 w-auto" />
        </a>
        <p class="text-sm text-secondary leading-relaxed max-w-sm">
          {siteConfig.tagline} {siteConfig.description}
        </p>

        <!-- Fictional demo company details -->
        <div class="pt-2 text-xs text-slate-500 space-y-1">
          <p class="font-medium text-slate-700">{siteConfig.company.name}</p>
          <p>{siteConfig.company.address}, {siteConfig.company.suite}</p>
          <p>{siteConfig.company.city}, {siteConfig.company.state} {siteConfig.company.postalCode}, {siteConfig.company.country}</p>
          <p class="pt-1">
            <span class="text-slate-600">Phone:</span> {siteConfig.company.phone}
          </p>
          <p>
            <span class="text-slate-600">General:</span>{' '}
            <a href={`mailto:${siteConfig.company.emails.general}`} class="text-primary hover:underline">{siteConfig.company.emails.general}</a>
            {' · '}
            <span class="text-slate-600">Support:</span>{' '}
            <a href={`mailto:${siteConfig.company.emails.support}`} class="text-primary hover:underline">{siteConfig.company.emails.support}</a>
          </p>
          <p class="text-[11px] text-slate-400 italic">Hours: {siteConfig.company.hours}</p>
        </div>
      </div>

      <!-- Marketplace Links -->
      <div>
        <h3 class="text-xs font-semibold text-dark uppercase tracking-wider mb-4">Marketplace</h3>
        <ul class="space-y-2.5">
          {siteConfig.nav.footer.marketplace.map(item => (
            <li>
              <a href={item.href} class="text-sm text-secondary hover:text-primary transition">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Platform & Workflow Links -->
      <div>
        <h3 class="text-xs font-semibold text-dark uppercase tracking-wider mb-4">Platform</h3>
        <ul class="space-y-2.5">
          {siteConfig.nav.footer.platform.map(item => (
            <li>
              <a href={item.href} class="text-sm text-secondary hover:text-primary transition">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Company & Legal -->
      <div>
        <h3 class="text-xs font-semibold text-dark uppercase tracking-wider mb-4">Company & Legal</h3>
        <ul class="space-y-2.5">
          {siteConfig.nav.footer.company.map(item => (
            <li>
              <a href={item.href} class="text-sm text-secondary hover:text-primary transition">
                {item.label}
              </a>
            </li>
          ))}
          {siteConfig.nav.footer.legal.map(item => (
            <li>
              <a href={item.href} class="text-sm text-secondary hover:text-primary transition">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

    </div>

    <!-- Bottom Bar with Demo Prototype Disclaimer -->
    <div class="mt-12 pt-8 border-t border-border flex flex-col md:flex-row items-center justify-between gap-4">
      <p class="text-xs text-secondary text-center md:text-left">
        &copy; {new Date().getFullYear()} {siteConfig.company.name} All rights reserved. 
        <span class="block sm:inline sm:ml-1 text-slate-400">
          // Fictional demo company information and prototype interface.
        </span>
      </p>

      <div class="flex items-center gap-6 text-xs text-secondary">
        <a href="/terms" class="hover:text-primary transition">Terms of Service</a>
        <a href="/privacy" class="hover:text-primary transition">Privacy Policy</a>
        <a href="/trust-safety" class="hover:text-primary transition">Trust & Safety</a>
        <a href="/admin" class="hover:text-primary transition font-medium text-slate-700">Admin Portal</a>
      </div>
    </div>
  </div>
</footer>
