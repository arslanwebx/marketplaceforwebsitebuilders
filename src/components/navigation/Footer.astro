---
import { siteConfig } from '@/config/site';
---

<footer class="bg-white border-t border-border mt-auto">
  <!-- Main Footer Content -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-16 pb-12">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-8 lg:gap-12">
      
      <!-- Company Brand & Address Block -->
      <div class="lg:col-span-2 space-y-4">
        <a href="/" class="flex items-center gap-2" aria-label="CraftGrid Homepage">
          <img src="/brand/logo.svg" alt="CraftGrid" class="h-7 w-auto" />
        </a>
        <p class="text-sm text-secondary leading-relaxed max-w-sm">
          {siteConfig.tagline} {siteConfig.description}
        </p>

        <!-- Company Details -->
        <div class="pt-2 text-xs text-secondary space-y-1.5 leading-relaxed">
          <p class="font-semibold text-dark">{siteConfig.company.name}</p>
          <p>{siteConfig.company.address}, {siteConfig.company.suite}</p>
          <p>{siteConfig.company.city}, {siteConfig.company.state} {siteConfig.company.postalCode}, {siteConfig.company.country}</p>
          <div class="pt-1 flex flex-wrap gap-x-4 gap-y-1">
            <span><strong class="text-dark font-medium">Phone:</strong> {siteConfig.company.phone}</span>
            <span><strong class="text-dark font-medium">Email:</strong> <a href={`mailto:${siteConfig.company.emails.general}`} class="text-primary hover:underline">{siteConfig.company.emails.general}</a></span>
          </div>
          <p class="text-[12px] text-slate-500">Business Hours: {siteConfig.company.hours}</p>
        </div>
      </div>

      <!-- Marketplace Links -->
      <div>
        <h3 class="text-xs font-bold text-dark uppercase tracking-wider mb-4">Marketplace</h3>
        <ul class="space-y-2.5">
          {siteConfig.nav.footer.marketplace.map(item => (
            <li>
              <a href={item.href} class="text-sm text-secondary hover:text-primary transition font-medium">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Platform & Workflow Links -->
      <div>
        <h3 class="text-xs font-bold text-dark uppercase tracking-wider mb-4">Platform</h3>
        <ul class="space-y-2.5">
          {siteConfig.nav.footer.platform.map(item => (
            <li>
              <a href={item.href} class="text-sm text-secondary hover:text-primary transition font-medium">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Company & Legal -->
      <div>
        <h3 class="text-xs font-bold text-dark uppercase tracking-wider mb-4">Company & Legal</h3>
        <ul class="space-y-2.5">
          {siteConfig.nav.footer.company.map(item => (
            <li>
              <a href={item.href} class="text-sm text-secondary hover:text-primary transition font-medium">
                {item.label}
              </a>
            </li>
          ))}
          {siteConfig.nav.footer.legal.map(item => (
            <li>
              <a href={item.href} class="text-sm text-secondary hover:text-primary transition font-medium">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="mt-12 pt-8 border-t border-border flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-secondary">
      <div class="flex flex-col sm:flex-row items-center gap-2 text-center md:text-left">
        <p>&copy; {new Date().getFullYear()} {siteConfig.company.name}. All rights reserved.</p>
        <span class="hidden sm:inline text-slate-300">·</span>
        <p class="text-slate-500 font-medium">Built for portfolio purposes.</p>
      </div>

      <div class="flex flex-wrap items-center justify-center gap-6 font-medium">
        <a href="/terms" class="hover:text-primary transition">Terms of Service</a>
        <a href="/privacy" class="hover:text-primary transition">Privacy Policy</a>
        <a href="/trust-safety" class="hover:text-primary transition">Trust & Safety</a>
        <a href="/admin" class="hover:text-primary transition text-slate-700">Admin Console</a>
      </div>
    </div>
  </div>
</footer>
