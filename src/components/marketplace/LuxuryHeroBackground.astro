---
/**
 * LuxuryHeroBackground.astro
 * 
 * "LUXURY ORBITAL WEB ARCHITECTURE" - Refined Luxury Edition
 * 
 * A lighter, more translucent, and spatially layered coded background for CraftGrid.
 * 
 * Refinements:
 * 1. Opacity Calibration:
 *    - Major rings/arcs: 0.08 to 0.16
 *    - Minor rings/arcs: 0.03 to 0.07
 *    - Blueprint rectangles: 0.03 to 0.05
 *    - Precision glass nodes: 0.14 to 0.22
 *    - Micro-technical marks: 0.04 to 0.08
 * 2. Multi-Layer Background Gradient:
 *    - White base (#FFFFFF / #FCFCFF) with cool-lavender atmospheric glows
 *    - Upper-right orbit field, left-middle wash, bottom stats glow, bright center
 * 3. Glassy / Translucent SVG Artwork:
 *    - Delicate stroke gradients, soft focal blurs, masked fades, drop-shadowed nodes
 * 4. Three Spatial Depth Layers:
 *    - Layer A (Back): Ambient blurred color fields, faint blueprint wireframes
 *    - Layer B (Middle): Orbital systems, counter-rotating dashed paths, connector curve
 *    - Layer C (Front): Floating glass nodes, 4-point star, sparse coordinate crosshairs
 * 5. Slow, Restrained Luxury Motion:
 *    - 36s celestial rotation, 48s counter-orbit, 18s ambient glow breathing
 *    - Fully respects prefers-reduced-motion
 * 6. Center Safe Area (x: 260–1050, y: 120–570) preserved pristine and bright
 */
---

<div class="luxury-orbital-bg absolute inset-0 pointer-events-none overflow-hidden select-none z-0" aria-hidden="true">
  
  <!-- BASE LAYER: Clean Luxury White Canvas -->
  <div class="absolute inset-0 bg-[#FFFFFF]"></div>
  <div class="absolute inset-0 bg-gradient-to-b from-[#FFFFFF] via-[#FCFCFF] to-[#F8F8FD]"></div>

  <!-- MULTI-LAYER LUXURY AMBIENT GLOWS (CSS Color Fields) -->
  <!-- Glow 1: Upper-Right Orbital System Atmosphere -->
  <div class="ambient-glow ambient-glow-ur absolute top-[-90px] right-[-60px] w-[680px] h-[680px] rounded-full bg-[radial-gradient(circle_at_center,rgba(99,91,255,0.045)_0%,rgba(183,178,255,0.025)_40%,transparent_70%)] blur-[95px]"></div>
  
  <!-- Glow 2: Left-Middle Subtle Lavender Wash -->
  <div class="ambient-glow ambient-glow-left absolute top-[210px] left-[-90px] w-[540px] h-[540px] rounded-full bg-[radial-gradient(circle_at_center,rgba(122,114,255,0.035)_0%,rgba(234,232,255,0.02)_45%,transparent_70%)] blur-[85px]"></div>
  
  <!-- Glow 3: Lower-Center / Stats Area Soft Illumination -->
  <div class="ambient-glow ambient-glow-bottom absolute bottom-[-110px] left-1/2 -translate-x-1/2 w-[880px] h-[320px] rounded-full bg-[radial-gradient(ellipse_at_center,rgba(99,91,255,0.025)_0%,rgba(183,178,255,0.01)_50%,transparent_75%)] blur-[90px]"></div>

  <!-- Center Radial Brightener: Guarantees Headline & Search Contrast -->
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_50%_36%,rgba(255,255,255,0.92)_0%,rgba(255,255,255,0.3)_55%,transparent_100%)]"></div>

  <!-- MAIN SVG COMPOSITION -->
  <svg
    class="absolute inset-0 w-full h-full pointer-events-none"
    viewBox="0 0 1440 760"
    preserveAspectRatio="xMidYMid slice"
    xmlns="http://www.w3.org/2000/svg"
  >
    <defs>
      <!-- Soft Ambient Blur for Deep Color Fields -->
      <filter id="ambient-disc-blur" x="-50%" y="-50%" width="200%" height="200%">
        <feGaussianBlur stdDeviation="60" />
      </filter>

      <!-- Glassy Atmospheric Focus for Selected Outer Rings -->
      <filter id="ring-glass-blur" x="-20%" y="-20%" width="140%" height="140%">
        <feGaussianBlur stdDeviation="0.8" />
      </filter>

      <!-- Soft Drop Shadow for Glass Nodes -->
      <filter id="glass-node-shadow" x="-50%" y="-50%" width="200%" height="200%">
        <feDropShadow dx="0" dy="1.5" stdDeviation="2.5" flood-color="#635BFF" flood-opacity="0.16" />
      </filter>

      <!-- Delicate Node Halo Blur -->
      <filter id="node-halo" x="-50%" y="-50%" width="200%" height="200%">
        <feGaussianBlur stdDeviation="4" result="glow" />
        <feMerge>
          <feMergeNode in="glow" />
          <feMergeNode in="SourceGraphic" />
        </feMerge>
      </filter>

      <!-- Upper-Right Translucent Purple Disc Gradient -->
      <radialGradient id="disc-grad-ur" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#635BFF" stop-opacity="0.065" />
        <stop offset="50%" stop-color="#7A72FF" stop-opacity="0.025" />
        <stop offset="100%" stop-color="#7A72FF" stop-opacity="0" />
      </radialGradient>

      <!-- Left-Lower Translucent Purple Disc Gradient -->
      <radialGradient id="disc-grad-ll" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#635BFF" stop-opacity="0.05" />
        <stop offset="55%" stop-color="#B7B2FF" stop-opacity="0.015" />
        <stop offset="100%" stop-color="#B7B2FF" stop-opacity="0" />
      </radialGradient>

      <!-- Orbital Stroke Gradient 1 (Translucent Purple -> Soft Lavender -> Zero) -->
      <linearGradient id="orbit-grad-1" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#635BFF" stop-opacity="0.18" />
        <stop offset="45%" stop-color="#7A72FF" stop-opacity="0.12" />
        <stop offset="85%" stop-color="#B7B2FF" stop-opacity="0.05" />
        <stop offset="100%" stop-color="#EAE8FF" stop-opacity="0" />
      </linearGradient>

      <!-- Orbital Stroke Gradient 2 (Lavender -> Soft Purple -> Subtle Fade) -->
      <linearGradient id="orbit-grad-2" x1="100%" y1="0%" x2="0%" y2="100%">
        <stop offset="0%" stop-color="#7A72FF" stop-opacity="0.15" />
        <stop offset="50%" stop-color="#635BFF" stop-opacity="0.09" />
        <stop offset="100%" stop-color="#635BFF" stop-opacity="0.02" />
      </linearGradient>

      <!-- Left-Bottom Arc Gradient -->
      <linearGradient id="left-arc-grad" x1="0%" y1="100%" x2="100%" y2="0%">
        <stop offset="0%" stop-color="#635BFF" stop-opacity="0.16" />
        <stop offset="50%" stop-color="#7A72FF" stop-opacity="0.09" />
        <stop offset="100%" stop-color="#B7B2FF" stop-opacity="0.02" />
      </linearGradient>

      <!-- Giant Curved Connector Path Gradient (Transparent in Center Safe Zone) -->
      <linearGradient id="connector-grad" x1="0%" y1="0%" x2="100%" y2="0%">
        <stop offset="0%" stop-color="#635BFF" stop-opacity="0.16" />
        <stop offset="22%" stop-color="#7A72FF" stop-opacity="0.11" />
        <stop offset="48%" stop-color="#B7B2FF" stop-opacity="0.03" />
        <stop offset="68%" stop-color="#7A72FF" stop-opacity="0.09" />
        <stop offset="100%" stop-color="#635BFF" stop-opacity="0.18" />
      </linearGradient>

      <!-- Subtle Linear Shimmer on Connector Path -->
      <linearGradient id="connector-shimmer-grad" x1="0%" y1="0%" x2="100%" y2="0%">
        <stop offset="0%" stop-color="#635BFF" stop-opacity="0" />
        <stop offset="45%" stop-color="#FFFFFF" stop-opacity="0.3" />
        <stop offset="50%" stop-color="#635BFF" stop-opacity="0.4" />
        <stop offset="55%" stop-color="#FFFFFF" stop-opacity="0.3" />
        <stop offset="100%" stop-color="#635BFF" stop-opacity="0" />
      </linearGradient>
    </defs>

    <!-- ============================================================== -->
    <!-- LAYER A: BACK (Ambient Translucent Discs & Faint Blueprints)   -->
    <!-- ============================================================== -->

    <!-- Disc 1: Upper-Right behind main orbit (cx: 1240, cy: 250, r: 240) -->
    <circle
      cx="1240"
      cy="250"
      r="240"
      fill="url(#disc-grad-ur)"
      filter="url(#ambient-disc-blur)"
    />

    <!-- Disc 2: Left-Lower balancing glow (cx: -20, cy: 620, r: 250) -->
    <circle
      cx="-20"
      cy="620"
      r="250"
      fill="url(#disc-grad-ll)"
      filter="url(#ambient-disc-blur)"
    />

    <!-- Disc 3: Lower-Right near stats row (cx: 1100, cy: 700, r: 210) -->
    <circle
      cx="1100"
      cy="700"
      r="210"
      fill="url(#disc-grad-ur)"
      filter="url(#ambient-disc-blur)"
      opacity="0.6"
    />

    <!-- Architectural Blueprint Outlines (Very Faint & Glassy: Opacity 0.03 - 0.05) -->
    <g class="blueprint-elements hidden md:block" opacity="0.65">
      
      <!-- Upper-Right Abstract Website Blueprint (220 x 120 rounded rect) -->
      <g transform="translate(1165, 48)">
        <rect
          x="0"
          y="0"
          width="215"
          height="115"
          rx="7"
          fill="none"
          stroke="#635BFF"
          stroke-width="0.75"
          opacity="0.045"
        />
        <!-- Header Bar -->
        <line x1="0" y1="20" x2="215" y2="20" stroke="#635BFF" stroke-width="0.5" opacity="0.04" />
        <!-- Header Micro-Dots -->
        <circle cx="10" cy="10" r="1.2" fill="#635BFF" opacity="0.10" />
        <circle cx="15" cy="10" r="1.2" fill="#635BFF" opacity="0.10" />
        <circle cx="20" cy="10" r="1.2" fill="#635BFF" opacity="0.10" />
        <!-- 2 Content Columns -->
        <rect
          x="10"
          y="30"
          width="70"
          height="72"
          rx="3"
          fill="none"
          stroke="#635BFF"
          stroke-width="0.5"
          stroke-dasharray="2 3"
          opacity="0.035"
        />
        <rect
          x="88"
          y="30"
          width="117"
          height="72"
          rx="3"
          fill="none"
          stroke="#635BFF"
          stroke-width="0.5"
          stroke-dasharray="2 3"
          opacity="0.035"
        />
        <!-- Tiny Card Blocks Inside -->
        <rect x="96" y="38" width="46" height="26" rx="2" fill="none" stroke="#111827" stroke-width="0.5" opacity="0.03" />
        <rect x="148" y="38" width="46" height="26" rx="2" fill="none" stroke="#111827" stroke-width="0.5" opacity="0.03" />
        <line x1="96" y1="74" x2="190" y2="74" stroke="#635BFF" stroke-width="0.5" opacity="0.035" />
        <line x1="96" y1="82" x2="162" y2="82" stroke="#635BFF" stroke-width="0.5" opacity="0.03" />
      </g>

      <!-- Left-Middle Edge Partial Browser Frame Cropped Outside Viewport -->
      <g transform="translate(-40, 245)">
        <rect
          x="0"
          y="0"
          width="185"
          height="135"
          rx="7"
          fill="none"
          stroke="#635BFF"
          stroke-width="0.75"
          opacity="0.04"
        />
        <line x1="0" y1="22" x2="185" y2="22" stroke="#635BFF" stroke-width="0.5" opacity="0.035" />
        <circle cx="56" cy="11" r="1.2" fill="#635BFF" opacity="0.09" />
        <circle cx="62" cy="11" r="1.2" fill="#635BFF" opacity="0.09" />
        <circle cx="68" cy="11" r="1.2" fill="#635BFF" opacity="0.09" />
        <rect x="56" y="34" width="115" height="38" rx="3" fill="none" stroke="#111827" stroke-width="0.5" opacity="0.03" />
        <rect x="56" y="80" width="115" height="38" rx="3" fill="none" stroke="#111827" stroke-width="0.5" opacity="0.025" />
      </g>

      <!-- Bottom-Right: 2 Overlapping Thin Rectangles -->
      <g transform="translate(1230, 530)">
        <rect
          x="0"
          y="0"
          width="150"
          height="90"
          rx="5"
          fill="none"
          stroke="#635BFF"
          stroke-width="0.75"
          stroke-dasharray="3 3"
          opacity="0.04"
        />
        <rect
          x="35"
          y="22"
          width="150"
          height="90"
          rx="5"
          fill="none"
          stroke="#111827"
          stroke-width="0.65"
          opacity="0.03"
        />
        <text
          x="8"
          y="16"
          font-family="ui-monospace, monospace"
          font-size="7"
          fill="#635BFF"
          opacity="0.15"
          letter-spacing="0.12em"
        >
          SYS // SCHEMA_04
        </text>
      </g>
    </g>

    <!-- ============================================================== -->
    <!-- LAYER B: MIDDLE (Refined Orbital Systems & Connector Curve)    -->
    <!-- ============================================================== -->

    <!-- Left-Bottom Balancer Arc System (cx: -40, cy: 660) -->
    <g class="orbital-left-bottom">
      <!-- Ring 1: Gradient Stroke (Radius 270) -->
      <circle
        cx="-40"
        cy="660"
        r="270"
        fill="none"
        stroke="url(#left-arc-grad)"
        stroke-width="1.1"
        stroke-dasharray="260 70 140 60"
        opacity="0.15"
      />
      <!-- Ring 2: Delicate Dashed Geometry (Radius 340) -->
      <circle
        cx="-40"
        cy="660"
        r="340"
        fill="none"
        stroke="#7A72FF"
        stroke-width="0.85"
        stroke-dasharray="5 9"
        opacity="0.11"
        filter="url(#ring-glass-blur)"
      />
      <!-- Ring 3: Very Faint Inner Arc (Radius 200) -->
      <circle
        cx="-40"
        cy="660"
        r="200"
        fill="none"
        stroke="url(#left-arc-grad)"
        stroke-width="0.75"
        stroke-dasharray="160 50 90 40"
        opacity="0.08"
      />
      <!-- Radial Alignment Ray entering from corner -->
      <line
        x1="-40"
        y1="660"
        x2="230"
        y2="470"
        stroke="#635BFF"
        stroke-width="0.6"
        stroke-dasharray="3 8"
        opacity="0.07"
      />
      <!-- Elegant Intersection Node where arc and ray meet (x: 160, y: 517) -->
      <circle cx="160" cy="517" r="7" fill="#635BFF" opacity="0.06" filter="url(#node-halo)" />
      <circle cx="160" cy="517" r="3.5" fill="white" stroke="#635BFF" stroke-width="1.2" filter="url(#glass-node-shadow)" opacity="0.85" />
      <circle cx="160" cy="517" r="1.2" fill="#635BFF" opacity="0.8" />
    </g>

    <!-- Giant Curved Connection Path with Traveling Shimmer -->
    <g class="connector-group hidden sm:block">
      <!-- Base Gradient Path -->
      <path
        d="M 0 500 C 180 460, 260 430, 380 435 C 550 442, 660 565, 800 580 C 970 598, 1140 470, 1250 350"
        fill="none"
        stroke="url(#connector-grad)"
        stroke-width="1.0"
        stroke-linecap="round"
      />
      <!-- Subtle Traveling Shimmer Highlight -->
      <path
        class="connector-shimmer-line"
        d="M 0 500 C 180 460, 260 430, 380 435 C 550 442, 660 565, 800 580 C 970 598, 1140 470, 1250 350"
        fill="none"
        stroke="url(#connector-shimmer-grad)"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-dasharray="140 1200"
      />
      <!-- 3 Small Architectural Nodes along the connection path -->
      <!-- Node 1: (380, 435) - Glass Node -->
      <circle cx="380" cy="435" r="3.5" fill="white" stroke="#635BFF" stroke-width="1.2" filter="url(#glass-node-shadow)" opacity="0.85" />
      <circle cx="380" cy="435" r="1.2" fill="#635BFF" opacity="0.75" />
      
      <!-- Node 2: (800, 580) - Soft Breathing Node -->
      <circle cx="800" cy="580" r="2.5" fill="#7A72FF" opacity="0.5" class="orbital-breathe-node" />
      
      <!-- Node 3: (1140, 462) - Glass Node -->
      <circle cx="1140" cy="462" r="3.5" fill="white" stroke="#635BFF" stroke-width="1.2" filter="url(#glass-node-shadow)" opacity="0.85" />
      <circle cx="1140" cy="462" r="1.2" fill="#635BFF" opacity="0.75" />
    </g>

    <!-- Large Right-Side Orbital Circle System (cx: 1250, cy: 250) -->
    <g class="orbital-system-right">
      
      <!-- Main Celestial Rotating Group (Slow 36s Rotation) -->
      <g class="orbital-rotate-cw">
        
        <!-- Ring 1: r = 130 (Delicate Inner Orbit) -->
        <circle
          cx="1250"
          cy="250"
          r="130"
          fill="none"
          stroke="url(#orbit-grad-1)"
          stroke-width="1.0"
          stroke-dasharray="210 50 130 40"
          opacity="0.16"
        />

        <!-- Ring 2: r = 190 (Middle Translucent Orbit) -->
        <circle
          cx="1250"
          cy="250"
          r="190"
          fill="none"
          stroke="url(#orbit-grad-2)"
          stroke-width="0.9"
          stroke-dasharray="280 70 120 45"
          opacity="0.13"
        />

        <!-- Ring 3: r = 265 (Primary Architectural Track) -->
        <circle
          cx="1250"
          cy="250"
          r="265"
          fill="none"
          stroke="url(#orbit-grad-1)"
          stroke-width="1.1"
          stroke-dasharray="390 100 200 70"
          opacity="0.15"
        />

        <!-- Slightly Stronger Accent Arc Segment on Ring 3 (Visual Focus) -->
        <path
          d="M 1030 110 A 265 265 0 0 1 1250 -15"
          fill="none"
          stroke="#635BFF"
          stroke-width="1.25"
          opacity="0.17"
        />

        <!-- Ring 4: r = 340 (Outer Atmospheric Ring with Soft Glassy Focus) -->
        <circle
          cx="1250"
          cy="250"
          r="340"
          fill="none"
          stroke="url(#orbit-grad-2)"
          stroke-width="0.75"
          stroke-dasharray="500 140 280 90"
          opacity="0.09"
          filter="url(#ring-glass-blur)"
        />

        <!-- Precision Hairline Radial Geometry Rays -->
        <line
          x1="1250"
          y1="250"
          x2="960"
          y2="105"
          stroke="#635BFF"
          stroke-width="0.6"
          stroke-dasharray="3 8"
          opacity="0.07"
        />
        <line
          x1="1250"
          y1="250"
          x2="1010"
          y2="415"
          stroke="#7A72FF"
          stroke-width="0.6"
          stroke-dasharray="3 7"
          opacity="0.06"
        />

        <!-- Floating Glass Nodes along the Orbital Paths (Layer B/C) -->
        <!-- Node A: on r=130 path (cx: 1158, cy: 158) - White Glass Node -->
        <g class="orbital-drifting-node-1">
          <circle cx="1158" cy="158" r="4" fill="white" stroke="#635BFF" stroke-width="1.2" filter="url(#glass-node-shadow)" opacity="0.9" />
          <circle cx="1158" cy="158" r="1.2" fill="#635BFF" opacity="0.75" />
        </g>

        <!-- Node B: on r=130 path (cx: 1355, cy: 326) - Subtle Purple Accent -->
        <circle cx="1355" cy="326" r="2.5" fill="#635BFF" opacity="0.55" class="orbital-breathe-node" />

        <!-- Node C: on r=190 path (cx: 1075, cy: 176) - White Glass Node -->
        <g class="orbital-drifting-node-2">
          <circle cx="1075" cy="176" r="3.5" fill="white" stroke="#7A72FF" stroke-width="1.2" filter="url(#glass-node-shadow)" opacity="0.85" />
          <circle cx="1075" cy="176" r="1.2" fill="#7A72FF" opacity="0.7" />
        </g>

        <!-- Node D: on r=190 path (cx: 1250, cy: 440) - Subtle Dot -->
        <circle cx="1250" cy="440" r="2.5" fill="#635BFF" opacity="0.45" />

        <!-- Node E: on r=265 path (cx: 998, cy: 334) - White Glass Node with Halo -->
        <g class="orbital-drifting-node-3">
          <circle cx="998" cy="334" r="6" fill="#635BFF" opacity="0.04" filter="url(#node-halo)" />
          <circle cx="998" cy="334" r="4" fill="white" stroke="#635BFF" stroke-width="1.2" filter="url(#glass-node-shadow)" opacity="0.9" />
          <circle cx="998" cy="334" r="1.2" fill="#635BFF" opacity="0.75" />
        </g>

        <!-- Node F: on r=265 path (cx: 1435, cy: 88) - Subtle Dot -->
        <circle cx="1435" cy="88" r="2.5" fill="#7A72FF" opacity="0.45" />

        <!-- Node G: on r=340 path (cx: 935, cy: 140) - Glass Node -->
        <circle cx="935" cy="140" r="3" fill="white" stroke="#635BFF" stroke-width="1.1" filter="url(#glass-node-shadow)" opacity="0.8" />

        <!-- Node H: on r=340 path (cx: 1110, cy: 566) - Subtle Purple Node -->
        <circle cx="1110" cy="566" r="2.5" fill="#635BFF" opacity="0.5" class="orbital-breathe-node" />
      </g>

      <!-- Counter-Rotating Nested Dashed Orbit (r=190, Slow 48s Reverse Rotation) -->
      <circle
        class="orbital-rotate-ccw"
        cx="1250"
        cy="250"
        r="190"
        fill="none"
        stroke="#7A72FF"
        stroke-width="0.75"
        stroke-dasharray="3 14"
        opacity="0.10"
      />
    </g>

    <!-- ============================================================== -->
    <!-- LAYER C: FRONT (Sparse, Intentional Luxury & Coordinate Details)-->
    <!-- ============================================================== -->

    <!-- Tiny 4-Point Star at x=1100, y=140 -->
    <path
      d="M 1100 133 Q 1100 140 1093 140 Q 1100 140 1100 147 Q 1100 140 1107 140 Q 1100 140 1100 133 Z"
      fill="#7A72FF"
      opacity="0.28"
      class="hidden sm:block"
    />

    <!-- Small Ring at x=180, y=300 -->
    <g class="hidden sm:block">
      <circle cx="180" cy="300" r="11" fill="none" stroke="#635BFF" stroke-width="0.8" opacity="0.14" />
      <circle cx="180" cy="300" r="2" fill="#635BFF" opacity="0.18" />
    </g>

    <!-- Designer Grid Details: Sparse, Refined, Outside Safe Center -->
    <g class="coordinate-details hidden md:block">
      
      <!-- Upper Corner Brackets (0.07 Opacity) -->
      <path d="M 100 86 V 74 H 112" fill="none" stroke="#635BFF" stroke-width="0.85" opacity="0.14" />
      <path d="M 1328 74 H 1340 V 86" fill="none" stroke="#635BFF" stroke-width="0.85" opacity="0.14" />

      <!-- Minimalist Crosshairs (+) (0.07 Opacity) -->
      <!-- Top-Left Crosshair (+) -->
      <path d="M 144 110 H 154 M 149 105 V 115" stroke="#635BFF" stroke-width="0.85" opacity="0.15" />
      
      <!-- Top-Right Crosshair (+) -->
      <path d="M 1374 115 H 1384 M 1379 110 V 120" stroke="#635BFF" stroke-width="0.85" opacity="0.14" />
      
      <!-- Bottom-Left Crosshair (+) -->
      <path d="M 85 620 H 95 M 90 615 V 625" stroke="#635BFF" stroke-width="0.85" opacity="0.16" />
      
      <!-- Bottom-Right Crosshair (+) -->
      <path d="M 1345 675 H 1355 M 1350 670 V 680" stroke="#635BFF" stroke-width="0.85" opacity="0.13" />

      <!-- Sparse Coordinate Dots (·) -->
      <circle cx="210" cy="180" r="1.2" fill="#635BFF" opacity="0.18" />
      <circle cx="120" cy="450" r="1.2" fill="#635BFF" opacity="0.18" />
      <circle cx="1320" cy="460" r="1.2" fill="#635BFF" opacity="0.18" />

      <!-- Below Search Area Subtle Center Tick Mark & Alignment Dots -->
      <path d="M 715 626 H 725" stroke="#635BFF" stroke-width="0.8" opacity="0.10" />
      <circle cx="680" cy="626" r="1.2" fill="#635BFF" opacity="0.12" />
      <circle cx="760" cy="626" r="1.2" fill="#635BFF" opacity="0.12" />

      <!-- Far-Right Precision Vertical Measurement Ruler & Coordinate Label -->
      <g transform="translate(1415, 215)" opacity="0.7">
        <path
          d="M 0 0 H 5 M 0 16 H 2.5 M 0 32 H 2.5 M 0 48 H 2.5 M 0 64 H 5 M 0 80 H 2.5 M 0 96 H 2.5 M 0 112 H 2.5 M 0 128 H 5"
          stroke="#111827"
          stroke-width="0.65"
          opacity="0.11"
        />
        <text
          x="11"
          y="68"
          font-family="ui-monospace, monospace"
          font-size="7"
          fill="#635BFF"
          opacity="0.22"
