---
/**
 * LuxuryHeroBackground.astro
 * 
 * "LUXURY ORBITAL WEB ARCHITECTURE"
 * A bespoke coded SVG hero background designed specifically for CraftGrid.
 * 
 * Features:
 * 1. Large Right-Side Orbital System (concentric rings r=130, 190, 265, 340 with dashes, nodes & gradients)
 * 2. Large Left-Bottom Partial Circle entering from (-40, 660) with glowing intersection node
 * 3. Giant Curved Bezier Connection Path spanning across the lower canvas
 * 4. Architectural Website Blueprint Outlines (browser frame, modular wireframe, overlapping cards)
 * 5. Designer Grid Details (crosshairs, coordinate dots, corner brackets, measurement rulers)
 * 6. One Large Translucent Purple Radial Disc with diffused blur
 * 7. Luxury Details (4-point star, coordinate ticks, precision rings)
 * 8. Center Safe Area preservation (clear zone for headline, search, and CTAs)
 * 9. Ultra-smooth restrained motion with prefers-reduced-motion compliance
 * 10. Clean mobile responsiveness
 */
---

<div class="luxury-orbital-bg absolute inset-0 pointer-events-none overflow-hidden select-none z-0" aria-hidden="true">
  
  <!-- BASE LAYER: Clean Luxury White Canvas with Subtle Depth -->
  <div class="absolute inset-0 bg-[#FCFCFF]"></div>
  <div class="absolute inset-0 bg-gradient-to-b from-[#FCFCFF] via-[#FFFFFF] to-[#F8F9FE] opacity-90"></div>

  <!-- MAIN SVG COMPOSITION -->
  <svg
    class="absolute inset-0 w-full h-full pointer-events-none"
    viewBox="0 0 1440 760"
    preserveAspectRatio="xMidYMid slice"
    xmlns="http://www.w3.org/2000/svg"
  >
    <defs>
      <!-- Soft Blur Filter for the Radial Disc -->
      <filter id="orbital-disc-blur" x="-50%" y="-50%" width="200%" height="200%">
        <feGaussianBlur stdDeviation="55" />
      </filter>

      <!-- Glow Blur for Accent Nodes -->
      <filter id="orbital-node-glow" x="-50%" y="-50%" width="200%" height="200%">
        <feGaussianBlur stdDeviation="5" result="glow" />
        <feMerge>
          <feMergeNode in="glow" />
          <feMergeNode in="SourceGraphic" />
        </feMerge>
      </filter>

      <!-- Soft Drop Shadow for Premium White Nodes -->
      <filter id="orbital-node-shadow" x="-50%" y="-50%" width="200%" height="200%">
        <feDropShadow dx="0" dy="2" stdDeviation="3" flood-color="#635BFF" flood-opacity="0.28" />
      </filter>

      <!-- Large Soft Translucent Purple Radial Disc Gradient -->
      <radialGradient id="disc-radial-grad" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#635BFF" stop-opacity="0.09" />
        <stop offset="55%" stop-color="#756CFF" stop-opacity="0.04" />
        <stop offset="100%" stop-color="#756CFF" stop-opacity="0" />
      </radialGradient>

      <!-- Left-Bottom Soft Field Gradient -->
      <radialGradient id="disc-radial-left" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#635BFF" stop-opacity="0.07" />
        <stop offset="60%" stop-color="#8B82FF" stop-opacity="0.02" />
        <stop offset="100%" stop-color="#8B82FF" stop-opacity="0" />
      </radialGradient>

      <!-- Orbital Stroke Gradients -->
      <linearGradient id="orbital-stroke-1" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#635BFF" stop-opacity="0.32" />
        <stop offset="45%" stop-color="#756CFF" stop-opacity="0.22" />
        <stop offset="85%" stop-color="#A9A3FF" stop-opacity="0.10" />
        <stop offset="100%" stop-color="#E8E6FF" stop-opacity="0.02" />
      </linearGradient>

      <linearGradient id="orbital-stroke-2" x1="100%" y1="0%" x2="0%" y2="100%">
        <stop offset="0%" stop-color="#756CFF" stop-opacity="0.28" />
        <stop offset="50%" stop-color="#635BFF" stop-opacity="0.18" />
        <stop offset="100%" stop-color="#635BFF" stop-opacity="0.05" />
      </linearGradient>

      <linearGradient id="left-bottom-stroke" x1="0%" y1="100%" x2="100%" y2="0%">
        <stop offset="0%" stop-color="#635BFF" stop-opacity="0.30" />
        <stop offset="50%" stop-color="#756CFF" stop-opacity="0.18" />
        <stop offset="100%" stop-color="#B7B2FF" stop-opacity="0.04" />
      </linearGradient>

      <!-- Giant Curved Connection Path Gradient (Subtle Fading Across Center Safe Zone) -->
      <linearGradient id="connector-gradient" x1="0%" y1="0%" x2="100%" y2="0%">
        <stop offset="0%" stop-color="#635BFF" stop-opacity="0.28" />
        <stop offset="22%" stop-color="#756CFF" stop-opacity="0.22" />
        <stop offset="48%" stop-color="#A9A3FF" stop-opacity="0.08" />
        <stop offset="68%" stop-color="#756CFF" stop-opacity="0.15" />
        <stop offset="100%" stop-color="#635BFF" stop-opacity="0.30" />
      </linearGradient>
    </defs>

    <!-- ============================================================== -->
    <!-- DEPTH LAYER 1: BACK (Soft Radial Discs & Architectural Outlines) -->
    <!-- ============================================================== -->

    <!-- Section 6: ONE Large Translucent Purple Disc (cx: 1220, cy: 250, r: 230) -->
    <circle
      cx="1220"
      cy="250"
      r="230"
      fill="url(#disc-radial-grad)"
      filter="url(#orbital-disc-blur)"
    />

    <!-- Left-Bottom Ambient Glow Soft Field -->
    <circle
      cx="-40"
      cy="660"
      r="260"
      fill="url(#disc-radial-left)"
      filter="url(#orbital-disc-blur)"
    />

    <!-- Section 4: Premium Architectural Website Blueprint Elements -->
    <g class="blueprint-elements hidden md:block">
      <!-- Right-Upper Abstract Website Blueprint (220 x 120 rounded rect) -->
      <g transform="translate(1160, 48)" opacity="0.85">
        <rect
          x="0"
          y="0"
          width="220"
          height="120"
          rx="8"
          fill="none"
          stroke="#635BFF"
          stroke-width="0.85"
          opacity="0.09"
        />
        <!-- Header Bar -->
        <line x1="0" y1="22" x2="220" y2="22" stroke="#635BFF" stroke-width="0.65" opacity="0.08" />
        <!-- Header Dots -->
        <circle cx="12" cy="11" r="1.5" fill="#635BFF" opacity="0.20" />
        <circle cx="18" cy="11" r="1.5" fill="#635BFF" opacity="0.20" />
        <circle cx="24" cy="11" r="1.5" fill="#635BFF" opacity="0.20" />
        <!-- 2 Content Columns -->
        <rect
          x="12"
          y="32"
          width="74"
          height="76"
          rx="4"
          fill="none"
          stroke="#635BFF"
          stroke-width="0.6"
          stroke-dasharray="3 3"
          opacity="0.07"
        />
        <rect
          x="94"
          y="32"
          width="114"
          height="76"
          rx="4"
          fill="none"
          stroke="#635BFF"
          stroke-width="0.6"
          stroke-dasharray="3 3"
          opacity="0.07"
        />
        <!-- Tiny Card Blocks Inside Right Column -->
        <rect x="102" y="40" width="46" height="28" rx="2" fill="none" stroke="#111827" stroke-width="0.5" opacity="0.05" />
        <rect x="154" y="40" width="46" height="28" rx="2" fill="none" stroke="#111827" stroke-width="0.5" opacity="0.05" />
        <line x1="102" y1="78" x2="198" y2="78" stroke="#635BFF" stroke-width="0.6" opacity="0.06" />
        <line x1="102" y1="86" x2="168" y2="86" stroke="#635BFF" stroke-width="0.6" opacity="0.05" />
        <line x1="102" y1="94" x2="182" y2="94" stroke="#635BFF" stroke-width="0.6" opacity="0.05" />
      </g>

      <!-- Left-Middle Edge Partial Browser Frame Cropped Outside Viewport -->
      <g transform="translate(-40, 240)" opacity="0.8">
        <rect
          x="0"
          y="0"
          width="190"
          height="140"
          rx="8"
          fill="none"
          stroke="#635BFF"
          stroke-width="0.85"
          opacity="0.08"
        />
        <line x1="0" y1="24" x2="190" y2="24" stroke="#635BFF" stroke-width="0.65" opacity="0.07" />
        <circle cx="56" cy="12" r="1.5" fill="#635BFF" opacity="0.18" />
        <circle cx="63" cy="12" r="1.5" fill="#635BFF" opacity="0.18" />
        <circle cx="70" cy="12" r="1.5" fill="#635BFF" opacity="0.18" />
        <rect x="56" y="36" width="120" height="42" rx="3" fill="none" stroke="#111827" stroke-width="0.5" opacity="0.05" />
        <rect x="56" y="86" width="120" height="42" rx="3" fill="none" stroke="#111827" stroke-width="0.5" opacity="0.04" />
      </g>

      <!-- Bottom-Right: 2 Overlapping Thin Rectangles -->
      <g transform="translate(1220, 520)" opacity="0.85">
        <rect
          x="0"
          y="0"
          width="155"
          height="95"
          rx="6"
          fill="none"
          stroke="#635BFF"
          stroke-width="0.8"
          stroke-dasharray="4 4"
          opacity="0.08"
        />
        <rect
          x="38"
          y="24"
          width="155"
          height="95"
          rx="6"
          fill="none"
          stroke="#111827"
          stroke-width="0.75"
          opacity="0.06"
        />
        <text
          x="10"
          y="18"
          font-family="ui-monospace, monospace"
          font-size="7.5"
          fill="#635BFF"
          opacity="0.22"
          letter-spacing="0.12em"
        >
          SYS // SCHEMA_04
        </text>
      </g>
    </g>

    <!-- ============================================================== -->
    <!-- DEPTH LAYER 2: MIDDLE (Orbital Systems & Connection Path)      -->
    <!-- ============================================================== -->

    <!-- Section 2: Large Left-Bottom Partial Circle (cx: -40, cy: 660) -->
    <g class="orbital-left-bottom">
      <!-- Ring 1: Gradient Stroke (Radius 270) -->
      <circle
        cx="-40"
        cy="660"
        r="270"
        fill="none"
        stroke="url(#left-bottom-stroke)"
        stroke-width="1.25"
        stroke-dasharray="290 60 170 50"
        opacity="0.28"
      />
      <!-- Ring 2: Dotted / Dashed Geometry (Radius 340) -->
      <circle
        cx="-40"
        cy="660"
        r="340"
        fill="none"
        stroke="#756CFF"
        stroke-width="1.0"
        stroke-dasharray="6 8"
        opacity="0.22"
      />
      <!-- Ring 3: Delicate Inner Arc (Radius 200) -->
      <circle
        cx="-40"
        cy="660"
        r="200"
        fill="none"
        stroke="url(#left-bottom-stroke)"
        stroke-width="0.85"
        stroke-dasharray="180 40 120 40"
        opacity="0.18"
      />
      <!-- Radial Alignment Ray entering from corner -->
      <line
        x1="-40"
        y1="660"
        x2="240"
        y2="460"
        stroke="#635BFF"
        stroke-width="0.7"
        stroke-dasharray="3 7"
        opacity="0.15"
      />
      <!-- Glowing Intersection Node where arc and ray meet (x: 160, y: 517) -->
      <circle cx="160" cy="517" r="10" fill="#635BFF" opacity="0.12" filter="url(#orbital-node-glow)" />
      <circle cx="160" cy="517" r="4.5" fill="white" stroke="#635BFF" stroke-width="1.5" filter="url(#orbital-node-shadow)" />
      <circle cx="160" cy="517" r="1.5" fill="#635BFF" />
    </g>

    <!-- Section 3: Giant Curved Connection Path -->
    <!-- Start: (0, 500) -> (300, 430) -> (750, 580) -> (1250, 350) -->
    <g class="connector-group hidden sm:block">
      <path
        d="M 0 500 C 180 460, 260 430, 380 435 C 550 442, 660 565, 800 580 C 970 598, 1140 470, 1250 350"
        fill="none"
        stroke="url(#connector-gradient)"
        stroke-width="1.2"
        stroke-linecap="round"
        opacity="0.26"
      />
      <!-- 3 Small Nodes along the connection path -->
      <!-- Node 1: (380, 435) -->
      <circle cx="380" cy="435" r="4" fill="white" stroke="#635BFF" stroke-width="1.5" filter="url(#orbital-node-shadow)" />
      <circle cx="380" cy="435" r="1.5" fill="#635BFF" />
      <!-- Node 2: (800, 580) -->
      <circle cx="800" cy="580" r="3" fill="#756CFF" opacity="0.85" class="orbital-breathe-node" />
      <!-- Node 3: (1140, 462) -->
      <circle cx="1140" cy="462" r="4" fill="white" stroke="#635BFF" stroke-width="1.5" filter="url(#orbital-node-shadow)" />
      <circle cx="1140" cy="462" r="1.5" fill="#635BFF" />
    </g>

    <!-- Section 1: Large Right-Side Orbital Circle System (cx: 1250, cy: 250) -->
    <g class="orbital-system-right">
      <!-- Main Slow-Rotating Group -->
      <g class="orbital-rotate-cw">
        <!-- Ring 1: r = 130 -->
        <circle
          cx="1250"
          cy="250"
          r="130"
          fill="none"
          stroke="url(#orbital-stroke-1)"
          stroke-width="1.2"
          stroke-dasharray="230 45 150 40"
          opacity="0.27"
        />

        <!-- Ring 2: r = 190 -->
        <circle
          cx="1250"
          cy="250"
          r="190"
          fill="none"
          stroke="url(#orbital-stroke-2)"
          stroke-width="1.1"
          stroke-dasharray="310 65 140 45"
          opacity="0.24"
        />

        <!-- Ring 3: r = 265 -->
        <circle
          cx="1250"
          cy="250"
          r="265"
          fill="none"
          stroke="url(#orbital-stroke-1)"
          stroke-width="1.35"
          stroke-dasharray="440 90 230 75"
          opacity="0.26"
        />
        <!-- Slightly Stronger Purple Arc Segment on Ring 3 -->
        <path
          d="M 1030 110 A 265 265 0 0 1 1250 -15"
          fill="none"
          stroke="#635BFF"
          stroke-width="1.5"
          opacity="0.30"
        />

        <!-- Ring 4: r = 340 -->
        <circle
          cx="1250"
          cy="250"
          r="340"
          fill="none"
          stroke="url(#orbital-stroke-2)"
          stroke-width="0.9"
          stroke-dasharray="560 130 320 80"
          opacity="0.20"
        />

        <!-- Precision Tangent / Radial Geometry Rays -->
        <line
          x1="1250"
          y1="250"
          x2="950"
          y2="100"
          stroke="#635BFF"
          stroke-width="0.75"
          stroke-dasharray="4 8"
          opacity="0.14"
        />
        <line
          x1="1250"
          y1="250"
          x2="1000"
          y2="420"
          stroke="#756CFF"
          stroke-width="0.7"
          stroke-dasharray="3 7"
          opacity="0.12"
        />

        <!-- 5-8 Precision Nodes along the Orbital Paths -->
        <!-- Node A: on r=130 path (cx: 1158, cy: 158) - 8px white circle with purple stroke -->
        <circle cx="1158" cy="158" r="4.5" fill="white" stroke="#635BFF" stroke-width="1.5" filter="url(#orbital-node-shadow)" />
        <circle cx="1158" cy="158" r="1.5" fill="#635BFF" />

        <!-- Node B: on r=130 path (cx: 1355, cy: 326) - solid 3px purple -->
        <circle cx="1355" cy="326" r="3" fill="#635BFF" opacity="0.85" class="orbital-breathe-node" />

        <!-- Node C: on r=190 path (cx: 1075, cy: 176) - 7px white circle with purple stroke -->
        <circle cx="1075" cy="176" r="4" fill="white" stroke="#756CFF" stroke-width="1.5" filter="url(#orbital-node-shadow)" />
        <circle cx="1075" cy="176" r="1.5" fill="#756CFF" />

        <!-- Node D: on r=190 path (cx: 1250, cy: 440) - solid 3px purple -->
        <circle cx="1250" cy="440" r="3" fill="#635BFF" opacity="0.8" />

        <!-- Node E: on r=265 path (cx: 998, cy: 334) - 9px white circle with purple stroke & center dot -->
        <circle cx="998" cy="334" r="4.5" fill="white" stroke="#635BFF" stroke-width="1.5" filter="url(#orbital-node-shadow)" />
        <circle cx="998" cy="334" r="1.5" fill="#635BFF" />

        <!-- Node F: on r=265 path (cx: 1435, cy: 88) - solid 3px purple -->
        <circle cx="1435" cy="88" r="3" fill="#756CFF" opacity="0.75" />

        <!-- Node G: on r=340 path (cx: 935, cy: 140) - 7px white circle with purple stroke -->
        <circle cx="935" cy="140" r="3.5" fill="white" stroke="#635BFF" stroke-width="1.3" filter="url(#orbital-node-shadow)" />

        <!-- Node H: on r=340 path (cx: 1110, cy: 566) - solid 3px purple -->
        <circle cx="1110" cy="566" r="3" fill="#635BFF" opacity="0.8" class="orbital-breathe-node" />
      </g>

      <!-- Counter-Rotating Nested Dashed Ring (r=190, rotates in opposite direction) -->
      <circle
        class="orbital-rotate-ccw"
        cx="1250"
        cy="250"
        r="190"
        fill="none"
        stroke="#756CFF"
        stroke-width="0.85"
        stroke-dasharray="4 12"
        opacity="0.22"
      />
    </g>

    <!-- ============================================================== -->
    <!-- DEPTH LAYER 3: FRONT (Luxury Geometric Technical Details)      -->
    <!-- ============================================================== -->

    <!-- Section 7: Small Luxury Detail Elements -->
    <!-- Tiny 4-Point SVG Star at x=1100, y=140 -->
    <path
      d="M 1100 132 Q 1100 140 1092 140 Q 1100 140 1100 148 Q 1100 140 1108 140 Q 1100 140 1100 132 Z"
      fill="#756CFF"
      opacity="0.45"
      class="hidden sm:block"
    />

    <!-- Small Ring at x=180, y=300 -->
    <g class="hidden sm:block">
      <circle cx="180" cy="300" r="13" fill="none" stroke="#635BFF" stroke-width="1" opacity="0.28" />
      <circle cx="180" cy="300" r="2.5" fill="#635BFF" opacity="0.32" />
    </g>

    <!-- Section 5: Designer Grid / Coordinate Details -->
    <!-- Corner Brackets & Crosshairs (Placed far left, far right, upper corners, below search) -->
    <g class="coordinate-details hidden md:block">
      <!-- Upper-Left Corner Bracket (x: 90, y: 70) -->
      <path d="M 90 84 V 70 H 104" fill="none" stroke="#635BFF" stroke-width="1.1" opacity="0.30" />

      <!-- Upper-Right Corner Bracket (x: 1350, y: 70) -->
      <path d="M 1336 70 H 1350 V 84" fill="none" stroke="#635BFF" stroke-width="1.1" opacity="0.30" />

      <!-- Crosshairs (+) -->
      <!-- Top-Left Crosshair (+) at (140, 110) -->
      <path d="M 134 110 H 146 M 140 104 V 116" stroke="#635BFF" stroke-width="1.1" opacity="0.30" />

      <!-- Top-Right Crosshair (+) at (1390, 120) -->
      <path d="M 1384 120 H 1396 M 1390 114 V 126" stroke="#635BFF" stroke-width="1.1" opacity="0.30" />

      <!-- Bottom-Left Crosshair (+) at (90, 620) -->
      <path d="M 84 620 H 96 M 90 614 V 626" stroke="#635BFF" stroke-width="1.1" opacity="0.32" />

      <!-- Bottom-Right Crosshair (+) at (1350, 680) -->
      <path d="M 1344 680 H 1356 M 1350 674 V 686" stroke="#635BFF" stroke-width="1.1" opacity="0.28" />

      <!-- Coordinate Dots (·) Outside Text Safe Region -->
      <circle cx="210" cy="180" r="1.5" fill="#635BFF" opacity="0.35" />
      <circle cx="120" cy="450" r="1.5" fill="#635BFF" opacity="0.35" />
      <circle cx="1320" cy="460" r="1.5" fill="#635BFF" opacity="0.35" />
      <circle cx="1230" cy="670" r="1.5" fill="#635BFF" opacity="0.35" />

      <!-- Below Search Area Subtle Center Tick Mark & Alignment Dots -->
      <path d="M 714 626 H 726" stroke="#635BFF" stroke-width="1" opacity="0.22" />
      <circle cx="675" cy="626" r="1.5" fill="#635BFF" opacity="0.26" />
      <circle cx="765" cy="626" r="1.5" fill="#635BFF" opacity="0.26" />

      <!-- Far-Right Precision Vertical Measurement Rulers & Label -->
      <g transform="translate(1415, 210)" opacity="0.85">
        <path
          d="M 0 0 H 6 M 0 16 H 3 M 0 32 H 3 M 0 48 H 3 M 0 64 H 6 M 0 80 H 3 M 0 96 H 3 M 0 112 H 3 M 0 128 H 6"
          stroke="#111827"
          stroke-width="0.75"
          opacity="0.22"
        />
        <text
          x="12"
          y="68"
          font-family="ui-monospace, monospace"
          font-size="7.5"
          fill="#635BFF"
          opacity="0.45"
          font-weight="600"
          letter-spacing="0.14em"
          transform="rotate(90 12 68)"
        >
          COORD // 1440.760
        </text>
      </g>

      <!-- Far-Left Precision Technical Baseline Rulers & Label -->
      <g transform="translate(25, 380)" opacity="0.8">
        <path
          d="M 0 0 H 6 M 0 16 H 3 M 0 32 H 3 M 0 48 H 3 M 0 64 H 6 M 0 80 H 3 M 0 96 H 3 M 0 112 H 3 M 0 128 H 6"
          stroke="#111827"
          stroke-width="0.75"
          opacity="0.22"
        />
        <text
          x="-8"
          y="68"
          font-family="ui-monospace, monospace"
          font-size="7.5"
          fill="#111827"
          opacity="0.32"
          font-weight="600"
          letter-spacing="0.14em"
          transform="rotate(-90 -8 68)"
        >
          GRID // PROTOCOL
        </text>
      </g>
    </g>

  </svg>
</div>

<style>
  /* ============================================================== */
  /* SECTION 11: RESTRAINED LUXURY MOTION                            */
  /* ============================================================== */

  .orbital-rotate-cw {
    transform-origin: 1250px 250px;
  }

  .orbital-rotate-ccw {
    transform-origin: 1250px 250px;
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Right orbital system: slow subtle rotation 3–5 degrees over 30 seconds */
    .orbital-rotate-cw {
      animation: orbital-drift-cw 30s ease-in-out infinite alternate;
    }

    /* Counter-rotating dashed orbit in opposite direction */
    .orbital-rotate-ccw {
      animation: orbital-drift-ccw 26s ease-in-out infinite alternate;
    }

    /* Selected accent nodes breathing opacity */
    .orbital-breathe-node {
      animation: node-pulse 4.5s ease-in-out infinite alternate;
    }
  }

  @keyframes orbital-drift-cw {
    0% {
      transform: rotate(-2deg);
    }
    100% {
      transform: rotate(3.5deg);
    }
  }

  @keyframes orbital-drift-ccw {
    0% {
      transform: rotate(3deg);
    }
    100% {
      transform: rotate(-2.5deg);
    }
  }

  @keyframes node-pulse {
    0% {
      opacity: 0.55;
      transform: scale(0.95);
    }
    100% {
      opacity: 1;
      transform: scale(1.1);
    }
  }

  /* ============================================================== */
  /* SECTION 13: MOBILE RESPONSIVENESS                              */
  /* ============================================================== */

  @media (max-width: 768px) {
    .blueprint-elements,
    .connector-group,
    .coordinate-details {
      display: none !important;
    }
    
    /* Keep mobile view clean, showing right orbital flank and bottom-left arc softly */
    .orbital-system-right {
      opacity: 0.85;
    }
    
    .orbital-left-bottom {
      opacity: 0.85;
    }
  }
</style>
