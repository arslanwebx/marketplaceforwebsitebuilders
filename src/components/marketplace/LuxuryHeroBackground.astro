---
/**
 * LuxuryHeroBackground.astro
 * 
 * "LUXURY ORBITAL WEB ARCHITECTURE" - Smooth 50% Transparent Edition
 * 
 * Refinements based on user feedback:
 * 1. Smooth Translucent Circles:
 *    - Removed ALL center dots completely (zero solid dots in the center).
 *    - Made circles 50% transparent (opacity 0.5, translucent smooth gradient fill).
 *    - Replaced solid opaque fills with smooth, glassy, hollow dual-ring optics.
 * 2. Smoother Overall Aesthetic:
 *    - Concentric smooth ripples with delicate stroke gradients.
 *    - Secondary hollow satellite rings with 50% opacity and no center dots.
 *    - Fluid ambient motion with soft breathing and celestial drifts.
 * 3. 100% Preserved Center Safe Zone:
 *    - Eyebrow text, headline, search bar, and CTAs remain in pristine, crystal-clear white/bright space.
 */
---

<div class="luxury-orbital-bg absolute inset-0 pointer-events-none overflow-hidden select-none z-0" aria-hidden="true">
  
  <!-- BASE LAYER: Clean Luxury White Canvas -->
  <div class="absolute inset-0 bg-[#FFFFFF]"></div>
  <div class="absolute inset-0 bg-gradient-to-b from-[#FFFFFF] via-[#FCFCFF] to-[#F8F8FD]"></div>

  <!-- MULTI-LAYER LUXURY AMBIENT GLOWS (CSS Color Fields) -->
  <!-- Glow 1: Upper-Right Orbital System Atmosphere -->
  <div class="ambient-glow ambient-glow-ur absolute top-[-100px] right-[-80px] w-[750px] h-[750px] rounded-full bg-[radial-gradient(circle_at_center,rgba(99,91,255,0.055)_0%,rgba(183,178,255,0.03)_40%,transparent_70%)] blur-[100px]"></div>
  
  <!-- Glow 2: Upper-Left Balancing Light Field -->
  <div class="ambient-glow ambient-glow-ul absolute top-[-60px] left-[-60px] w-[580px] h-[580px] rounded-full bg-[radial-gradient(circle_at_center,rgba(122,114,255,0.04)_0%,rgba(234,232,255,0.02)_45%,transparent_70%)] blur-[90px]"></div>

  <!-- Glow 3: Left-Middle Subtle Lavender Wash -->
  <div class="ambient-glow ambient-glow-left absolute top-[260px] left-[-100px] w-[560px] h-[560px] rounded-full bg-[radial-gradient(circle_at_center,rgba(99,91,255,0.04)_0%,rgba(183,178,255,0.02)_45%,transparent_70%)] blur-[90px]"></div>
  
  <!-- Glow 4: Lower-Center / Stats Area Soft Illumination -->
  <div class="ambient-glow ambient-glow-bottom absolute bottom-[-110px] left-1/2 -translate-x-1/2 w-[920px] h-[340px] rounded-full bg-[radial-gradient(ellipse_at_center,rgba(99,91,255,0.03)_0%,rgba(183,178,255,0.015)_50%,transparent_75%)] blur-[95px]"></div>

  <!-- Center Radial Brightener: Guarantees Headline & Search Contrast -->
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_50%_36%,rgba(255,255,255,0.95)_0%,rgba(255,255,255,0.4)_52%,transparent_100%)]"></div>

  <!-- MAIN SVG COMPOSITION -->
  <svg
    class="absolute inset-0 w-full h-full pointer-events-none"
    viewBox="0 0 1440 760"
    preserveAspectRatio="xMidYMid slice"
    xmlns="http://www.w3.org/2000/svg"
  >
    <defs>
      <!-- Architectural Dot Matrix Pattern for Filled Minimalist Background -->
      <pattern id="hero-dot-grid" width="34" height="34" patternUnits="userSpaceOnUse">
        <circle cx="17" cy="17" r="0.85" fill="#635BFF" opacity="0.10" />
      </pattern>

      <!-- Center Mask: Fades Dot Grid completely away from the Headline and Search Area -->
      <mask id="grid-center-mask">
        <rect width="1440" height="760" fill="white" />
        <ellipse cx="720" cy="350" rx="440" ry="215" fill="black" opacity="0.92" />
      </mask>

      <!-- Soft Ambient Blur for Deep Color Fields -->
      <filter id="ambient-disc-blur" x="-50%" y="-50%" width="200%" height="200%">
        <feGaussianBlur stdDeviation="65" />
      </filter>

      <!-- Glassy Atmospheric Focus for Outer Rings -->
      <filter id="ring-glass-blur" x="-20%" y="-20%" width="140%" height="140%">
        <feGaussianBlur stdDeviation="0.8" />
      </filter>

      <!-- Smooth Translucent Circle Drop Shadow (50% Soft Spread) -->
      <filter id="smooth-circle-shadow" x="-50%" y="-50%" width="200%" height="200%">
        <feDropShadow dx="0" dy="1.5" stdDeviation="3" flood-color="#635BFF" flood-opacity="0.15" />
      </filter>

      <!-- Delicate Circle Halo Glow Filter -->
      <filter id="smooth-circle-halo" x="-50%" y="-50%" width="200%" height="200%">
        <feGaussianBlur stdDeviation="4" result="glow" />
        <feMerge>
          <feMergeNode in="glow" />
          <feMergeNode in="SourceGraphic" />
        </feMerge>
      </filter>

      <!-- Smooth Radial Translucent Fill (50% Transparency, Not Solid) -->
      <radialGradient id="smooth-radial-lens" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#635BFF" stop-opacity="0.09" />
        <stop offset="70%" stop-color="#7A72FF" stop-opacity="0.04" />
        <stop offset="100%" stop-color="#7A72FF" stop-opacity="0.01" />
      </radialGradient>

      <!-- Upper-Right Translucent Purple Disc Gradient -->
      <radialGradient id="disc-grad-ur" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#635BFF" stop-opacity="0.08" />
        <stop offset="50%" stop-color="#7A72FF" stop-opacity="0.03" />
        <stop offset="100%" stop-color="#7A72FF" stop-opacity="0" />
      </radialGradient>

      <!-- Left-Lower Translucent Purple Disc Gradient -->
      <radialGradient id="disc-grad-ll" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#635BFF" stop-opacity="0.06" />
        <stop offset="55%" stop-color="#B7B2FF" stop-opacity="0.02" />
        <stop offset="100%" stop-color="#B7B2FF" stop-opacity="0" />
      </radialGradient>

      <!-- Orbital Stroke Gradient 1 (Translucent Purple -> Soft Lavender -> Zero) -->
      <linearGradient id="orbit-grad-1" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#635BFF" stop-opacity="0.22" />
        <stop offset="45%" stop-color="#7A72FF" stop-opacity="0.14" />
        <stop offset="85%" stop-color="#B7B2FF" stop-opacity="0.06" />
        <stop offset="100%" stop-color="#EAE8FF" stop-opacity="0" />
      </linearGradient>

      <!-- Orbital Stroke Gradient 2 (Lavender -> Soft Purple -> Subtle Fade) -->
      <linearGradient id="orbit-grad-2" x1="100%" y1="0%" x2="0%" y2="100%">
        <stop offset="0%" stop-color="#7A72FF" stop-opacity="0.18" />
        <stop offset="50%" stop-color="#635BFF" stop-opacity="0.11" />
        <stop offset="100%" stop-color="#635BFF" stop-opacity="0.03" />
      </linearGradient>

      <!-- Left-Bottom Arc Gradient -->
      <linearGradient id="left-arc-grad" x1="0%" y1="100%" x2="100%" y2="0%">
        <stop offset="0%" stop-color="#635BFF" stop-opacity="0.20" />
        <stop offset="50%" stop-color="#7A72FF" stop-opacity="0.12" />
        <stop offset="100%" stop-color="#B7B2FF" stop-opacity="0.03" />
      </linearGradient>

      <!-- Upper-Left Secondary Arc Gradient -->
      <linearGradient id="ul-arc-grad" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#7A72FF" stop-opacity="0.18" />
        <stop offset="60%" stop-color="#635BFF" stop-opacity="0.09" />
        <stop offset="100%" stop-color="#B7B2FF" stop-opacity="0.02" />
      </linearGradient>

      <!-- Giant Curved Connector Path Gradient (Transparent in Center Safe Zone) -->
      <linearGradient id="connector-grad" x1="0%" y1="0%" x2="100%" y2="0%">
        <stop offset="0%" stop-color="#635BFF" stop-opacity="0.20" />
        <stop offset="22%" stop-color="#7A72FF" stop-opacity="0.14" />
        <stop offset="48%" stop-color="#B7B2FF" stop-opacity="0.04" />
        <stop offset="68%" stop-color="#7A72FF" stop-opacity="0.12" />
        <stop offset="100%" stop-color="#635BFF" stop-opacity="0.22" />
      </linearGradient>

      <!-- Subtle Linear Shimmer on Connector Path -->
      <linearGradient id="connector-shimmer-grad" x1="0%" y1="0%" x2="100%" y2="0%">
        <stop offset="0%" stop-color="#635BFF" stop-opacity="0" />
        <stop offset="45%" stop-color="#FFFFFF" stop-opacity="0.35" />
        <stop offset="50%" stop-color="#635BFF" stop-opacity="0.5" />
        <stop offset="55%" stop-color="#FFFFFF" stop-opacity="0.35" />
        <stop offset="100%" stop-color="#635BFF" stop-opacity="0" />
      </linearGradient>
    </defs>

    <!-- ============================================================== -->
    <!-- LAYER 0: ARCHITECTURAL DOT MATRIX GRID (Masked Around Center)   -->
    <!-- ============================================================== -->
    <rect
      width="1440"
      height="760"
      fill="url(#hero-dot-grid)"
      mask="url(#grid-center-mask)"
      class="hidden sm:block"
    />

    <!-- ============================================================== -->
    <!-- LAYER A: BACK (Ambient Translucent Discs & Architectural Art)  -->
    <!-- ============================================================== -->

    <!-- Ambient Disc 1: Upper-Right behind main orbit (cx: 1250, cy: 250, r: 260) -->
    <circle
      cx="1250"
      cy="250"
      r="260"
      fill="url(#disc-grad-ur)"
      filter="url(#ambient-disc-blur)"
    />

    <!-- Ambient Disc 2: Left-Lower balancing glow (cx: -20, cy: 620, r: 270) -->
    <circle
      cx="-20"
      cy="620"
      r="270"
      fill="url(#disc-grad-ll)"
      filter="url(#ambient-disc-blur)"
    />

    <!-- Ambient Disc 3: Upper-Left balancing aura (cx: 140, cy: 120, r: 210) -->
    <circle
      cx="140"
      cy="120"
      r="210"
      fill="url(#disc-grad-ll)"
      filter="url(#ambient-disc-blur)"
      opacity="0.7"
    />

    <!-- Ambient Disc 4: Lower-Right near stats row (cx: 1120, cy: 700, r: 220) -->
    <circle
      cx="1120"
      cy="700"
      r="220"
      fill="url(#disc-grad-ur)"
      filter="url(#ambient-disc-blur)"
      opacity="0.6"
    />

    <!-- Upper-Left Secondary Orbital Curve System (Frames Left Side Elegantly) -->
    <g class="orbital-left-upper hidden md:block">
      <!-- Outer Arc r=240 -->
      <circle
        cx="-40"
        cy="100"
        r="240"
        fill="none"
        stroke="url(#ul-arc-grad)"
        stroke-width="1.0"
        stroke-dasharray="160 50 110 60"
        opacity="0.14"
      />
      <!-- Dashed Track r=320 -->
      <circle
        cx="-40"
        cy="100"
        r="320"
        fill="none"
        stroke="#7A72FF"
        stroke-width="0.75"
        stroke-dasharray="4 10"
        opacity="0.10"
      />
      <!-- Alignment Ray -->
      <line
        x1="-40"
        y1="100"
        x2="280"
        y2="280"
        stroke="#635BFF"
        stroke-width="0.6"
        stroke-dasharray="3 7"
        opacity="0.08"
      />
    </g>

    <!-- Architectural Blueprint Outlines (Clean, Structured, Glassy) -->
    <g class="blueprint-elements hidden md:block" opacity="0.8">
      
      <!-- Upper-Right Abstract Website Blueprint (220 x 120 rounded rect) -->
      <g transform="translate(1165, 48)">
        <rect
          x="0"
          y="0"
          width="215"
          height="115"
          rx="7"
          fill="none"
          stroke="#635BFF"
          stroke-width="0.8"
          opacity="0.06"
        />
        <!-- Header Bar -->
        <line x1="0" y1="20" x2="215" y2="20" stroke="#635BFF" stroke-width="0.55" opacity="0.05" />
        <!-- Header Micro-Dots (Hollow translucent micro-rings) -->
        <circle cx="10" cy="10" r="1.3" fill="none" stroke="#635BFF" stroke-width="0.6" opacity="0.3" />
        <circle cx="15" cy="10" r="1.3" fill="none" stroke="#635BFF" stroke-width="0.6" opacity="0.3" />
        <circle cx="20" cy="10" r="1.3" fill="none" stroke="#635BFF" stroke-width="0.6" opacity="0.3" />
        <!-- 2 Content Columns -->
        <rect
          x="10"
          y="30"
          width="70"
          height="72"
          rx="3"
          fill="none"
          stroke="#635BFF"
          stroke-width="0.55"
          stroke-dasharray="2 3"
          opacity="0.045"
        />
        <rect
          x="88"
          y="30"
          width="117"
          height="72"
          rx="3"
          fill="none"
          stroke="#635BFF"
          stroke-width="0.55"
          stroke-dasharray="2 3"
          opacity="0.045"
        />
        <!-- Tiny Card Blocks Inside -->
        <rect x="96" y="38" width="46" height="26" rx="2" fill="none" stroke="#111827" stroke-width="0.5" opacity="0.04" />
        <rect x="148" y="38" width="46" height="26" rx="2" fill="none" stroke="#111827" stroke-width="0.5" opacity="0.04" />
        <line x1="96" y1="74" x2="190" y2="74" stroke="#635BFF" stroke-width="0.5" opacity="0.045" />
        <line x1="96" y1="82" x2="162" y2="82" stroke="#635BFF" stroke-width="0.5" opacity="0.04" />
      </g>

      <!-- Isometric Minimalist Wireframe Cube Accent (Upper Right Flank) -->
      <g transform="translate(1380, 50)" opacity="0.12">
        <polygon points="0,-18 20,-8 0,2 -20,-8" fill="none" stroke="#635BFF" stroke-width="0.75" />
        <polygon points="-20,-8 0,2 0,26 -20,16" fill="none" stroke="#635BFF" stroke-width="0.75" />
        <polygon points="0,2 20,-8 20,16 0,26" fill="none" stroke="#635BFF" stroke-width="0.75" />
      </g>

      <!-- Left-Middle Edge Partial Browser Frame Cropped Outside Viewport -->
      <g transform="translate(-40, 245)">
        <rect
          x="0"
          y="0"
          width="185"
          height="135"
          rx="7"
          fill="none"
          stroke="#635BFF"
          stroke-width="0.8"
          opacity="0.055"
        />
        <line x1="0" y1="22" x2="185" y2="22" stroke="#635BFF" stroke-width="0.55" opacity="0.05" />
        <circle cx="56" cy="11" r="1.3" fill="none" stroke="#635BFF" stroke-width="0.6" opacity="0.3" />
        <circle cx="62" cy="11" r="1.3" fill="none" stroke="#635BFF" stroke-width="0.6" opacity="0.3" />
        <circle cx="68" cy="11" r="1.3" fill="none" stroke="#635BFF" stroke-width="0.6" opacity="0.3" />
        <rect x="56" y="34" width="115" height="38" rx="3" fill="none" stroke="#111827" stroke-width="0.5" opacity="0.04" />
        <rect x="56" y="80" width="115" height="38" rx="3" fill="none" stroke="#111827" stroke-width="0.5" opacity="0.035" />
      </g>

      <!-- Bottom-Right: 2 Overlapping Thin Rectangles -->
      <g transform="translate(1230, 530)">
        <rect
          x="0"
          y="0"
          width="150"
          height="90"
          rx="5"
          fill="none"
          stroke="#635BFF"
          stroke-width="0.8"
          stroke-dasharray="3 3"
          opacity="0.055"
        />
        <rect
          x="35"
          y="22"
          width="150"
          height="90"
          rx="5"
          fill="none"
          stroke="#111827"
          stroke-width="0.7"
          opacity="0.04"
        />
        <text
          x="8"
          y="16"
          font-family="ui-monospace, monospace"
          font-size="7"
          fill="#635BFF"
          opacity="0.20"
          letter-spacing="0.12em"
        >
          SYS // SCHEMA_04
        </text>
      </g>
    </g>

    <!-- ============================================================== -->
    <!-- LAYER B: MIDDLE (Expanded Orbital Systems & Connector Curve)   -->
    <!-- ============================================================== -->

    <!-- Left-Bottom Balancer Arc System (cx: -40, cy: 660) -->
    <g class="orbital-left-bottom">
      <!-- Ring 1: Gradient Stroke (Radius 270) -->
      <circle
        cx="-40"
        cy="660"
        r="270"
        fill="none"
        stroke="url(#left-arc-grad)"
        stroke-width="1.15"
        stroke-dasharray="270 70 150 60"
        opacity="0.18"
      />
      <!-- Ring 2: Delicate Dashed Geometry (Radius 340) -->
      <circle
        cx="-40"
        cy="660"
        r="340"
        fill="none"
        stroke="#7A72FF"
        stroke-width="0.9"
        stroke-dasharray="5 9"
        opacity="0.14"
        filter="url(#ring-glass-blur)"
      />
      <!-- Ring 3: Extended Outer Sweeping Arc (Radius 440) -->
      <circle
        cx="-40"
        cy="660"
        r="440"
        fill="none"
        stroke="url(#left-arc-grad)"
        stroke-width="0.75"
        stroke-dasharray="180 80 120 70"
        opacity="0.10"
      />
      <!-- Ring 4: Very Faint Inner Arc (Radius 200) -->
      <circle
        cx="-40"
        cy="660"
        r="200"
        fill="none"
        stroke="url(#left-arc-grad)"
        stroke-width="0.75"
        stroke-dasharray="160 50 90 40"
        opacity="0.10"
      />
      <!-- Radial Alignment Ray entering from corner -->
      <line
        x1="-40"
        y1="660"
        x2="250"
        y2="460"
        stroke="#635BFF"
        stroke-width="0.65"
        stroke-dasharray="3 8"
        opacity="0.09"
      />
    </g>

    <!-- Giant Curved Connection Path with Traveling Shimmer -->
    <g class="connector-group hidden sm:block">
      <!-- Base Gradient Path -->
      <path
        d="M 0 500 C 180 460, 260 430, 380 435 C 550 442, 660 565, 800 580 C 970 598, 1140 470, 1250 350"
        fill="none"
        stroke="url(#connector-grad)"
        stroke-width="1.1"
        stroke-linecap="round"
      />
      <!-- Subtle Traveling Shimmer Highlight -->
      <path
        class="connector-shimmer-line"
        d="M 0 500 C 180 460, 260 430, 380 435 C 550 442, 660 565, 800 580 C 970 598, 1140 470, 1250 350"
        fill="none"
        stroke="url(#connector-shimmer-grad)"
        stroke-width="1.6"
        stroke-linecap="round"
        stroke-dasharray="140 1200"
      />
      
      <!-- Secondary Faint Echo Connector Arc -->
      <path
        d="M 40 525 C 200 488, 280 458, 380 460 C 530 465, 640 580, 780 595"
        fill="none"
        stroke="url(#connector-grad)"
        stroke-width="0.65"
        stroke-dasharray="4 8"
        opacity="0.10"
      />
    </g>

    <!-- Large Right-Side Orbital Circle System (cx: 1250, cy: 250) -->
    <g class="orbital-system-right">
      
      <!-- Main Celestial Rotating Group (Slow 36s Rotation) -->
      <g class="orbital-rotate-cw">
        
        <!-- Ring 1: r = 130 (Inner Core Track) -->
        <circle
          cx="1250"
          cy="250"
          r="130"
          fill="none"
          stroke="url(#orbit-grad-1)"
          stroke-width="1.1"
          stroke-dasharray="210 50 130 40"
          opacity="0.20"
        />

        <!-- Ring 2: r = 200 (Middle Translucent Orbit) -->
        <circle
          cx="1250"
          cy="250"
          r="200"
          fill="none"
          stroke="url(#orbit-grad-2)"
          stroke-width="1.0"
          stroke-dasharray="290 70 130 45"
          opacity="0.16"
        />

        <!-- Ring 3: r = 280 (Primary Architectural Track) -->
        <circle
          cx="1250"
          cy="250"
          r="280"
          fill="none"
          stroke="url(#orbit-grad-1)"
          stroke-width="1.2"
          stroke-dasharray="410 100 220 70"
          opacity="0.18"
        />

        <!-- Precision Celestial Angle Calibration Ticks along Ring 3 (r=280) -->
        <g opacity="0.16" stroke="#635BFF" stroke-width="0.75">
          <line x1="1530" y1="250" x2="1538" y2="250" />
          <line x1="1520" y1="322" x2="1528" y2="324" />
          <line x1="1492" y1="390" x2="1499" y2="394" />
          <line x1="1448" y1="448" x2="1454" y2="454" />
          <line x1="1520" y1="178" x2="1528" y2="176" />
          <line x1="1492" y1="110" x2="1499" y2="106" />
          <line x1="1448" y1="52" x2="1454" y2="46" />
        </g>

        <!-- Slightly Stronger Accent Arc Segment on Ring 3 (Visual Focus) -->
        <path
          d="M 1015 105 A 280 280 0 0 1 1250 -30"
          fill="none"
          stroke="#635BFF"
          stroke-width="1.35"
          opacity="0.22"
        />

        <!-- Ring 4: r = 370 (Outer Orbital Ring with Glassy Focus) -->
        <circle
          cx="1250"
          cy="250"
          r="370"
          fill="none"
          stroke="url(#orbit-grad-2)"
          stroke-width="0.85"
          stroke-dasharray="540 140 300 90"
          opacity="0.13"
          filter="url(#ring-glass-blur)"
        />

        <!-- Ring 5: r = 480 (Sweeping Ambient Perimeter Orbit) -->
        <circle
          cx="1250"
          cy="250"
          r="480"
          fill="none"
          stroke="url(#orbit-grad-1)"
          stroke-width="0.7"
          stroke-dasharray="400 160 250 120"
          opacity="0.08"
        />

        <!-- Precision Hairline Radial Geometry Rays -->
        <line
          x1="1250"
          y1="250"
          x2="940"
          y2="95"
          stroke="#635BFF"
          stroke-width="0.65"
          stroke-dasharray="3 8"
          opacity="0.09"
        />
        <line
          x1="1250"
          y1="250"
          x2="990"
          y2="425"
          stroke="#7A72FF"
          stroke-width="0.65"
          stroke-dasharray="3 7"
          opacity="0.08"
        />
        <line
          x1="1250"
          y1="250"
          x2="1520"
          y2="90"
          stroke="#635BFF"
          stroke-width="0.65"
          stroke-dasharray="4 8"
          opacity="0.08"
        />
      </g>

      <!-- Counter-Rotating Nested Dashed Orbit (r=200, Slow 48s Reverse Rotation) -->
      <circle
        class="orbital-rotate-ccw"
        cx="1250"
        cy="250"
        r="200"
        fill="none"
        stroke="#7A72FF"
        stroke-width="0.8"
        stroke-dasharray="4 14"
        opacity="0.13"
      />
    </g>

    <!-- ============================================================== -->
    <!-- LAYER C: SMOOTH 50% TRANSPARENT CIRCLES (NO CENTER DOTS)       -->
    <!-- Hollow, smooth, glassy dual-ring optics with 50% transparency  -->
    <!-- ============================================================== -->

    <!-- Circle Node 1: Right Upper Orbit (cx: 1158, cy: 158) -->
    <g class="smooth-circle-node orbital-drifting-node-1" opacity="0.5">
      <!-- Outer smooth ripple -->
      <circle cx="1158" cy="158" r="23" fill="none" stroke="#7A72FF" stroke-width="0.75" stroke-dasharray="3 5" opacity="0.4" class="radar-pulse" />
      <!-- Main smooth translucent circle (50% transparent, no solid fill, no dot) -->
      <circle cx="1158" cy="158" r="13" fill="url(#smooth-radial-lens)" stroke="#635BFF" stroke-width="1.2" filter="url(#smooth-circle-shadow)" />
      <!-- Inner smooth concentric ring (hollow, NO DOT) -->
      <circle cx="1158" cy="158" r="7.5" fill="none" stroke="#7A72FF" stroke-width="0.8" opacity="0.5" />
    </g>

    <!-- Circle Node 2: Right Middle Orbit (cx: 1075, cy: 176) -->
    <g class="smooth-circle-node orbital-drifting-node-2" opacity="0.5">
      <circle cx="1075" cy="176" r="21" fill="none" stroke="#7A72FF" stroke-width="0.75" stroke-dasharray="3 5" opacity="0.38" class="radar-pulse" />
      <circle cx="1075" cy="176" r="12" fill="url(#smooth-radial-lens)" stroke="#7A72FF" stroke-width="1.2" filter="url(#smooth-circle-shadow)" />
