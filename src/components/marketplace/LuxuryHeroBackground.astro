---
/**
 * LuxuryHeroBackground.astro
 * 
 * "LUMINOUS SILK & GLASS ARCHITECTURE"
 * A world-class, ultra-stylish luxury coded background engineered specifically for CraftGrid.
 * 
 * Architecture:
 * 1. Fluid Luminous Silk Canvas:
 *    - GPU-accelerated 60fps Bezier light-wave caustics rendered via HTML5 Canvas.
 *    - Harmonious royal purple (#635BFF), iris lavender (#8B82FF), and crystalline white light.
 *    - Naturally sweeps along flanks and lower perimeters, framing the center.
 * 2. Frosted Glass Architectural Lenses (Glassmorphism):
 *    - Floating frosted glass capsules and crystalline prisms with real backdrop-blur.
 *    - Specular hairline borders, inner light refractions, and floating physics.
 * 3. Multi-Layer Volumetric Light Fields:
 *    - Atmospheric radial gradients providing warmth and depth without clutter.
 *    - Center radial brightener ensuring 100% crisp legibility for headline and search.
 * 4. Crystalline Starlight & Editorial Grain:
 *    - Twinkling 4-point luxury diamond stars and matte editorial paper micro-texture.
 * 5. Interactive Ambient Cursor Damping:
 *    - Subtle, buttery-smooth ambient light follow on desktop.
 * 6. Accessibility & Performance:
 *    - Strictly isolated: position absolute, inset 0, pointer-events none, z-0.
 *    - Automatically pauses when tab is inactive; fully respects prefers-reduced-motion.
 */
---

<div id="craftgrid-luxury-hero-bg" class="luxury-hero-bg absolute inset-0 pointer-events-none overflow-hidden select-none z-0" aria-hidden="true">
  
  <!-- BASE LAYER: Clean Luxury White Canvas -->
  <div class="absolute inset-0 bg-[#FFFFFF]"></div>
  <div class="absolute inset-0 bg-gradient-to-b from-[#FFFFFF] via-[#FCFCFF] to-[#F7F7FD]"></div>

  <!-- MULTI-LAYER AMBIENT VOLUMETRIC GLOWS -->
  <!-- Upper-Right Radiant Iris Bloom -->
  <div class="ambient-glow ambient-ur absolute top-[-120px] right-[-100px] w-[800px] h-[800px] rounded-full bg-[radial-gradient(circle_at_center,rgba(99,91,255,0.065)_0%,rgba(168,85,247,0.03)_35%,rgba(199,210,254,0.015)_60%,transparent_75%)] blur-[100px]"></div>
  
  <!-- Upper-Left Crystalline Periwinkle Wash -->
  <div class="ambient-glow ambient-ul absolute top-[-80px] left-[-80px] w-[650px] h-[650px] rounded-full bg-[radial-gradient(circle_at_center,rgba(122,114,255,0.045)_0%,rgba(224,231,255,0.02)_45%,transparent_70%)] blur-[90px]"></div>

  <!-- Left-Middle Subtle Violet Reflection -->
  <div class="ambient-glow ambient-lm absolute top-[280px] left-[-120px] w-[600px] h-[600px] rounded-full bg-[radial-gradient(circle_at_center,rgba(99,91,255,0.04)_0%,rgba(196,181,253,0.02)_45%,transparent_70%)] blur-[95px]"></div>

  <!-- Lower Stats Zone Soft Illumination -->
  <div class="ambient-glow ambient-bottom absolute bottom-[-130px] left-1/2 -translate-x-1/2 w-[980px] h-[360px] rounded-full bg-[radial-gradient(ellipse_at_center,rgba(99,91,255,0.035)_0%,rgba(165,180,252,0.015)_50%,transparent_75%)] blur-[100px]"></div>

  <!-- Interactive Subtle Ambient Mouse Glow (Follows cursor smoothly on desktop) -->
  <div id="hero-interactive-glow" class="hidden lg:block absolute w-[420px] h-[420px] rounded-full bg-[radial-gradient(circle_at_center,rgba(99,91,255,0.04)_0%,transparent_70%)] blur-[60px] transition-opacity duration-700 opacity-0 pointer-events-none -translate-x-1/2 -translate-y-1/2"></div>

  <!-- FLUID LUMINOUS SILK CANVAS (GPU-accelerated Bezier Light Waves) -->
  <canvas id="hero-silk-canvas" class="absolute inset-0 w-full h-full pointer-events-none"></canvas>

  <!-- FROSTED GLASS ARCHITECTURAL FLOATING LENSES (Glassmorphism) -->
  <!-- Upper-Right Floating Architectural Capsule -->
  <div class="glass-capsule-ur hidden lg:flex absolute top-[18%] right-[5%] xl:right-[8%] flex-col gap-2 p-3.5 rounded-2xl bg-white/45 backdrop-blur-xl border border-white/80 shadow-[0_20px_50px_rgba(99,91,255,0.07),inset_0_1px_1px_rgba(255,255,255,0.9)] w-[210px] transform rotate-[-4deg] transition-transform">
    <div class="flex items-center justify-between">
      <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-[9.5px] font-bold tracking-wider uppercase text-[#635BFF] bg-[#635BFF]/10 border border-[#635BFF]/15">
        <span class="w-1.5 h-1.5 rounded-full bg-[#635BFF] animate-pulse"></span>
        Elite Builders
      </span>
      <span class="text-[9px] font-mono text-slate-400">VERIFIED</span>
    </div>
    <div class="space-y-1.5 pt-1">
      <div class="h-2 w-3/4 rounded-full bg-gradient-to-r from-[#635BFF]/20 to-[#A5B4FC]/20"></div>
      <div class="h-1.5 w-1/2 rounded-full bg-slate-200/60"></div>
    </div>
  </div>

  <!-- Left-Flank Floating Crystalline Orb -->
  <div class="glass-orb-ll hidden lg:block absolute top-[42%] left-[4%] xl:left-[6%] w-[90px] h-[90px] rounded-full bg-gradient-to-tr from-white/20 via-white/50 to-white/10 backdrop-blur-lg border border-white/80 shadow-[0_16px_36px_rgba(99,91,255,0.06),inset_0_1px_2px_rgba(255,255,255,0.95)]">
    <div class="w-full h-full rounded-full flex items-center justify-center">
      <div class="w-10 h-10 rounded-full border border-[#635BFF]/25 border-dashed animate-spin-slow"></div>
    </div>
  </div>

  <!-- Right-Flank Prismatic Refraction Ring -->
  <div class="prismatic-ring hidden xl:block absolute top-[52%] right-[4%] w-[180px] h-[180px] rounded-full p-[1px] bg-gradient-to-tr from-[#635BFF]/35 via-[#C4B5FD]/15 to-transparent pointer-events-none">
    <div class="w-full h-full rounded-full bg-gradient-to-br from-white/15 to-white/5 backdrop-blur-[2px]"></div>
  </div>

  <!-- CENTER RADIAL BRIGHTENER: Guarantees 100% Legibility & Clean Contrast -->
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_50%_40%,rgba(255,255,255,0.96)_0%,rgba(255,255,255,0.75)_42%,rgba(255,255,255,0.15)_70%,transparent_100%)]"></div>

  <!-- SVG VECTOR OVERLAYS (Luxury Starlight & Precision Architectural Accents) -->
  <svg
    class="absolute inset-0 w-full h-full pointer-events-none"
    viewBox="0 0 1440 760"
    preserveAspectRatio="xMidYMid slice"
    xmlns="http://www.w3.org/2000/svg"
  >
    <defs>
      <!-- Drop Shadow for Precision Star Accents -->
      <filter id="star-glow" x="-50%" y="-50%" width="200%" height="200%">
        <feGaussianBlur stdDeviation="3.5" result="glow" />
        <feMerge>
          <feMergeNode in="glow" />
          <feMergeNode in="SourceGraphic" />
        </feMerge>
      </filter>
    </defs>

    <!-- Sparkling 4-Point Luxury Diamond Stars -->
    <!-- Star 1: Upper-Right Flank -->
    <path
      class="luxury-sparkle-1 hidden sm:block"
      d="M 1120 135 Q 1120 145 1110 145 Q 1120 145 1120 155 Q 1120 145 1130 145 Q 1120 145 1120 135 Z"
      fill="#7A72FF"
      filter="url(#star-glow)"
      opacity="0.5"
    />

    <!-- Star 2: Lower-Right Flank -->
    <path
      class="luxury-sparkle-2 hidden md:block"
      d="M 1320 440 Q 1320 448 1312 448 Q 1320 448 1320 456 Q 1320 448 1328 448 Q 1320 448 1320 440 Z"
      fill="#635BFF"
      opacity="0.4"
    />

    <!-- Star 3: Upper-Left Flank -->
    <path
      class="luxury-sparkle-3 hidden sm:block"
      d="M 220 160 Q 220 168 212 168 Q 220 168 220 176 Q 220 168 228 168 Q 220 168 220 160 Z"
      fill="#7A72FF"
      opacity="0.45"
    />

    <!-- Precision Architectural Framing Brackets & Ticks -->
    <g class="hidden md:block" opacity="0.35">
      <!-- Upper-Left Corner Bracket -->
      <path d="M 80 84 V 70 H 94" fill="none" stroke="#635BFF" stroke-width="1.2" />
      
      <!-- Upper-Right Corner Bracket -->
      <path d="M 1346 70 H 1360 V 84" fill="none" stroke="#635BFF" stroke-width="1.2" />

      <!-- Minimalist Flank Registration Ticks -->
      <path d="M 1380 220 H 1390 M 1380 240 H 1386 M 1380 260 H 1386 M 1380 280 H 1390" stroke="#635BFF" stroke-width="0.85" />
      <path d="M 50 480 H 60 M 54 500 H 60 M 54 520 H 60 M 50 540 H 60" stroke="#635BFF" stroke-width="0.85" />

      <!-- Technical Protocol Monospace Micro-Label -->
      <text
        x="1395"
        y="256"
        font-family="ui-monospace, monospace"
        font-size="7.5"
        fill="#635BFF"
        font-weight="600"
        letter-spacing="0.16em"
        transform="rotate(90 1395 256)"
        opacity="0.75"
      >
        CRAFTGRID // VERIFIED
      </text>
    </g>
  </svg>

  <!-- EDITORIAL MATTE MICRO-GRAIN (Eliminates digital flatness) -->
  <svg class="absolute inset-0 w-full h-full opacity-[0.015] mix-blend-multiply pointer-events-none" xmlns="http://www.w3.org/2000/svg">
    <filter id="hero-luxury-grain">
      <feTurbulence type="fractalNoise" baseFrequency="0.85" numOctaves="3" stitchTiles="stitch" />
      <feColorMatrix type="matrix" values="0 0 0 0 0.05   0 0 0 0 0.08   0 0 0 0 0.16   0 0 0 1 0" />
    </filter>
    <rect width="100%" height="100%" filter="url(#hero-luxury-grain)" />
  </svg>

</div>

<!-- CLIENT SCRIPT: Silk Wave Canvas Engine & Ambient Motion -->
<script>
  function initLuxuryHeroSilk() {
    const container = document.getElementById('craftgrid-luxury-hero-bg');
    const canvas = document.getElementById('hero-silk-canvas') as HTMLCanvasElement | null;
    const interactiveGlow = document.getElementById('hero-interactive-glow');
    if (!canvas || !container) return;

    const ctx = canvas.getContext('2d', { alpha: true });
    if (!ctx) return;

    let width = 0;
    let height = 0;
    let dpr = 1;
    let animId = 0;
    let isVisible = true;
    let time = 0;

    // Responsive Canvas Resizing
    function resize() {
      if (!canvas || !container) return;
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      width = container.offsetWidth;
      height = container.offsetHeight;
      canvas.width = Math.floor(width * dpr);
      canvas.height = Math.floor(height * dpr);
      ctx?.scale(dpr, dpr);
    }

    resize();
    window.addEventListener('resize', resize, { passive: true });

    // Interactive Cursor Glow on Desktop
    if (interactiveGlow && window.matchMedia('(min-width: 1024px)').matches) {
      const heroSection = container.parentElement;
      let targetX = 0;
      let targetY = 0;
      let currentX = 0;
      let currentY = 0;
      let isHovered = false;

      heroSection?.addEventListener('mousemove', (e) => {
        const rect = heroSection.getBoundingClientRect();
        targetX = e.clientX - rect.left;
        targetY = e.clientY - rect.top;
        if (!isHovered) {
          isHovered = true;
          interactiveGlow.style.opacity = '1';
        }
      });

      heroSection?.addEventListener('mouseleave', () => {
        isHovered = false;
        interactiveGlow.style.opacity = '0';
      });

      function updateGlow() {
        currentX += (targetX - currentX) * 0.08;
        currentY += (targetY - currentY) * 0.08;
        if (interactiveGlow && isHovered) {
          interactiveGlow.style.left = `${currentX}px`;
          interactiveGlow.style.top = `${currentY}px`;
        }
        requestAnimationFrame(updateGlow);
      }
      updateGlow();
    }

    // Check prefers-reduced-motion
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Draw One Silk Wave Ribbon with Smooth Bezier Splines
    function drawSilkRibbon(
      ctx: CanvasRenderingContext2D,
      yOffsetPercent: number,
      amp1: number,
      amp2: number,
      speed: number,
      phase: number,
      gradientStart: string,
      gradientEnd: string,
      lineWidth: number
    ) {
      const baseY = height * yOffsetPercent;
      const t = time * speed + phase;

      const p0 = { x: -40, y: baseY + Math.sin(t * 0.7) * amp1 };
      const cp1 = { x: width * 0.28, y: baseY - Math.cos(t * 0.9) * amp2 * 1.2 };
      const cp2 = { x: width * 0.65, y: baseY + Math.sin(t * 1.1) * amp1 * 1.4 };
      const p1 = { x: width + 40, y: baseY - Math.sin(t * 0.8) * amp2 };

      const grad = ctx.createLinearGradient(0, 0, width, height);
      grad.addColorStop(0, gradientStart);
      grad.addColorStop(0.5, gradientEnd);
      grad.addColorStop(1, gradientStart);

      ctx.beginPath();
      ctx.moveTo(p0.x, p0.y);
      ctx.bezierCurveTo(cp1.x, cp1.y, cp2.x, cp2.y, p1.x, p1.y);

      ctx.strokeStyle = grad;
      ctx.lineWidth = lineWidth;
      ctx.stroke();
    }

    // Main 60fps Animation Loop
    function render() {
      if (!ctx || !isVisible) return;

      ctx.clearRect(0, 0, width, height);

      // Smooth flowing time
      time += prefersReducedMotion ? 0 : 0.007;

      ctx.save();
      ctx.lineCap = 'round';
      ctx.lineJoin = 'round';

      // Ribbon 1: Deep Royal Purple Flow (Sweeps lower-left to right flank)
      drawSilkRibbon(
        ctx,
        0.65,
        45,
        55,
        0.7,
        0,
        'rgba(99, 91, 255, 0.16)',
        'rgba(168, 85, 247, 0.04)',
        2.5
      );

      // Ribbon 2: Crystalline Iris Highlight (Accompanying crest)
      drawSilkRibbon(
        ctx,
        0.62,
        38,
        48,
        0.85,
        1.4,
        'rgba(122, 114, 255, 0.14)',
        'rgba(199, 210, 254, 0.03)',
        1.8
      );

      // Ribbon 3: Upper-Right Sweeping Veil (Frames the right flank)
      drawSilkRibbon(
        ctx,
        0.32,
        40,
        50,
        0.6,
        2.8,
        'rgba(99, 91, 255, 0.13)',
        'rgba(147, 197, 253, 0.03)',
        2.0
      );

      // Ribbon 4: Delicate Secondary Caustic Accent
      drawSilkRibbon(
        ctx,
        0.28,
        32,
        42,
        0.75,
        4.2,
        'rgba(168, 85, 247, 0.11)',
        'rgba(99, 91, 255, 0.02)',
        1.4
      );

      // Ribbon 5: Low-Level Horizon Ambient Ripple
      drawSilkRibbon(
        ctx,
        0.82,
        28,
        35,
        0.5,
        5.6,
        'rgba(99, 91, 255, 0.10)',
        'rgba(196, 181, 253, 0.02)',
        1.6
      );

      ctx.restore();

      if (!prefersReducedMotion) {
        animId = requestAnimationFrame(render);
      }
    }

    render();

    // Visibility Observer to pause when offscreen
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        isVisible = entry.isIntersecting;
        if (isVisible && !prefersReducedMotion) {
          cancelAnimationFrame(animId);
          animId = requestAnimationFrame(render);
        }
      });
    }, { threshold: 0.1 });

    observer.observe(container);

    // Document Visibility
    document.addEventListener('visibilitychange', () => {
      isVisible = !document.hidden;
      if (isVisible && !prefersReducedMotion) {
        cancelAnimationFrame(animId);
        animId = requestAnimationFrame(render);
      }
    });
  }

  // Initialize on load and page transitions
  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    initLuxuryHeroSilk();
  } else {
    document.addEventListener('DOMContentLoaded', initLuxuryHeroSilk);
  }
</script>

<style>
  /* ============================================================== */
  /* LUXURY STYLING & FLOATING GLASS PHYSICS                        */
  /* ============================================================== */

  @media (prefers-reduced-motion: no-preference) {
    /* Upper-Right Floating Capsule Ambient Drift */
    .glass-capsule-ur {
      animation: float-capsule 18s ease-in-out infinite alternate;
    }

    /* Left-Flank Floating Orb Gentle Float */
    .glass-orb-ll {
      animation: float-orb 22s ease-in-out infinite alternate;
    }

    /* Prismatic Refraction Ring Rotation */
    .prismatic-ring {
      animation: rotate-prismatic 45s linear infinite;
    }

    /* Ambient Glow Breathe Cycles */
    .ambient-ur {
      animation: glow-pulse-ur 20s ease-in-out infinite alternate;
    }

    .ambient-ul {
      animation: glow-pulse-ul 24s ease-in-out infinite alternate;
    }

    .ambient-lm {
      animation: glow-pulse-lm 22s ease-in-out infinite alternate;
    }

    /* Luxury Star Twinkle Animations */
    .luxury-sparkle-1 {
      animation: star-twinkle 6s ease-in-out infinite alternate;
    }

    .luxury-sparkle-2 {
      animation: star-twinkle 7.5s ease-in-out 1.5s infinite alternate;
    }

    .luxury-sparkle-3 {
      animation: star-twinkle 8s ease-in-out 3s infinite alternate;
    }

    .animate-spin-slow {
      animation: spin-ring 32s linear infinite;
    }
  }

  @keyframes float-capsule {
    0% {
      transform: rotate(-4deg) translate3d(0, 0, 0);
    }
    100% {
      transform: rotate(-2.5deg) translate3d(-10px, 12px, 0);
    }
  }

  @keyframes float-orb {
    0% {
      transform: translate3d(0, 0, 0);
    }
    100% {
      transform: translate3d(8px, -14px, 0);
    }
  }

  @keyframes rotate-prismatic {
    0% {
      transform: rotate(0deg);
    }
    100% {
      transform: rotate(360deg);
    }
  }

  @keyframes spin-ring {
    0% {
      transform: rotate(0deg);
    }
    100% {
      transform: rotate(360deg);
    }
  }

  @keyframes glow-pulse-ur {
    0% {
      opacity: 0.8;
      transform: scale(0.96) translate(0, 0);
    }
    100% {
      opacity: 1;
      transform: scale(1.04) translate(-12px, 10px);
    }
  }

  @keyframes glow-pulse-ul {
    0% {
      opacity: 0.75;
      transform: scale(0.97);
    }
    100% {
      opacity: 0.95;
      transform: scale(1.03);
    }
  }

  @keyframes glow-pulse-lm {
    0% {
      opacity: 0.7;
      transform: scale(0.98);
    }
    100% {
      opacity: 0.95;
      transform: scale(1.03);
    }
  }

  @keyframes star-twinkle {
    0% {
      opacity: 0.25;
      transform: scale(0.85);
    }
    50% {
      opacity: 0.65;
      transform: scale(1.15);
    }
    100% {
      opacity: 0.35;
      transform: scale(0.95);
    }
  }

  /* ============================================================== */
  /* MOBILE & TABLET OPTIMIZATIONS                                  */
  /* ============================================================== */

  @media (max-width: 768px) {
    .glass-capsule-ur,
    .glass-orb-ll,
    .prismatic-ring {
      display: none !important;
    }
  }
</style>
