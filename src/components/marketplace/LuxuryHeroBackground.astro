---
/**
 * LuxuryHeroBackground.astro
 * 
 * "LUMINOUS SILK & GLASS ARCHITECTURE" - Filled Luxury Edition
 * 
 * Enhanced based on user feedback:
 * "The design is good, but the background is still empty. I want it more filled, but don't overdo."
 * 
 * Improvements:
 * 1. Volumetric Luminous Silk Ribbons:
 *    - HTML5 Canvas renders translucent Bezier silk ribbon bands with subtle gradient fills and luminous crest highlights.
 *    - Fills the visual volume with living, breathing atmospheric light caustics.
 * 2. Architectural Hairline Micro-Grid (Vignette-Masked):
 *    - 38px architectural grid texture along flanks and corners, giving the canvas an intentional, expensive structure.
 *    - Center text zone remains 100% pristine and bright.
 * 3. Balanced Glassmorphic Architectural Cards:
 *    - Upper-Right: Elite Builders Verification Card with progress meters.
 *    - Upper-Left: 4.96/5 Verified Rating Badge.
 *    - Lower-Right: Milestone Escrow Protocol Security Badge.
 *    - Left-Middle: Floating Crystalline Orb with rotating lens aura.
 *    - Right-Middle: Prismatic optical refraction ring.
 * 4. Constellation Geometry & Diamond Stars:
 *    - Ethereal dashed constellation lines connecting 4 twinkling diamond stars.
 *    - Minimalist corner framing brackets and flank measurement scales.
 * 5. Strictly Preserved Center Safe Zone:
 *    - Eyebrow text, headline, search bar, and CTAs remain in radiant, crystal-clear white space.
 */
---

<div id="craftgrid-luxury-hero-bg" class="luxury-hero-bg absolute inset-0 pointer-events-none overflow-hidden select-none z-0" aria-hidden="true">
  
  <!-- BASE LAYER: Clean Luxury White Canvas -->
  <div class="absolute inset-0 bg-[#FFFFFF]"></div>
  <div class="absolute inset-0 bg-gradient-to-b from-[#FFFFFF] via-[#FCFCFF] to-[#F7F7FD]"></div>

  <!-- MULTI-LAYER AMBIENT VOLUMETRIC GLOWS -->
  <!-- Upper-Right Radiant Iris Bloom -->
  <div class="ambient-glow ambient-ur absolute top-[-120px] right-[-100px] w-[820px] h-[820px] rounded-full bg-[radial-gradient(circle_at_center,rgba(99,91,255,0.07)_0%,rgba(168,85,247,0.035)_35%,rgba(199,210,254,0.02)_60%,transparent_75%)] blur-[105px]"></div>
  
  <!-- Upper-Left Crystalline Periwinkle Wash -->
  <div class="ambient-glow ambient-ul absolute top-[-80px] left-[-80px] w-[680px] h-[680px] rounded-full bg-[radial-gradient(circle_at_center,rgba(122,114,255,0.05)_0%,rgba(224,231,255,0.025)_45%,transparent_70%)] blur-[95px]"></div>

  <!-- Left-Middle Subtle Violet Reflection -->
  <div class="ambient-glow ambient-lm absolute top-[270px] left-[-120px] w-[620px] h-[620px] rounded-full bg-[radial-gradient(circle_at_center,rgba(99,91,255,0.045)_0%,rgba(196,181,253,0.025)_45%,transparent_70%)] blur-[95px]"></div>

  <!-- Lower Stats Zone Soft Illumination -->
  <div class="ambient-glow ambient-bottom absolute bottom-[-130px] left-1/2 -translate-x-1/2 w-[1000px] h-[380px] rounded-full bg-[radial-gradient(ellipse_at_center,rgba(99,91,255,0.04)_0%,rgba(165,180,252,0.02)_50%,transparent_75%)] blur-[100px]"></div>

  <!-- Interactive Subtle Ambient Mouse Glow (Desktop Only) -->
  <div id="hero-interactive-glow" class="hidden lg:block absolute w-[450px] h-[450px] rounded-full bg-[radial-gradient(circle_at_center,rgba(99,91,255,0.045)_0%,transparent_70%)] blur-[65px] transition-opacity duration-700 opacity-0 pointer-events-none -translate-x-1/2 -translate-y-1/2"></div>

  <!-- FLUID VOLUMETRIC SILK CANVAS (GPU-accelerated Bezier Caustics with Gradient Bands) -->
  <canvas id="hero-silk-canvas" class="absolute inset-0 w-full h-full pointer-events-none"></canvas>

  <!-- SVG ARCHITECTURAL GRID & CONSTELLATION OVERLAYS -->
  <svg
    class="absolute inset-0 w-full h-full pointer-events-none"
    viewBox="0 0 1440 760"
    preserveAspectRatio="xMidYMid slice"
    xmlns="http://www.w3.org/2000/svg"
  >
    <defs>
      <!-- Architectural Hairline Micro-Grid Pattern -->
      <pattern id="luxury-arch-grid" width="38" height="38" patternUnits="userSpaceOnUse">
        <path d="M 38 0 L 0 0 0 38" fill="none" stroke="#635BFF" stroke-width="0.55" opacity="0.08" />
        <circle cx="0" cy="0" r="0.8" fill="#635BFF" opacity="0.18" />
      </pattern>

      <!-- Center Vignette Mask: Keeps Center Text Zone Pristine -->
      <mask id="hero-center-mask">
        <rect width="1440" height="760" fill="white" />
        <ellipse cx="720" cy="350" rx="430" ry="210" fill="black" opacity="0.95" />
      </mask>

      <!-- Drop Shadow for Precision Star Accents -->
      <filter id="star-glow" x="-50%" y="-50%" width="200%" height="200%">
        <feGaussianBlur stdDeviation="3.5" result="glow" />
        <feMerge>
          <feMergeNode in="glow" />
          <feMergeNode in="SourceGraphic" />
        </feMerge>
      </filter>

      <!-- Architectural Sweeping Arc Gradients -->
      <linearGradient id="arch-arc-ur" x1="100%" y1="0%" x2="0%" y2="100%">
        <stop offset="0%" stop-color="#635BFF" stop-opacity="0.18" />
        <stop offset="60%" stop-color="#7A72FF" stop-opacity="0.08" />
        <stop offset="100%" stop-color="#7A72FF" stop-opacity="0.01" />
      </linearGradient>

      <linearGradient id="arch-arc-ll" x1="0%" y1="100%" x2="100%" y2="0%">
        <stop offset="0%" stop-color="#635BFF" stop-opacity="0.16" />
        <stop offset="60%" stop-color="#7A72FF" stop-opacity="0.06" />
        <stop offset="100%" stop-color="#7A72FF" stop-opacity="0.01" />
      </linearGradient>
    </defs>

    <!-- LAYER 1: Architectural Hairline Micro-Grid (Masked to Flanks & Edges) -->
    <rect
      width="1440"
      height="760"
      fill="url(#luxury-arch-grid)"
      mask="url(#hero-center-mask)"
      class="hidden sm:block"
    />

    <!-- LAYER 2: Ethereal Sweeping Architectural Framing Arcs -->
    <!-- Upper-Right Framing Arc (Radius 360) -->
    <circle
      cx="1350"
      cy="180"
      r="360"
      fill="none"
      stroke="url(#arch-arc-ur)"
      stroke-width="1.0"
      stroke-dasharray="280 80 140 60"
      opacity="0.22"
      class="hidden md:block"
    />
    <circle
      cx="1350"
      cy="180"
      r="440"
      fill="none"
      stroke="url(#arch-arc-ur)"
      stroke-width="0.75"
      stroke-dasharray="5 10"
      opacity="0.14"
      class="hidden md:block"
    />

    <!-- Lower-Left Framing Arc (Radius 380) -->
    <circle
      cx="-60"
      cy="680"
      r="380"
      fill="none"
      stroke="url(#arch-arc-ll)"
      stroke-width="1.0"
      stroke-dasharray="240 70 120 50"
      opacity="0.20"
      class="hidden md:block"
    />
    <circle
      cx="-60"
      cy="680"
      r="460"
      fill="none"
      stroke="url(#arch-arc-ll)"
      stroke-width="0.75"
      stroke-dasharray="4 8"
      opacity="0.12"
      class="hidden md:block"
    />

    <!-- LAYER 3: Constellation Geometry Lines Connecting Stars -->
    <g class="constellation-lines hidden lg:block" opacity="0.25">
      <line x1="1120" y1="145" x2="1320" y2="448" stroke="#635BFF" stroke-width="0.75" stroke-dasharray="4 8" />
      <line x1="1120" y1="145" x2="1280" y2="90" stroke="#7A72FF" stroke-width="0.75" stroke-dasharray="3 6" />
      <line x1="220" y1="168" x2="140" y2="340" stroke="#635BFF" stroke-width="0.75" stroke-dasharray="4 8" />
      <line x1="220" y1="168" x2="340" y2="120" stroke="#7A72FF" stroke-width="0.75" stroke-dasharray="3 6" />
    </g>

    <!-- LAYER 4: Sparkling 4-Point Luxury Diamond Stars -->
    <!-- Star 1: Upper-Right Flank -->
    <path
      class="luxury-sparkle-1 hidden sm:block"
      d="M 1120 135 Q 1120 145 1110 145 Q 1120 145 1120 155 Q 1120 145 1130 145 Q 1120 145 1120 135 Z"
      fill="#7A72FF"
      filter="url(#star-glow)"
      opacity="0.55"
    />

    <!-- Star 2: Lower-Right Flank -->
    <path
      class="luxury-sparkle-2 hidden md:block"
      d="M 1320 440 Q 1320 448 1312 448 Q 1320 448 1320 456 Q 1320 448 1328 448 Q 1320 448 1320 440 Z"
      fill="#635BFF"
      opacity="0.45"
    />

    <!-- Star 3: Upper-Left Flank -->
    <path
      class="luxury-sparkle-3 hidden sm:block"
      d="M 220 160 Q 220 168 212 168 Q 220 168 220 176 Q 220 168 228 168 Q 220 168 220 160 Z"
      fill="#7A72FF"
      opacity="0.50"
    />

    <!-- Star 4: Far-Right Apex -->
    <path
      class="luxury-sparkle-4 hidden lg:block"
      d="M 1280 82 Q 1280 90 1272 90 Q 1280 90 1280 98 Q 1280 90 1288 90 Q 1280 90 1280 82 Z"
      fill="#635BFF"
      opacity="0.40"
    />

    <!-- LAYER 5: Precision Architectural Framing Brackets & Ticks -->
    <g class="hidden md:block" opacity="0.4">
      <!-- Upper-Left Corner Bracket -->
      <path d="M 80 84 V 70 H 94" fill="none" stroke="#635BFF" stroke-width="1.2" />
      
      <!-- Upper-Right Corner Bracket -->
      <path d="M 1346 70 H 1360 V 84" fill="none" stroke="#635BFF" stroke-width="1.2" />

      <!-- Minimalist Flank Registration Ticks -->
      <path d="M 1380 220 H 1390 M 1380 240 H 1386 M 1380 260 H 1386 M 1380 280 H 1390" stroke="#635BFF" stroke-width="0.85" />
      <path d="M 50 480 H 60 M 54 500 H 60 M 54 520 H 60 M 50 540 H 60" stroke="#635BFF" stroke-width="0.85" />

      <!-- Technical Protocol Monospace Micro-Label -->
      <text
        x="1395"
        y="256"
        font-family="ui-monospace, monospace"
        font-size="7.5"
        fill="#635BFF"
        font-weight="600"
        letter-spacing="0.16em"
        transform="rotate(90 1395 256)"
        opacity="0.75"
      >
        CRAFTGRID // VERIFIED
      </text>
    </g>
  </svg>

  <!-- FROSTED GLASS ARCHITECTURAL FLOATING LENSES (Glassmorphism) -->
  <!-- 1. Upper-Right Floating Architectural Capsule -->
  <div class="glass-capsule-ur hidden lg:flex absolute top-[16%] right-[5%] xl:right-[8%] flex-col gap-2 p-3.5 rounded-2xl bg-white/50 backdrop-blur-xl border border-white/85 shadow-[0_20px_50px_rgba(99,91,255,0.08),inset_0_1px_1px_rgba(255,255,255,0.95)] w-[215px] transform rotate-[-3deg] transition-transform">
    <div class="flex items-center justify-between">
      <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-[9.5px] font-bold tracking-wider uppercase text-[#635BFF] bg-[#635BFF]/10 border border-[#635BFF]/15">
        <span class="w-1.5 h-1.5 rounded-full bg-[#635BFF] animate-pulse"></span>
        Elite Builders
      </span>
      <span class="text-[9px] font-mono text-slate-400">VERIFIED</span>
    </div>
    <div class="space-y-1.5 pt-1">
      <div class="h-2 w-3/4 rounded-full bg-gradient-to-r from-[#635BFF]/25 to-[#A5B4FC]/25"></div>
      <div class="h-1.5 w-1/2 rounded-full bg-slate-200/70"></div>
    </div>
  </div>

  <!-- 2. Upper-Left Floating Glass Rating Badge -->
  <div class="glass-capsule-ul hidden lg:flex absolute top-[18%] left-[5%] xl:left-[7%] items-center gap-2 px-3 py-1.5 rounded-xl bg-white/50 backdrop-blur-xl border border-white/85 shadow-[0_16px_36px_rgba(99,91,255,0.07),inset_0_1px_1px_rgba(255,255,255,0.95)] transform rotate-[2.5deg]">
    <div class="flex items-center text-amber-500">
      <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 20 20">
        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
      </svg>
    </div>
    <span class="text-[10.5px] font-bold text-slate-800">4.96 Rating</span>
    <span class="text-[9.5px] text-slate-400 font-mono">· 1,400+ Reviews</span>
  </div>

  <!-- 3. Lower-Right Floating Escrow Security Badge -->
  <div class="glass-capsule-lr hidden xl:flex absolute bottom-[22%] right-[5%] items-center gap-2.5 px-3.5 py-2 rounded-xl bg-white/50 backdrop-blur-xl border border-white/85 shadow-[0_16px_36px_rgba(99,91,255,0.07),inset_0_1px_1px_rgba(255,255,255,0.95)]">
    <span class="w-2 h-2 rounded-full bg-emerald-500 shadow-[0_0_8px_rgba(16,185,129,0.5)]"></span>
    <span class="text-[10px] font-bold text-slate-700 tracking-wide">Escrow Protected</span>
    <span class="text-[9px] font-mono text-emerald-600 bg-emerald-50 px-1.5 py-0.5 rounded border border-emerald-200/60">100% SECURE</span>
  </div>

  <!-- 4. Left-Flank Floating Crystalline Orb -->
  <div class="glass-orb-ll hidden lg:block absolute top-[44%] left-[4%] xl:left-[6%] w-[94px] h-[94px] rounded-full bg-gradient-to-tr from-white/25 via-white/55 to-white/15 backdrop-blur-lg border border-white/85 shadow-[0_18px_40px_rgba(99,91,255,0.07),inset_0_1px_2px_rgba(255,255,255,0.95)]">
    <div class="w-full h-full rounded-full flex items-center justify-center">
      <div class="w-11 h-11 rounded-full border border-[#635BFF]/30 border-dashed animate-spin-slow"></div>
    </div>
  </div>

  <!-- 5. Right-Flank Prismatic Refraction Ring -->
  <div class="prismatic-ring hidden xl:block absolute top-[50%] right-[4%] w-[190px] h-[190px] rounded-full p-[1.5px] bg-gradient-to-tr from-[#635BFF]/40 via-[#C4B5FD]/20 to-transparent pointer-events-none">
    <div class="w-full h-full rounded-full bg-gradient-to-br from-white/20 to-white/5 backdrop-blur-[2px]"></div>
  </div>

  <!-- CENTER RADIAL BRIGHTENER: Guarantees 100% Legibility & Clean Contrast -->
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_50%_40%,rgba(255,255,255,0.96)_0%,rgba(255,255,255,0.75)_42%,rgba(255,255,255,0.15)_70%,transparent_100%)]"></div>

  <!-- EDITORIAL MATTE MICRO-GRAIN (Eliminates digital flatness) -->
  <svg class="absolute inset-0 w-full h-full opacity-[0.015] mix-blend-multiply pointer-events-none" xmlns="http://www.w3.org/2000/svg">
    <filter id="hero-luxury-grain">
      <feTurbulence type="fractalNoise" baseFrequency="0.85" numOctaves="3" stitchTiles="stitch" />
      <feColorMatrix type="matrix" values="0 0 0 0 0.05   0 0 0 0 0.08   0 0 0 0 0.16   0 0 0 1 0" />
    </filter>
    <rect width="100%" height="100%" filter="url(#hero-luxury-grain)" />
  </svg>

</div>

<!-- CLIENT SCRIPT: Volumetric Silk Ribbon Wave Engine & Floating Physics -->
<script>
  function initLuxuryHeroSilk() {
    const container = document.getElementById('craftgrid-luxury-hero-bg');
    const canvas = document.getElementById('hero-silk-canvas') as HTMLCanvasElement | null;
    const interactiveGlow = document.getElementById('hero-interactive-glow');
    if (!canvas || !container) return;

    const ctx = canvas.getContext('2d', { alpha: true });
    if (!ctx) return;

    let width = 0;
    let height = 0;
    let dpr = 1;
    let animId = 0;
    let isVisible = true;
    let time = 0;

    // Responsive Canvas Resizing
    function resize() {
      if (!canvas || !container) return;
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      width = container.offsetWidth;
      height = container.offsetHeight;
      canvas.width = Math.floor(width * dpr);
      canvas.height = Math.floor(height * dpr);
      ctx?.scale(dpr, dpr);
    }

    resize();
    window.addEventListener('resize', resize, { passive: true });

    // Interactive Cursor Glow on Desktop
    if (interactiveGlow && window.matchMedia('(min-width: 1024px)').matches) {
      const heroSection = container.parentElement;
      let targetX = 0;
      let targetY = 0;
      let currentX = 0;
      let currentY = 0;
      let isHovered = false;

      heroSection?.addEventListener('mousemove', (e) => {
        const rect = heroSection.getBoundingClientRect();
        targetX = e.clientX - rect.left;
        targetY = e.clientY - rect.top;
        if (!isHovered) {
          isHovered = true;
          interactiveGlow.style.opacity = '1';
        }
      });

      heroSection?.addEventListener('mouseleave', () => {
        isHovered = false;
        interactiveGlow.style.opacity = '0';
      });

      function updateGlow() {
        currentX += (targetX - currentX) * 0.08;
        currentY += (targetY - currentY) * 0.08;
        if (interactiveGlow && isHovered) {
          interactiveGlow.style.left = `${currentX}px`;
          interactiveGlow.style.top = `${currentY}px`;
        }
        requestAnimationFrame(updateGlow);
      }
      updateGlow();
    }

    // Check prefers-reduced-motion
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    /**
     * Draw a Volumetric Silk Ribbon with Translucent Gradient Band Fill
     * Fills space with luminous, breathing silky depth!
     */
    function drawVolumetricSilkBand(
      ctx: CanvasRenderingContext2D,
      yOffsetPercent: number,
      bandHeightPercent: number,
      amp1: number,
      amp2: number,
      speed: number,
      phase: number,
      colorTop: string,
      colorMid: string,
      edgeStrokeColor: string,
      edgeStrokeWidth: number
    ) {
      const baseY = height * yOffsetPercent;
      const t = time * speed + phase;
      const bandH = height * bandHeightPercent;

      // Top Bezier Spline
      const t0 = { x: -40, y: baseY + Math.sin(t * 0.7) * amp1 };
      const tCp1 = { x: width * 0.28, y: baseY - Math.cos(t * 0.9) * amp2 * 1.15 };
      const tCp2 = { x: width * 0.65, y: baseY + Math.sin(t * 1.05) * amp1 * 1.25 };
      const t1 = { x: width + 40, y: baseY - Math.sin(t * 0.8) * amp2 };

      // Bottom Bezier Spline (Smoothly offsets)
      const b0 = { x: width + 40, y: t1.y + bandH + Math.sin(t * 0.65 + 1.2) * (amp1 * 0.45) };
      const bCp2 = { x: width * 0.65, y: tCp2.y + bandH + Math.cos(t * 0.85 + 0.6) * (amp2 * 0.45) };
      const bCp1 = { x: width * 0.28, y: tCp1.y + bandH + Math.sin(t * 0.55 + 1.4) * (amp1 * 0.45) };
      const b1 = { x: -40, y: t0.y + bandH + Math.cos(t * 0.75) * (amp2 * 0.45) };

      // Translucent Band Fill
      const fillGrad = ctx.createLinearGradient(0, t0.y, width, t1.y + bandH);
      fillGrad.addColorStop(0, colorTop);
      fillGrad.addColorStop(0.5, colorMid);
      fillGrad.addColorStop(1, colorTop);

      ctx.beginPath();
      ctx.moveTo(t0.x, t0.y);
      ctx.bezierCurveTo(tCp1.x, tCp1.y, tCp2.x, tCp2.y, t1.x, t1.y);
      ctx.lineTo(b0.x, b0.y);
      ctx.bezierCurveTo(bCp2.x, bCp2.y, bCp1.x, bCp1.y, b1.x, b1.y);
      ctx.closePath();

      ctx.fillStyle = fillGrad;
      ctx.fill();

      // Top Luminous Edge Crest Line
      ctx.beginPath();
      ctx.moveTo(t0.x, t0.y);
      ctx.bezierCurveTo(tCp1.x, tCp1.y, tCp2.x, tCp2.y, t1.x, t1.y);
      ctx.strokeStyle = edgeStrokeColor;
      ctx.lineWidth = edgeStrokeWidth;
      ctx.stroke();
    }

    // Main 60fps Animation Loop
    function render() {
      if (!ctx || !isVisible) return;

      ctx.clearRect(0, 0, width, height);

      // Smooth flowing time
      time += prefersReducedMotion ? 0 : 0.0065;

      ctx.save();
      ctx.lineCap = 'round';
      ctx.lineJoin = 'round';

      // Ribbon Band 1: Volumetric Royal Purple Flow (Sweeps lower-left through right flank)
      drawVolumetricSilkBand(
        ctx,
        0.60,
        0.18,
        42,
        52,
        0.65,
        0,
        'rgba(99, 91, 255, 0.045)',
        'rgba(168, 85, 247, 0.02)',
        'rgba(99, 91, 255, 0.18)',
        1.8
      );

      // Ribbon Band 2: Crystalline Iris Layer (Accompanying crest filling middle depth)
      drawVolumetricSilkBand(
        ctx,
        0.54,
        0.14,
        36,
        46,
        0.80,
        1.5,
        'rgba(122, 114, 255, 0.038)',
        'rgba(199, 210, 254, 0.015)',
        'rgba(122, 114, 255, 0.15)',
        1.5
      );

      // Ribbon Band 3: Upper-Right Sweeping Veil (Fills upper-right canvas)
      drawVolumetricSilkBand(
        ctx,
        0.26,
        0.16,
        38,
        48,
        0.55,
        3.0,
        'rgba(99, 91, 255, 0.035)',
        'rgba(147, 197, 253, 0.015)',
        'rgba(99, 91, 255, 0.14)',
        1.6
      );

      // Ribbon Band 4: Upper-Left Balancing Wave
      drawVolumetricSilkBand(
        ctx,
        0.22,
        0.12,
        30,
        38,
        0.70,
        4.5,
        'rgba(168, 85, 247, 0.03)',
        'rgba(99, 91, 255, 0.012)',
        'rgba(168, 85, 247, 0.12)',
        1.3
      );

      // Ribbon Band 5: Low-Level Horizon Ripple (Anchors stats area)
      drawVolumetricSilkBand(
        ctx,
        0.78,
        0.12,
        25,
        32,
        0.50,
        5.8,
        'rgba(99, 91, 255, 0.025)',
        'rgba(196, 181, 253, 0.01)',
        'rgba(99, 91, 255, 0.11)',
        1.3
      );

      ctx.restore();

      if (!prefersReducedMotion) {
        animId = requestAnimationFrame(render);
      }
    }

    render();

    // Visibility Observer to pause when offscreen
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        isVisible = entry.isIntersecting;
        if (isVisible && !prefersReducedMotion) {
          cancelAnimationFrame(animId);
          animId = requestAnimationFrame(render);
        }
      });
    }, { threshold: 0.1 });

    observer.observe(container);

    // Document Visibility
    document.addEventListener('visibilitychange', () => {
      isVisible = !document.hidden;
      if (isVisible && !prefersReducedMotion) {
        cancelAnimationFrame(animId);
        animId = requestAnimationFrame(render);
      }
    });
  }

  // Initialize on load and page transitions
  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    initLuxuryHeroSilk();
  } else {
    document.addEventListener('DOMContentLoaded', initLuxuryHeroSilk);
  }
</script>

<style>
