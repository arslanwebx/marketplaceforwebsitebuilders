---
import type { Review } from '@/types/marketplace';
import RatingStars from '@/components/ui/RatingStars.astro';
import { formatCurrency } from '@/lib/formatters';

interface Props {
  review: Review;
}

const { review } = Astro.props;
---

<div class="bg-white rounded-xl border border-border p-5 shadow-subtle hover:shadow-card transition">
  <!-- Top: Avatar, Author, Rating & Date -->
  <div class="flex items-start justify-between gap-3">
    <div class="flex items-center gap-3">
      <img
        src={review.author.avatar}
        alt={review.author.name}
        class="w-10 h-10 rounded-full object-cover border border-border"
      />
      <div>
        <h4 class="text-sm font-bold text-dark">{review.author.name}</h4>
        <p class="text-xs text-secondary">{review.author.company} · {review.author.location}</p>
      </div>
    </div>

    <div class="text-right">
      <RatingStars rating={review.rating} size="sm" showCount={false} />
      <span class="text-[11px] text-slate-400 block mt-0.5">{review.date}</span>
    </div>
  </div>

  <!-- Review Text -->
  <p class="mt-3.5 text-xs sm:text-sm text-slate-700 leading-relaxed">
    "{review.comment}"
  </p>

  <!-- Project context if present -->
  {(review.serviceTitle || review.projectBudget) && (
    <div class="mt-3 pt-3 border-t border-slate-100 flex items-center justify-between text-[11px] text-slate-400">
      <span>{review.serviceTitle ? `Project: ${review.serviceTitle}` : 'Custom Website Project'}</span>
      {review.projectBudget && (
        <span class="font-medium text-slate-600">Contract: {formatCurrency(review.projectBudget)}</span>
      )}
    </div>
  )}
</div>
