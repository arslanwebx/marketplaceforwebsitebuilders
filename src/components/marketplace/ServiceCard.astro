---
import type { Service } from '@/types/marketplace';
import RatingStars from '@/components/ui/RatingStars.astro';
import { formatCurrency } from '@/lib/formatters';

interface Props {
  service: Service;
  showSaveButton?: boolean;
}

const { service, showSaveButton = true } = Astro.props;
---

<div class="group bg-white rounded-xl border border-border overflow-hidden shadow-card hover:shadow-card-hover transition-all duration-200 flex flex-col h-full">
  <!-- Image Thumbnail with Favorite Heart and Delivery Badge -->
  <div class="relative aspect-video w-full overflow-hidden bg-slate-100">
    <a href={`/services/${service.slug}`} class="block w-full h-full">
      <img
        src={service.thumbnail}
        alt={service.title}
        loading="lazy"
        onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1460925895917-afdab827c52f?w=800&auto=format&fit=crop&q=80';"
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
      />
    </a>

    <!-- Platform Badge -->
    <span class="absolute top-3 left-3 px-2.5 py-1 rounded-md text-xs font-semibold bg-white/95 backdrop-blur-sm text-dark shadow-xs">
      {service.platform}
    </span>

    <!-- Favorite Save Button -->
    {showSaveButton && (
      <button
        type="button"
        onclick={`
          const saved = JSON.parse(localStorage.getItem('craftgrid_saved_services') || '[]');
          const id = '${service.id}';
          const index = saved.indexOf(id);
          if (index > -1) {
            saved.splice(index, 1);
            this.classList.remove('text-rose-500', 'fill-rose-500');
            this.classList.add('text-slate-600');
            window.dispatchEvent(new CustomEvent('craftgrid_toast', { detail: { message: 'Removed from saved services', type: 'info' } }));
          } else {
            saved.push(id);
            this.classList.add('text-rose-500', 'fill-rose-500');
            this.classList.remove('text-slate-600');
            window.dispatchEvent(new CustomEvent('craftgrid_toast', { detail: { message: 'Saved service to favorites', type: 'success' } }));
          }
          localStorage.setItem('craftgrid_saved_services', JSON.stringify(saved));
        `}
        class="absolute top-3 right-3 p-2 rounded-full bg-white/90 backdrop-blur-sm hover:bg-white text-slate-600 transition shadow-xs"
        aria-label="Save service"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
        </svg>
      </button>
    )}
  </div>

  <!-- Content Body -->
  <div class="p-4 sm:p-5 flex flex-col flex-1">
    
    <!-- Builder Mini-Profile Header -->
    <div class="flex items-center gap-2.5 mb-3">
      <a href={`/talent/${service.builder.username}`} class="shrink-0">
        <img
          src={service.builder.avatar}
          alt={service.builder.name}
          onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=150&auto=format&fit=crop&q=80';"
          class="w-7 h-7 rounded-full object-cover border border-border"
        />
      </a>
      <div class="flex items-center gap-1.5 min-w-0">
        <a href={`/talent/${service.builder.username}`} class="text-xs font-semibold text-slate-800 hover:text-primary truncate">
          {service.builder.name}
        </a>
        {service.builder.verified && (
          <span title="Verified Pro" class="text-primary shrink-0">
            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
          </span>
        )}
      </div>
    </div>

    <!-- Service Title -->
    <a href={`/services/${service.slug}`} class="block group-hover:text-primary transition">
      <h3 class="text-sm sm:text-[15px] font-bold text-dark line-clamp-2 leading-snug">
        {service.title}
      </h3>
    </a>

    <!-- Rating & Reviews -->
    <div class="mt-2.5">
      <RatingStars rating={service.rating} reviewsCount={service.reviewsCount} size="sm" />
    </div>

    <!-- Tech Tags -->
    <div class="mt-3 flex flex-wrap gap-1.5">
      {service.tags.slice(0, 3).map(tag => (
        <span class="text-[11px] px-2 py-0.5 rounded bg-slate-100 text-slate-600">
          {tag}
        </span>
      ))}
    </div>

    <!-- Footer: Starting Price & Turnaround -->
    <div class="mt-auto pt-4 border-t border-border flex items-center justify-between">
      <span class="text-xs text-secondary">
        Est. {service.startingDeliveryDays} days
      </span>
      <div class="text-right">
        <span class="text-[11px] text-slate-400 block uppercase font-medium">Starting at</span>
        <span class="text-base font-bold text-dark">{formatCurrency(service.startingPrice)}</span>
      </div>
    </div>

  </div>
</div>
