---
import type { Project } from '@/types/marketplace';
import { formatCurrency } from '@/lib/formatters';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<div class="bg-white rounded-xl border border-border p-5 sm:p-6 shadow-card hover:shadow-card-hover transition-all duration-200 flex flex-col justify-between">
  <div>
    <!-- Meta Top Row: Posted Time & Status -->
    <div class="flex items-center justify-between text-xs text-secondary mb-2">
      <div class="flex items-center gap-2">
        <span class="font-medium text-slate-800">{project.client.company}</span>
        {project.client.verified && (
          <span class="text-emerald-600 flex items-center gap-0.5" title="Payment Verified Client">
            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
            <span class="text-[11px]">Verified</span>
          </span>
        )}
      </div>
      <span>Posted {project.postedAt}</span>
    </div>

    <!-- Title -->
    <a href={`/projects/${project.slug}`} class="block group">
      <h3 class="text-base sm:text-lg font-bold text-dark group-hover:text-primary transition leading-snug">
        {project.title}
      </h3>
    </a>

    <!-- Summary -->
    <p class="mt-2.5 text-xs sm:text-sm text-secondary line-clamp-2 leading-relaxed">
      {project.summary}
    </p>

    <!-- Project Metrics Grid: Budget, Timeline, Proposals -->
    <div class="mt-4 pt-3 border-t border-slate-100 grid grid-cols-3 gap-2 text-xs">
      <div>
        <span class="text-slate-400 block text-[11px]">Budget</span>
        <span class="font-bold text-dark">
          {formatCurrency(project.budget.min)} – {formatCurrency(project.budget.max)}
        </span>
      </div>
      <div>
        <span class="text-slate-400 block text-[11px]">Timeline</span>
        <span class="font-semibold text-slate-700">{project.timeline}</span>
      </div>
      <div>
        <span class="text-slate-400 block text-[11px]">Proposals</span>
        <span class="font-semibold text-primary">{project.proposalsCount} received</span>
      </div>
    </div>

    <!-- Required Skills Chips -->
    <div class="mt-4 flex flex-wrap gap-1.5">
      {project.requiredSkills.map(skill => (
        <span class="text-[11px] px-2 py-0.5 rounded bg-slate-100 text-slate-600 font-medium">
          {skill}
        </span>
      ))}
    </div>
  </div>

  <!-- Bottom CTA Action -->
  <div class="mt-5 pt-4 border-t border-border flex items-center justify-between">
    <span class="text-xs text-secondary">
      Location: <strong class="text-slate-700 font-medium">{project.client.location}</strong>
    </span>
    <a
      href={`/projects/${project.slug}`}
      class="inline-flex items-center gap-1 text-xs font-bold text-primary hover:text-primary-hover"
    >
      <span>Submit Proposal</span>
      <span>→</span>
    </a>
  </div>
</div>
