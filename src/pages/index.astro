---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CategoryCard from '@/components/marketplace/CategoryCard.astro';
import ServiceCard from '@/components/marketplace/ServiceCard.astro';
import BuilderCard from '@/components/marketplace/BuilderCard.astro';
import ProjectCard from '@/components/marketplace/ProjectCard.astro';
import { categories } from '@/data/categories';
import { services } from '@/data/services';
import { builders } from '@/data/builders';
import { projects } from '@/data/projects';

const popularCategories = categories.slice(0, 8);
const featuredServices = services.slice(0, 6);
const featuredBuilders = builders.slice(0, 6);
const latestProjects = projects.slice(0, 4);

const faqs = [
  {
    q: 'How does CraftGrid protect client payments?',
    a: 'All project payments are deposited into our milestone-based escrow. The website builder begins work on agreed deliverables, but funds are only released to the builder after you review and approve each completed phase.'
  },
  {
    q: 'Can I hire for both fixed-price packaged services and custom projects?',
    a: 'Yes. You can instantly purchase packaged services with transparent deliverables and delivery times, or submit a custom project brief to receive competitive proposals from vetted specialists.'
  },
  {
    q: 'How are website builders and agencies vetted on CraftGrid?',
    a: 'We verify builder identities, evaluate past live client portfolios, test platform certifications (Webflow, Shopify Partner, WordPress core standards), and actively monitor client satisfaction metrics.'
  },
  {
    q: 'What platforms do CraftGrid experts specialize in?',
    a: 'Our network includes verified specialists across Webflow, Shopify & Shopify Plus, WordPress & WooCommerce, Framer, Astro, Next.js, Squarespace, and custom full-stack solutions.'
  },
  {
    q: 'What happens if a project requires revisions?',
    a: 'Every packaged service and proposal includes defined revision rounds. Through your Order Workspace, you can request adjustments directly with timestamped notes before approving milestones.'
  },
  {
    q: 'Are there any hidden platform fees for clients?',
    a: 'No. Pricing is completely transparent. The total price displayed at checkout includes our standard 5% escrow administration fee, ensuring full payment protection and dedicated support.'
  }
];
---

<BaseLayout
  title="CraftGrid – Find the right web expert. Build with confidence."
  description="CraftGrid connects businesses with vetted website builders, Webflow designers, Shopify developers, and web agencies. Transparent pricing, milestone escrow protection, and direct collaboration."
>
  
  <!-- HERO SECTION (MATERIAL LUXURY REDESIGN) -->
  <section class="relative overflow-hidden bg-page-bg border-b border-border/80 pt-10 pb-16 lg:pt-16 lg:pb-24">
    
    <!-- Architectural Subtle Grid Background with Radial Mask -->
    <div class="absolute inset-0 bg-[linear-gradient(to_right,#E4E7EC_1px,transparent_1px),linear-gradient(to_bottom,#E4E7EC_1px,transparent_1px)] bg-[size:4rem_4rem] [mask-image:radial-gradient(ellipse_70%_60%_at_50%_0%,#000_60%,transparent_100%)] opacity-60 pointer-events-none" />
    
    <!-- Ambient Luminous Glow Accent -->
    <div class="absolute top-0 right-1/4 w-96 h-96 bg-primary/10 rounded-full blur-3xl pointer-events-none -z-0" />
    <div class="absolute top-1/3 left-10 w-80 h-80 bg-soft-primary/60 rounded-full blur-3xl pointer-events-none -z-0" />

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-10 items-center">
        
        <!-- Left Hero Content -->
        <div class="lg:col-span-6 space-y-6 text-left">
          
          <!-- Eyebrow Pill -->
          <div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full bg-white/90 backdrop-blur-md border border-slate-200/90 shadow-2xs text-xs font-semibold text-slate-800">
            <span class="flex h-2 w-2 relative">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-primary"></span>
            </span>
            <span>Vetted Web Specialists & Agencies</span>
            <span class="text-slate-300">|</span>
            <span class="text-primary font-bold">100% Escrow Protected</span>
          </div>

          <!-- Headline (Editorial Precision & Luxury Contrast) -->
          <h1 class="text-4xl sm:text-5xl lg:text-[56px] font-black text-dark tracking-tight leading-[1.08]">
            Find the website expert who <span class="relative inline-block text-primary">
              fits your project
              <span class="absolute left-0 bottom-1.5 w-full h-2.5 bg-soft-primary -z-10 rounded-xs"></span>
            </span>
          </h1>

          <!-- Supporting Text -->
          <p class="text-base sm:text-lg text-secondary leading-relaxed max-w-xl font-normal">
            Direct access to senior Webflow designers, Shopify architects, and full-stack website builders. Compare fixed-scope services or post a custom brief with milestone-guaranteed payouts.
          </p>

          <!-- Material Search Bar Component -->
          <form
            action="/services"
            method="GET"
            class="bg-white/95 backdrop-blur-md p-2 sm:p-2.5 rounded-2xl border border-slate-200 shadow-[0_12px_32px_rgba(16,24,40,0.06)] flex flex-col sm:flex-row items-stretch sm:items-center gap-2 max-w-xl transition-all focus-within:border-primary/60 focus-within:shadow-[0_12px_32px_rgba(99,91,255,0.12)]"
          >
            <div class="relative flex-1 flex items-center">
              <svg class="w-5 h-5 text-slate-400 absolute left-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
              <input
                type="text"
                name="q"
                placeholder="What do you need built? (e.g. Shopify, Webflow, SaaS)..."
                class="w-full pl-10 pr-3 py-2.5 text-sm bg-transparent border-0 focus:outline-none focus:ring-0 text-dark placeholder:text-slate-400 font-medium"
              />
            </div>
            
            <div class="hidden sm:block h-7 w-px bg-slate-200 mx-1" />

            <select
              name="category"
              class="hidden sm:block text-xs font-semibold text-slate-700 bg-slate-50 border border-slate-200/80 rounded-xl px-3 py-2.5 focus:outline-none cursor-pointer hover:bg-slate-100 transition"
            >
              <option value="">All Disciplines</option>
              <option value="business-websites">Business Websites</option>
              <option value="ecommerce">Ecommerce Stores</option>
              <option value="landing-pages">Landing Pages</option>
              <option value="saas-websites">SaaS Websites</option>
              <option value="web-applications">Web Applications</option>
              <option value="website-redesign">Website Redesign</option>
            </select>

            <button
              type="submit"
              class="px-6 py-3 bg-gradient-to-r from-primary to-[#5147E5] hover:from-[#5147E5] hover:to-[#4338CA] text-white text-sm font-bold rounded-xl shadow-sm shadow-primary/30 transition-all shrink-0 flex items-center justify-center gap-1.5"
            >
              <span>Search Experts</span>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </button>
          </form>

          <!-- Primary Actions -->
          <div class="flex flex-wrap items-center gap-3 pt-1">
            <a
              href="/talent"
              class="px-6 py-3 rounded-xl bg-primary hover:bg-primary-hover text-white text-sm font-bold shadow-sm shadow-primary/20 transition-all flex items-center gap-2"
            >
              <span>Explore Talent Directory</span>
              <span class="text-xs opacity-80">→</span>
            </a>
            <a
              href="/post-project"
              class="px-6 py-3 rounded-xl bg-white border border-slate-200/90 hover:bg-slate-50 hover:border-slate-300 text-dark text-sm font-bold shadow-subtle transition-all"
            >
              Post a Project Brief
            </a>
          </div>

          <!-- Popular Platform Tags -->
          <div class="pt-1 text-xs text-secondary flex flex-wrap items-center gap-2">
            <span class="font-bold text-slate-400 uppercase tracking-wider text-[11px]">Trending:</span>
            <a href="/services?platform=Shopify" class="px-2.5 py-1 rounded-md bg-white border border-slate-200 hover:border-primary hover:text-primary transition font-medium shadow-2xs">Shopify</a>
            <a href="/services?platform=Webflow" class="px-2.5 py-1 rounded-md bg-white border border-slate-200 hover:border-primary hover:text-primary transition font-medium shadow-2xs">Webflow</a>
            <a href="/services?platform=WordPress" class="px-2.5 py-1 rounded-md bg-white border border-slate-200 hover:border-primary hover:text-primary transition font-medium shadow-2xs">WordPress</a>
            <a href="/services?category=landing-pages" class="px-2.5 py-1 rounded-md bg-white border border-slate-200 hover:border-primary hover:text-primary transition font-medium shadow-2xs">Framer Landing</a>
            <a href="/services?platform=Next.js" class="px-2.5 py-1 rounded-md bg-white border border-slate-200 hover:border-primary hover:text-primary transition font-medium shadow-2xs">Next.js / Astro</a>
          </div>

        </div>

        <!-- Right Hero Visual: Luxurious Material UI Canvas -->
        <div class="lg:col-span-6 relative">
          
          <!-- Outer Material Browser/Platform Canvas Frame -->
          <div class="relative mx-auto max-w-lg lg:max-w-none bg-white/80 backdrop-blur-xl rounded-3xl border border-slate-200/90 shadow-[0_24px_60px_rgba(16,24,40,0.08)] p-4 sm:p-6 space-y-4">
            
            <!-- Window Bar Chrome Header -->
            <div class="flex items-center justify-between pb-3 border-b border-slate-100 text-xs">
              <div class="flex items-center gap-1.5">
                <span class="w-3 h-3 rounded-full bg-slate-200" />
                <span class="w-3 h-3 rounded-full bg-slate-200" />
                <span class="w-3 h-3 rounded-full bg-slate-200" />
                <span class="ml-2 font-mono text-[11px] text-slate-400 hidden sm:inline">craftgrid.com/services/webflow-enterprise</span>
              </div>
              <div class="flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-emerald-50 border border-emerald-200/80 text-[11px] font-bold text-emerald-700">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse" />
                <span>Live Escrow Active</span>
              </div>
            </div>

            <!-- Primary Service Showcase: Maya Bennett -->
            <div class="bg-white rounded-2xl border border-slate-200/80 p-4 sm:p-5 shadow-card hover:shadow-card-hover transition-all duration-300">
              
              <!-- Builder Identity Row -->
              <div class="flex items-center justify-between mb-3.5">
                <div class="flex items-center gap-3">
                  <div class="relative">
                    <img
                      src="https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?w=120&auto=format&fit=crop&q=80"
                      alt="Maya Bennett"
                      class="w-11 h-11 rounded-full object-cover border-2 border-white shadow-sm"
                    />
                    <span class="absolute bottom-0 right-0 w-3 h-3 rounded-full bg-emerald-500 border-2 border-white" />
                  </div>
                  <div>
                    <div class="flex items-center gap-1.5">
                      <span class="text-sm font-bold text-dark">Maya Bennett</span>
                      <span class="w-4 h-4 rounded-full bg-primary text-white flex items-center justify-center text-[9px] font-black" title="Verified Pro Builder">✓</span>
                    </div>
                    <p class="text-xs text-secondary font-medium">Senior Webflow Architect · Austin, TX</p>
                  </div>
                </div>
                <div class="text-right">
                  <span class="px-2.5 py-1 rounded-full bg-soft-primary text-primary font-bold text-xs">
                    Top Rated Plus
                  </span>
                </div>
              </div>

              <!-- Service Title & Visual Preview -->
              <div class="aspect-[16/9] rounded-xl overflow-hidden bg-slate-100 relative border border-border group mb-3">
                <img
                  src="https://images.unsplash.com/photo-1460925895917-afdab827c52f?w=800&auto=format&fit=crop&q=80"
                  alt="High-Converting Webflow Architecture"
                  class="w-full h-full object-cover group-hover:scale-103 transition-transform duration-500"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-transparent opacity-80" />
                <div class="absolute bottom-3 left-3 right-3 flex items-center justify-between text-white text-xs">
                  <span class="font-bold drop-shadow-sm">Conversion-Focused Webflow Architecture</span>
                  <span class="bg-white/90 backdrop-blur-xs text-dark px-2 py-0.5 rounded text-[11px] font-bold">14 Days Delivery</span>
                </div>
              </div>

              <!-- Deliverables Checklist & Price -->
              <div class="pt-1 flex flex-wrap items-center justify-between gap-2 text-xs border-t border-slate-100">
                <div class="flex items-center gap-3 text-secondary">
                  <span class="flex items-center gap-1 font-medium"><strong class="text-emerald-600">✓</strong> 5 Custom Pages</span>
                  <span class="flex items-center gap-1 font-medium"><strong class="text-emerald-600">✓</strong> CMS Architecture</span>
                  <span class="flex items-center gap-1 font-medium"><strong class="text-emerald-600">✓</strong> 99+ Speed Score</span>
                </div>
                <div>
                  <span class="text-xs text-slate-400 font-medium">From </span>
                  <span class="text-base font-black text-dark">$3,200</span>
                </div>
              </div>

            </div>

            <!-- Material Layered Card 1: Milestone Escrow Approval Card -->
            <div class="bg-white/95 backdrop-blur-md rounded-2xl border border-slate-200/80 p-3.5 shadow-card flex items-center justify-between gap-4">
              <div class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-xl bg-emerald-50 text-emerald-600 border border-emerald-200/80 flex items-center justify-center font-bold text-sm shrink-0">
                  🛡️
                </div>
                <div class="text-xs">
                  <p class="font-bold text-dark">Milestone 2 Approved: Design System & Wireframes</p>
                  <p class="text-[11px] text-secondary">Escrow milestone released ($1,800.00)</p>
                </div>
              </div>
              <span class="text-[11px] font-bold text-emerald-700 bg-emerald-50 px-2.5 py-1 rounded-full border border-emerald-200 shrink-0">
                100% Escrow Protected
              </span>
            </div>

            <!-- Material Layered Card 2: Active Project Brief Preview -->
            <div class="bg-white/95 backdrop-blur-md rounded-2xl border border-slate-200/80 p-3.5 shadow-card flex items-center justify-between gap-3 text-xs">
              <div class="min-w-0">
                <div class="flex items-center gap-2">
                  <span class="text-[10px] text-primary uppercase font-bold tracking-wider">Active Client Brief</span>
                  <span class="text-slate-300">·</span>
                  <span class="text-[11px] text-slate-500">Lumina Botanicals</span>
                </div>
                <p class="font-bold text-dark truncate mt-0.5">Shopify DTC Flagship Redesign with Custom Cart Drawer</p>
              </div>
              <div class="text-right shrink-0">
                <span class="font-black text-dark bg-slate-100 px-2.5 py-1 rounded-lg block text-xs">
                  $4,500 – $6,500
                </span>
                <span class="text-[10px] text-emerald-600 font-semibold mt-0.5 block">3 Proposals</span>
              </div>
            </div>

            <!-- Material Layered Card 3: Floating Client Testimonial -->
            <div class="bg-white/95 backdrop-blur-md rounded-2xl border border-slate-200/80 p-3.5 shadow-card flex items-start gap-3 text-xs">
              <img
                src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=100&auto=format&fit=crop&q=80"
                alt="Olivia Vance"
                class="w-9 h-9 rounded-full object-cover border border-slate-200 shrink-0 mt-0.5"
              />
              <div class="space-y-1">
                <div class="flex items-center gap-1.5">
                  <span class="text-amber-500 text-xs tracking-wider">★★★★★</span>
                  <span class="text-slate-300">·</span>
                  <span class="text-[11px] text-slate-600 font-bold">Olivia Vance</span>
                  <span class="text-[10px] text-slate-400">Founder, Lumina Botanicals</span>
                </div>
                <p class="text-slate-700 font-medium leading-relaxed italic">
                  "Maya delivered our Webflow design in 18 days. The milestone escrow workflow took all the uncertainty out of the engagement."
                </p>
              </div>
            </div>

          </div>
        </div>

      </div>

      <!-- LIVE MATERIAL METRICS BANNER -->
      <div class="mt-16 bg-white/90 backdrop-blur-md rounded-2xl border border-slate-200/80 shadow-[0_4px_24px_rgba(16,24,40,0.04)] p-6 sm:p-8 grid grid-cols-2 md:grid-cols-4 gap-6 text-left divide-y md:divide-y-0 md:divide-x divide-slate-100">
        <div class="pt-4 md:pt-0">
          <span class="text-2xl sm:text-3xl font-black text-dark tracking-tight block">$3.8M+</span>
          <p class="text-xs text-secondary mt-1 font-semibold">Milestone Escrow Disbursed</p>
          <p class="text-[11px] text-slate-400">Zero fraud or payment disputes</p>
        </div>
        <div class="pt-4 md:pt-0 md:pl-6">
          <span class="text-2xl sm:text-3xl font-black text-dark tracking-tight block">4.92 / 5.0</span>
          <p class="text-xs text-secondary mt-1 font-semibold">Client Satisfaction Score</p>
          <p class="text-[11px] text-slate-400">From 1,400+ verified ratings</p>
        </div>
        <div class="pt-4 md:pt-0 md:pl-6">
          <span class="text-2xl sm:text-3xl font-black text-dark tracking-tight block">99.4%</span>
          <p class="text-xs text-secondary mt-1 font-semibold">On-Time Milestone Delivery</p>
          <p class="text-[11px] text-slate-400">Strict delivery time tracking</p>
        </div>
        <div class="pt-4 md:pt-0 md:pl-6">
          <span class="text-2xl sm:text-3xl font-black text-dark tracking-tight block">100%</span>
          <p class="text-xs text-secondary mt-1 font-semibold">Vetted Website Experts</p>
          <p class="text-[11px] text-slate-400">Code & portfolio audit on every pro</p>
        </div>
      </div>

    </div>
  </section>

  <!-- POPULAR WEBSITE SERVICES -->
  <section class="py-16 bg-white border-b border-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-10 gap-4">
        <div>
          <span class="text-xs font-bold text-primary uppercase tracking-wider">Specialized Disciplines</span>
          <h2 class="text-2xl sm:text-3xl font-bold text-dark tracking-tight mt-1">Popular Website Services</h2>
          <p class="text-sm text-secondary mt-1">Explore standardized service scopes with upfront pricing and verified deliverables.</p>
        </div>
        <a href="/services" class="text-xs font-bold text-primary hover:text-primary-hover flex items-center gap-1 shrink-0">
          <span>Explore All 8 Categories</span>
          <span>→</span>
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {popularCategories.map(cat => (
          <CategoryCard category={cat} />
        ))}
      </div>
    </div>
  </section>

  <!-- FEATURED SERVICES -->
  <section class="py-16 bg-page-bg border-b border-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-10 gap-4">
        <div>
          <span class="text-xs font-bold text-primary uppercase tracking-wider">Handpicked Listings</span>
          <h2 class="text-2xl sm:text-3xl font-bold text-dark tracking-tight mt-1">Featured Website Services</h2>
          <p class="text-sm text-secondary mt-1">Transparent scopes from verified website builders ready to commence work.</p>
        </div>
        <a href="/services" class="text-xs font-bold text-primary hover:text-primary-hover flex items-center gap-1 shrink-0">
          <span>View All Services</span>
          <span>→</span>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {featuredServices.map(service => (
          <ServiceCard service={service} />
        ))}
      </div>
    </div>
  </section>

  <!-- HOW CRAFTGRID WORKS -->
  <section class="py-16 bg-white border-b border-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <span class="text-xs font-bold text-primary uppercase tracking-wider">Transparent Collaboration</span>
        <h2 class="text-2xl sm:text-3xl font-bold text-dark tracking-tight mt-1">How CraftGrid Works</h2>
        <p class="text-sm text-secondary mt-2">
          A modern milestone-based workflow designed to eliminate risk for both clients and creators.
        </p>
      </div>

      <!-- Two Track Comparison: Clients & Builders -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12">
        
        <!-- Client Track -->
        <div class="bg-page-bg rounded-2xl border border-border p-6 sm:p-8 space-y-6">
          <div class="flex items-center gap-3 border-b border-border pb-4">
            <span class="w-8 h-8 rounded-lg bg-soft-primary text-primary flex items-center justify-center font-bold text-sm">1</span>
            <div>
              <h3 class="text-base font-bold text-dark">For Businesses & Clients</h3>
              <p class="text-xs text-secondary">Hire with total milestone escrow protection</p>
            </div>
          </div>

          <div class="space-y-4 text-xs">
            <div class="flex items-start gap-3">
              <span class="w-6 h-6 rounded-full bg-white border border-border text-slate-700 font-bold flex items-center justify-center shrink-0">1</span>
              <div>
                <strong class="text-slate-900 block text-sm font-semibold">Find a service or post your brief</strong>
                <p class="text-secondary mt-0.5 leading-relaxed">Choose a packaged service or publish a custom project brief specifying your target platform, pages, and budget.</p>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <span class="w-6 h-6 rounded-full bg-white border border-border text-slate-700 font-bold flex items-center justify-center shrink-0">2</span>
              <div>
                <strong class="text-slate-900 block text-sm font-semibold">Compare builders and proposals</strong>
                <p class="text-secondary mt-0.5 leading-relaxed">Review builder ratings, verified portfolio case studies, proposed turnaround times, and milestone breakdowns.</p>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <span class="w-6 h-6 rounded-full bg-white border border-border text-slate-700 font-bold flex items-center justify-center shrink-0">3</span>
              <div>
                <strong class="text-slate-900 block text-sm font-semibold">Collaborate through CraftGrid</strong>
                <p class="text-secondary mt-0.5 leading-relaxed">Exchange feedback, review staging links, and track deliverable progress in your dedicated Order Workspace.</p>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <span class="w-6 h-6 rounded-full bg-white border border-border text-slate-700 font-bold flex items-center justify-center shrink-0">4</span>
              <div>
                <strong class="text-slate-900 block text-sm font-semibold">Approve the work and release payment</strong>
                <p class="text-secondary mt-0.5 leading-relaxed">Deposit funds into escrow once, then release payments phase-by-phase as each milestone is delivered to your satisfaction.</p>
              </div>
            </div>
          </div>

          <div class="pt-2">
            <a href="/post-project" class="inline-block w-full py-2.5 bg-primary hover:bg-primary-hover text-white rounded-xl text-xs font-bold text-center shadow-xs transition">
              Post a Project Brief
            </a>
          </div>
        </div>

        <!-- Builder Track -->
        <div class="bg-page-bg rounded-2xl border border-border p-6 sm:p-8 space-y-6">
          <div class="flex items-center gap-3 border-b border-border pb-4">
            <span class="w-8 h-8 rounded-lg bg-emerald-50 text-emerald-600 flex items-center justify-center font-bold text-sm">2</span>
            <div>
              <h3 class="text-base font-bold text-dark">For Website Builders & Agencies</h3>
