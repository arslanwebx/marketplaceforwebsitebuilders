---
import AdminLayout from '@/layouts/AdminLayout.astro';
import { services } from '@/data/services';
import { builders } from '@/data/builders';
import { projects } from '@/data/projects';
import { orders } from '@/data/orders';
import { transactions } from '@/data/transactions';
import { formatCurrency } from '@/lib/formatters';

const gmv = orders.reduce((sum, o) => sum + o.totalAmount, 128500);
const activeListingsCount = services.length;
const totalBuildersCount = builders.length;
const openProjectsCount = projects.length;
---

<AdminLayout title="Platform Operations & GMV">
  <div class="space-y-8">
    
    <!-- Title & System Status Banner -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-4 border-b border-slate-800">
      <div>
        <h1 class="text-2xl font-bold text-white tracking-tight">Marketplace Operations Overview</h1>
        <p class="text-xs text-slate-400 mt-1">Real-time marketplace health, gross volume, listings moderation, and disputes.</p>
      </div>

      <div class="flex items-center gap-2 px-3 py-1.5 rounded-lg bg-emerald-950/60 border border-emerald-800/80">
        <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
        </svg>
        <span class="text-xs font-semibold text-emerald-300">All Systems Operational</span>
      </div>
    </div>

    <!-- 5 Admin Metric Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5 space-y-1">
        <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Gross Volume (GMV)</span>
        <p class="text-2xl font-black text-white">{formatCurrency(gmv)}</p>
        <span class="text-xs text-emerald-400 font-semibold">+18.4% this month</span>
      </div>

      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5 space-y-1">
        <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Total Users</span>
        <p class="text-2xl font-black text-white">1,428</p>
        <span class="text-xs text-slate-400 font-medium">1,120 clients · {totalBuildersCount} vetted builders</span>
      </div>

      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5 space-y-1">
        <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Active Services</span>
        <p class="text-2xl font-black text-white">{activeListingsCount}</p>
        <span class="text-xs text-emerald-400 font-semibold">100% verified scopes</span>
      </div>

      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5 space-y-1">
        <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Open Briefs</span>
        <p class="text-2xl font-black text-white">{openProjectsCount}</p>
        <span class="text-xs text-slate-400 font-medium">$42k total open budget</span>
      </div>

      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5 space-y-1">
        <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Pending Moderation</span>
        <p class="text-2xl font-black text-amber-400">2</p>
        <span class="text-xs text-slate-400 font-medium">New builder applications</span>
      </div>
    </div>

    <!-- Moderation Queue Module -->
    <section id="moderation" class="bg-slate-900 border border-slate-800 rounded-2xl p-6 space-y-4">
      <div class="flex items-center justify-between pb-3 border-b border-slate-800">
        <div>
          <h2 class="text-base font-bold text-white">Builder Verification & Moderation Queue</h2>
          <p class="text-xs text-slate-400">Review pending seller profiles and portfolio audits before public approval.</p>
        </div>
        <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-amber-500/20 text-amber-400 border border-amber-500/30">
          2 Pending Audits
        </span>
      </div>

      <div class="space-y-3 text-xs">
        <div class="p-4 rounded-xl bg-slate-950/60 border border-slate-800 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div class="flex items-center gap-3">
            <img
              src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=100&auto=format&fit=crop&q=80"
              alt="Elena"
              class="w-10 h-10 rounded-full object-cover border border-slate-700"
            />
            <div>
              <span class="font-bold text-white block">Elena Rostova (Squarespace & Wix Specialist)</span>
              <span class="text-slate-400">Submitted portfolio: atelier-blume.de · Berlin, Germany</span>
            </div>
          </div>

          <div class="flex items-center gap-2">
            <button class="px-3.5 py-1.5 bg-emerald-600 hover:bg-emerald-500 text-white font-semibold rounded-lg">
              Approve Verification
            </button>
            <button class="px-3.5 py-1.5 bg-slate-800 hover:bg-slate-700 text-slate-300 font-semibold rounded-lg border border-slate-700">
              Request Changes
            </button>
          </div>
        </div>

        <div class="p-4 rounded-xl bg-slate-950/60 border border-slate-800 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div class="flex items-center gap-3">
            <img
              src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=100&auto=format&fit=crop&q=80"
              alt="David"
              class="w-10 h-10 rounded-full object-cover border border-slate-700"
            />
            <div>
              <span class="font-bold text-white block">David Kim (Headless Astro & Next.js Engineer)</span>
              <span class="text-slate-400">Submitted portfolio: globalmedtech.org · Lahore, Pakistan</span>
            </div>
          </div>

          <div class="flex items-center gap-2">
            <button class="px-3.5 py-1.5 bg-emerald-600 hover:bg-emerald-500 text-white font-semibold rounded-lg">
              Approve Verification
            </button>
            <button class="px-3.5 py-1.5 bg-slate-800 hover:bg-slate-700 text-slate-300 font-semibold rounded-lg border border-slate-700">
              Request Changes
            </button>
          </div>
        </div>
      </div>
    </section>

    <!-- Recent Platform Transactions -->
    <section id="transactions" class="bg-slate-900 border border-slate-800 rounded-2xl overflow-hidden">
      <div class="p-5 border-b border-slate-800 flex items-center justify-between">
        <h2 class="text-base font-bold text-white">Recent Marketplace Escrow Settlements</h2>
        <span class="text-xs text-slate-400">Platform take-rate: 5.0%</span>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs">
          <thead class="bg-slate-950 border-b border-slate-800 text-slate-400 uppercase tracking-wider font-bold text-[11px]">
            <tr>
              <th class="p-4">Transaction</th>
              <th class="p-4">Date</th>
              <th class="p-4">Order / Milestone</th>
              <th class="p-4">Client</th>
              <th class="p-4">Builder</th>
              <th class="p-4">Gross Value</th>
              <th class="p-4">Platform Fee</th>
              <th class="p-4">Status</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-800 text-slate-300">
            {transactions.map(tx => (
              <tr class="hover:bg-slate-800/40 transition">
                <td class="p-4 font-mono font-bold text-white">{tx.id}</td>
                <td class="p-4 text-slate-400">{tx.date}</td>
                <td class="p-4 font-medium text-white">{tx.orderTitle}</td>
                <td class="p-4">{tx.clientName}</td>
                <td class="p-4">{tx.builderName}</td>
                <td class="p-4 font-bold text-white">{formatCurrency(tx.amount)}</td>
                <td class="p-4 text-emerald-400 font-semibold">+{formatCurrency(tx.fee)}</td>
                <td class="p-4">
                  <span class={`px-2 py-0.5 rounded-full text-[11px] font-semibold ${
                    tx.status === 'Completed'
                      ? 'bg-emerald-500/20 text-emerald-400'
                      : 'bg-primary/20 text-primary'
                  }`}>
                    {tx.status}
                  </span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

  </div>
</AdminLayout>
