---
import MarketplaceLayout from '@/layouts/MarketplaceLayout.astro';
import ProposalModal from '@/components/projects/ProposalModal';
import RatingStars from '@/components/ui/RatingStars.astro';
import { projects } from '@/data/projects';
import { formatCurrency } from '@/lib/formatters';
import type { Project } from '@/types/marketplace';

export async function getStaticPaths() {
  return projects.map(project => ({
    params: { slug: project.slug },
    props: { project }
  }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<MarketplaceLayout
  title={`${project.title} | CraftGrid Projects`}
  description={project.summary}
  breadcrumbs={[
    { label: 'Projects', href: '/projects' },
    { label: project.category, href: `/projects?category=${project.category}` },
    { label: project.title }
  ]}
>
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-10 items-start">
    
    <!-- Left Details Column -->
    <div class="lg:col-span-2 space-y-8">
      
      <!-- Header -->
      <div class="space-y-3">
        <div class="flex flex-wrap items-center gap-2 text-xs text-secondary">
          <span class="px-2.5 py-0.5 rounded-full font-semibold bg-soft-primary text-primary">
            {project.platform}
          </span>
          <span class="px-2.5 py-0.5 rounded-full font-semibold bg-slate-100 text-slate-700">
            {project.experienceLevel} Level
          </span>
          <span>·</span>
          <span>Posted {project.postedAt}</span>
          <span>·</span>
          <span class="text-emerald-600 font-semibold">{project.status}</span>
        </div>

        <h1 class="text-2xl sm:text-3xl font-black text-dark tracking-tight leading-snug">
          {project.title}
        </h1>
      </div>

      <!-- Quick Metrics Ribbon -->
      <div class="grid grid-cols-3 gap-3 p-4 rounded-xl bg-white border border-border shadow-subtle text-xs">
        <div>
          <span class="text-slate-400 block text-[11px] uppercase font-bold">Client Budget</span>
          <span class="text-base font-bold text-dark">
            {formatCurrency(project.budget.min)} – {formatCurrency(project.budget.max)}
          </span>
        </div>
        <div>
          <span class="text-slate-400 block text-[11px] uppercase font-bold">Target Timeline</span>
          <span class="text-base font-bold text-dark">{project.timeline}</span>
        </div>
        <div>
          <span class="text-slate-400 block text-[11px] uppercase font-bold">Proposals</span>
          <span class="text-base font-bold text-primary">{project.proposalsCount} Submitted</span>
        </div>
      </div>

      <!-- Detailed Project Scope -->
      <section class="space-y-4 bg-white rounded-2xl border border-border p-6 shadow-subtle">
        <h2 class="text-lg font-bold text-dark">Detailed Project Brief</h2>
        <div class="prose prose-sm max-w-none text-secondary leading-relaxed whitespace-pre-wrap">
          {project.description}
        </div>
      </section>

      <!-- Expected Deliverables Checklist -->
      <section class="space-y-4 bg-white rounded-2xl border border-border p-6 shadow-subtle">
        <h2 class="text-lg font-bold text-dark">Required Project Deliverables</h2>
        <div class="space-y-2.5 text-xs text-secondary">
          {project.deliverables.map(del => (
            <div class="flex items-start gap-2.5">
              <span class="text-emerald-600 font-bold mt-0.5">✓</span>
              <span class="text-slate-700">{del}</span>
            </div>
          ))}
        </div>
      </section>

      <!-- Required Skills -->
      <section class="space-y-3 bg-white rounded-2xl border border-border p-6 shadow-subtle">
        <h2 class="text-lg font-bold text-dark">Required Skills & Expertise</h2>
        <div class="flex flex-wrap gap-2">
          {project.requiredSkills.map(skill => (
            <span class="px-3 py-1 rounded-lg bg-slate-100 text-slate-700 text-xs font-semibold">
              {skill}
            </span>
          ))}
        </div>
      </section>

      <!-- Attachments UI (if any) -->
      {project.attachments && project.attachments.length > 0 && (
        <section class="space-y-3 bg-white rounded-2xl border border-border p-6 shadow-subtle">
          <h2 class="text-lg font-bold text-dark">Project Attachments & References</h2>
          <div class="space-y-2">
            {project.attachments.map(att => (
              <div class="flex items-center justify-between p-3 rounded-xl border border-border bg-slate-50 text-xs">
                <span class="font-semibold text-slate-800">{att.name} ({att.size})</span>
                <span class="text-primary font-bold hover:underline cursor-pointer">Download</span>
              </div>
            ))}
          </div>
        </section>
      )}

    </div>

    <!-- Right Sticky Action Column -->
    <div class="lg:col-span-1 space-y-6">
      
      <!-- Submit Proposal Action Box -->
      <div class="bg-white rounded-2xl border border-border p-6 shadow-card space-y-4 sticky top-24">
        <div>
          <span class="text-xs font-bold text-slate-400 uppercase tracking-wider block">Budget Guidance</span>
          <span class="text-2xl font-black text-dark block mt-1">
            {formatCurrency(project.budget.min)} – {formatCurrency(project.budget.max)}
          </span>
          <span class="text-xs text-secondary mt-0.5 block">{project.timeline} expected turnaround</span>
        </div>

        <ProposalModal client:load project={project} />

        <!-- Client Info Mini Box -->
        <div class="pt-4 border-t border-border space-y-3 text-xs">
          <span class="font-bold text-slate-400 uppercase tracking-wider text-[11px] block">About the Client</span>
          
          <div class="flex items-center gap-3">
            <img
              src={project.client.avatar}
              alt={project.client.name}
              class="w-11 h-11 rounded-full object-cover border border-border"
            />
            <div>
              <span class="font-bold text-dark block text-sm">{project.client.company}</span>
              <span class="text-secondary">{project.client.location}</span>
            </div>
          </div>

          <div class="space-y-1.5 pt-2 border-t border-slate-100 text-secondary">
            <div class="flex justify-between">
              <span>Payment Verification:</span>
              <span class="font-semibold text-emerald-600">Verified Pro</span>
            </div>
            <div class="flex justify-between">
              <span>Projects Posted:</span>
              <span class="font-semibold text-dark">{project.client.projectsPosted} projects</span>
            </div>
            <div class="flex items-center justify-between">
              <span>Client Rating:</span>
              <RatingStars rating={project.client.rating} />
            </div>
          </div>
        </div>

      </div>

    </div>

  </div>
</MarketplaceLayout>
