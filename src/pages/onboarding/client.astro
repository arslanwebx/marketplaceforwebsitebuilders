---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Client Onboarding | CraftGrid">
  <div class="max-w-2xl mx-auto px-4 py-12">
    <div class="bg-white rounded-2xl border border-border p-6 sm:p-10 shadow-card space-y-6">
      
      <div>
        <span class="text-xs font-bold text-primary uppercase tracking-wider">Step 1 of 2 · Client Profile</span>
        <h1 class="text-2xl font-bold text-dark mt-1">Set up your company profile</h1>
        <p class="text-xs text-secondary mt-0.5">Tell builders about your business and upcoming website requirements.</p>
      </div>

      <form
        onsubmit="event.preventDefault(); localStorage.setItem('craftgrid_demo_role', 'client'); window.location.href = '/dashboard/client';"
        class="space-y-4 text-xs"
      >
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block font-bold text-dark mb-1.5">Full Name *</label>
            <input
              type="text"
              required
              value="Olivia Vance"
              class="w-full p-2.5 text-sm bg-slate-50 border border-border rounded-xl focus:bg-white focus:outline-none focus:ring-1 focus:ring-primary"
            />
          </div>

          <div>
            <label class="block font-bold text-dark mb-1.5">Company Name *</label>
            <input
              type="text"
              required
              value="Luminary Brands LLC"
              class="w-full p-2.5 text-sm bg-slate-50 border border-border rounded-xl focus:bg-white focus:outline-none focus:ring-1 focus:ring-primary"
            />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block font-bold text-dark mb-1.5">Company Website</label>
            <input
              type="url"
              placeholder="https://yourbrand.com"
              class="w-full p-2.5 text-sm bg-slate-50 border border-border rounded-xl focus:bg-white focus:outline-none"
            />
          </div>

          <div>
            <label class="block font-bold text-dark mb-1.5">Industry *</label>
            <select class="w-full p-2.5 text-sm bg-slate-50 border border-border rounded-xl focus:bg-white focus:outline-none">
              <option>Ecommerce / DTC Consumer</option>
              <option>B2B SaaS / Software</option>
              <option>Professional Legal / Financial Services</option>
              <option>Healthcare & Medical</option>
              <option>Construction & Industrial</option>
            </select>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block font-bold text-dark mb-1.5">Location *</label>
            <input
              type="text"
              required
              value="Austin, TX"
              class="w-full p-2.5 text-sm bg-slate-50 border border-border rounded-xl focus:bg-white focus:outline-none"
            />
          </div>

          <div>
            <label class="block font-bold text-dark mb-1.5">Typical Website Needs *</label>
            <select class="w-full p-2.5 text-sm bg-slate-50 border border-border rounded-xl focus:bg-white focus:outline-none">
              <option>Shopify Online Storefront</option>
              <option>Webflow Corporate Redesign</option>
              <option>WordPress Enterprise Architecture</option>
              <option>Framer Marketing Landing Pages</option>
            </select>
          </div>
        </div>

        <div>
          <label class="block font-bold text-dark mb-1.5">Estimated Annual Website Budget</label>
          <select class="w-full p-2.5 text-sm bg-slate-50 border border-border rounded-xl focus:bg-white focus:outline-none">
            <option>$3,000 – $10,000</option>
            <option>$10,000 – $25,000</option>
            <option>$25,000 – $50,000</option>
            <option>$50,000+</option>
          </select>
        </div>

        <div class="pt-4 border-t border-border flex items-center justify-between">
          <a href="/signup" class="text-secondary hover:text-dark">Cancel</a>
          <button
            type="submit"
            class="px-6 py-3 bg-primary hover:bg-primary-hover text-white text-xs font-bold rounded-xl shadow-sm transition"
          >
            Complete Setup & Enter Dashboard
          </button>
        </div>
      </form>

    </div>
  </div>
</BaseLayout>
