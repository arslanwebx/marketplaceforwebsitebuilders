---
import MarketplaceLayout from '@/layouts/MarketplaceLayout.astro';
import PortfolioModal from '@/components/talent/PortfolioModal';
import ServiceCard from '@/components/marketplace/ServiceCard.astro';
import ReviewCard from '@/components/marketplace/ReviewCard.astro';
import RatingStars from '@/components/ui/RatingStars.astro';
import { builders } from '@/data/builders';
import { services } from '@/data/services';
import { reviews } from '@/data/reviews';
import { formatCurrency } from '@/lib/formatters';
import type { Builder } from '@/types/marketplace';

export async function getStaticPaths() {
  return builders.map(builder => ({
    params: { username: builder.username },
    props: { builder }
  }));
}

interface Props {
  builder: Builder;
}

const { builder } = Astro.props;

// Associated services & reviews
const builderServices = services.filter(s => s.builderId === builder.id);
const builderReviews = reviews.filter(r => r.targetId === builder.id || builderServices.some(s => s.id === r.targetId));
---

<MarketplaceLayout
  title={`${builder.name} – ${builder.title} | CraftGrid`}
  description={builder.bio}
  breadcrumbs={[
    { label: 'Talent Directory', href: '/talent' },
    { label: builder.name }
  ]}
>
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-10 items-start">
    
    <!-- Main Left Column -->
    <div class="lg:col-span-2 space-y-10">
      
      <!-- Profile Hero Card -->
      <div class="bg-white rounded-2xl border border-border p-6 sm:p-8 shadow-card flex flex-col sm:flex-row items-start gap-6">
        <div class="relative shrink-0">
          <img
            src={builder.avatar}
            alt={builder.name}
            onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=240&auto=format&fit=crop&q=80';"
            class="w-24 h-24 sm:w-28 sm:h-28 rounded-2xl object-cover border-2 border-border shadow-subtle"
          />
          {builder.verified && (
            <span class="absolute -bottom-2 -right-2 px-2 py-0.5 rounded-full bg-soft-primary border border-primary/20 text-primary text-xs font-bold shadow-xs">
              Verified Pro
            </span>
          )}
        </div>

        <div class="space-y-3 flex-1">
          <div>
            <div class="flex items-center gap-2">
              <h1 class="text-2xl sm:text-3xl font-bold text-dark">{builder.name}</h1>
              {builder.earningsRank && (
                <span class="px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-amber-50 text-amber-700 border border-amber-200">
                  {builder.earningsRank}
                </span>
              )}
            </div>
            <p class="text-sm text-primary font-semibold mt-0.5">{builder.title}</p>
            <p class="text-xs text-secondary mt-1">{builder.location}, {builder.country}</p>
          </div>

          <div class="flex flex-wrap items-center gap-4 text-xs pt-1">
            <RatingStars rating={builder.rating} reviewsCount={builder.reviewsCount} size="md" />
            <span>·</span>
            <span class="text-slate-700 font-semibold">{builder.completedProjectsCount} Projects Completed</span>
            <span>·</span>
            <span class="text-emerald-600 font-semibold">Response: {builder.responseTime}</span>
          </div>

          <!-- Quick Action Buttons -->
          <div class="flex items-center gap-3 pt-2">
            <a
              href={`/messages?user=${builder.id}`}
              class="px-5 py-2.5 bg-primary hover:bg-primary-hover text-white text-xs font-bold rounded-xl shadow-xs transition"
            >
              Hire {builder.name.split(' ')[0]}
            </a>
            <a
              href={`/messages?user=${builder.id}`}
              class="px-5 py-2.5 border border-border hover:bg-slate-50 text-slate-700 text-xs font-bold rounded-xl transition"
            >
              Send Message
            </a>
          </div>
        </div>
      </div>

      <!-- About Section -->
      <section class="space-y-3 bg-white rounded-2xl border border-border p-6 shadow-subtle">
        <h2 class="text-lg font-bold text-dark">About {builder.name.split(' ')[0]}</h2>
        <p class="text-xs sm:text-sm text-secondary leading-relaxed whitespace-pre-wrap">
          {builder.bio}
        </p>
      </section>

      <!-- Skills & Platform Expertise -->
      <section class="space-y-3 bg-white rounded-2xl border border-border p-6 shadow-subtle">
        <h2 class="text-lg font-bold text-dark">Skills & Platform Expertise</h2>
        
        <div class="space-y-3 pt-1">
          <div>
            <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400 block mb-2">Core Platforms</span>
            <div class="flex flex-wrap gap-2">
              {builder.platforms.map(p => (
                <span class="px-3 py-1 rounded-lg bg-soft-primary text-primary text-xs font-bold">
                  {p}
                </span>
              ))}
            </div>
          </div>

          <div>
            <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400 block mb-2">Specialties & Tools</span>
            <div class="flex flex-wrap gap-1.5">
              {builder.skills.map(s => (
                <span class="px-2.5 py-1 rounded-lg bg-slate-100 text-slate-700 text-xs font-medium">
                  {s}
                </span>
              ))}
            </div>
          </div>
        </div>
      </section>

      <!-- Portfolio Showcase with Interactive Modal -->
      {builder.portfolio && builder.portfolio.length > 0 && (
        <section class="space-y-4">
          <div class="flex items-center justify-between">
            <h2 class="text-xl font-bold text-dark">Featured Portfolio Work</h2>
            <span class="text-xs text-secondary">{builder.portfolio.length} Showcases</span>
          </div>

          <PortfolioModal client:load items={builder.portfolio} />
        </section>
      )}

      <!-- Published Packaged Services -->
      {builderServices.length > 0 && (
        <section class="space-y-4">
          <div class="flex items-center justify-between">
            <h2 class="text-xl font-bold text-dark">Packaged Services by {builder.name.split(' ')[0]}</h2>
            <span class="text-xs text-secondary">{builderServices.length} Active Services</span>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            {builderServices.map(srv => (
              <ServiceCard service={srv} />
            ))}
          </div>
        </section>
      )}

      <!-- Client Reviews -->
      <section class="space-y-4" id="reviews">
        <div class="flex items-center justify-between">
          <h2 class="text-xl font-bold text-dark">Verified Client Reviews</h2>
          <span class="text-xs font-bold text-dark">{builder.rating.toFixed(2)} ★ ({builder.reviewsCount} reviews)</span>
        </div>

        <div class="space-y-4">
          {builderReviews.length > 0 ? (
            builderReviews.map(r => (
              <ReviewCard review={r} />
            ))
          ) : (
            <p class="text-xs text-secondary italic">No reviews yet.</p>
          )}
        </div>
      </section>

    </div>

    <!-- Right Sticky Profile Sidebar -->
    <div class="lg:col-span-1 space-y-6">
      <div class="bg-white rounded-2xl border border-border p-6 shadow-card space-y-5 sticky top-24">
        <h3 class="text-base font-bold text-dark pb-3 border-b border-border">
          Rates & Engagement Terms
        </h3>

        <div class="space-y-3.5 text-xs">
          <div class="flex justify-between items-baseline">
            <span class="text-secondary font-medium">Hourly Rate:</span>
            <span class="text-xl font-black text-dark">{formatCurrency(builder.hourlyRate)}/hr</span>
          </div>

          <div class="flex justify-between">
            <span class="text-secondary font-medium">Minimum Project:</span>
            <span class="font-bold text-slate-800">{formatCurrency(builder.minimumProjectBudget)}</span>
          </div>

          <div class="flex justify-between">
            <span class="text-secondary font-medium">Availability:</span>
            <span class="font-bold text-emerald-600">{builder.availability}</span>
          </div>

          <div class="flex justify-between">
            <span class="text-secondary font-medium">Response Time:</span>
            <span class="font-bold text-slate-800">{builder.responseTime}</span>
          </div>

          <div class="flex justify-between">
            <span class="text-secondary font-medium">Languages:</span>
            <span class="font-bold text-slate-800">{builder.languages.join(', ')}</span>
          </div>

          <div class="flex justify-between">
            <span class="text-secondary font-medium">Member Since:</span>
            <span class="font-bold text-slate-800">{builder.joinedDate}</span>
          </div>
        </div>

        <div class="pt-3 border-t border-border space-y-2">
          <a
            href={`/messages?user=${builder.id}`}
            class="w-full py-3 bg-primary hover:bg-primary-hover text-white rounded-xl text-xs font-bold text-center block shadow-sm transition"
          >
            Start a Direct Project
          </a>
          <a
            href={`/messages?user=${builder.id}`}
            class="w-full py-2.5 border border-border hover:bg-slate-50 text-slate-700 rounded-xl text-xs font-semibold text-center block transition"
          >
            Ask a Question
          </a>
        </div>
      </div>
    </div>

  </div>
</MarketplaceLayout>
