---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { siteConfig } from '@/config/site';
---

<BaseLayout
  title="About CraftGrid | Specialized Website Marketplace"
  description="CraftGrid was founded to fix the broken process of hiring website builders, designers, and web agencies."
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16 space-y-12">
    
    <div class="space-y-3">
      <span class="text-xs font-bold text-primary uppercase tracking-wider">Our Mission</span>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-dark tracking-tight leading-tight">
        Building the marketplace for better websites.
      </h1>
      <p class="text-base sm:text-lg text-secondary leading-relaxed">
        Websites are the single most important digital investment a business makes. Yet general freelance platforms treat a high-stakes $10,000 Shopify or Webflow project the same way they treat a $20 logo or data entry gig.
      </p>
    </div>

    <!-- The Problem & Solution -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 pt-4 border-t border-border text-xs leading-relaxed text-secondary">
      <div class="space-y-3 bg-white p-6 rounded-2xl border border-border shadow-card">
        <h3 class="text-base font-bold text-dark">The Traditional Problem</h3>
        <p>
          Businesses hiring on massive freelance portals face thousands of unqualified bids, copy-paste AI proposals, hidden outsourcing, and brittle templates that crash within months of delivery.
        </p>
        <p>
          Meanwhile, elite website builders and agencies waste hundreds of hours filtering through race-to-the-bottom bidding wars instead of doing great creative work.
        </p>
      </div>

      <div class="space-y-3 bg-white p-6 rounded-2xl border border-border shadow-card">
        <h3 class="text-base font-bold text-dark">The CraftGrid Standard</h3>
        <p>
          CraftGrid was created as an intentional, specialized marketplace exclusively for professional website builders, designers, developers, and boutique agencies.
        </p>
        <p>
          We enforce verified identity standards, structured project briefs, packaged service scopes with defined deliverables, and transparent milestone escrow that keeps both parties aligned.
        </p>
      </div>
    </div>

    <!-- Platform Principles -->
    <section class="space-y-6">
      <h2 class="text-2xl font-bold text-dark">Our Operating Principles</h2>
      
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
        <div class="bg-white rounded-xl border border-border p-5 shadow-subtle space-y-2">
          <span class="text-lg font-bold text-primary">01</span>
          <h3 class="text-sm font-bold text-dark">Code & Design Integrity</h3>
          <p class="text-xs text-secondary leading-relaxed">
            We evaluate builders on semantic HTML, strict accessibility standards, mobile responsiveness, and clean CMS maintainability.
          </p>
        </div>

        <div class="bg-white rounded-xl border border-border p-5 shadow-subtle space-y-2">
          <span class="text-lg font-bold text-primary">02</span>
          <h3 class="text-sm font-bold text-dark">Milestone Escrow Protection</h3>
          <p class="text-xs text-secondary leading-relaxed">
            Funds remain in escrow until deliverables are inspected. Builders have guaranteed payment upon approved completion, and clients are protected against ghosting.
          </p>
        </div>

        <div class="bg-white rounded-xl border border-border p-5 shadow-subtle space-y-2">
          <span class="text-lg font-bold text-primary">03</span>
          <h3 class="text-sm font-bold text-dark">Human-to-Human Collaboration</h3>
          <p class="text-xs text-secondary leading-relaxed">
            Direct communication without arbitrary barriers. Clear revision rounds, structured reviews, and dedicated mediation when needed.
          </p>
        </div>
      </div>
    </section>

    <!-- Company Details -->
    <div class="bg-white rounded-2xl border border-border p-6 shadow-card space-y-3 text-xs text-secondary">
      <h3 class="text-base font-bold text-dark">Company Information</h3>
      <p>{siteConfig.company.legalName} is headquartered in Austin, Texas.</p>
      <p>Address: {siteConfig.company.address}, {siteConfig.company.suite}, {siteConfig.company.city}, {siteConfig.company.state} {siteConfig.company.postalCode}</p>
    </div>

  </div>
</BaseLayout>
