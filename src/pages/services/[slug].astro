---
import MarketplaceLayout from '@/layouts/MarketplaceLayout.astro';
import ServicePackageTabs from '@/components/services/ServicePackageTabs';
import RatingStars from '@/components/ui/RatingStars.astro';
import ReviewCard from '@/components/marketplace/ReviewCard.astro';
import ServiceCard from '@/components/marketplace/ServiceCard.astro';
import { services } from '@/data/services';
import { reviews } from '@/data/reviews';
import { builders } from '@/data/builders';
import { formatCurrency } from '@/lib/formatters';
import type { Service } from '@/types/marketplace';

export async function getStaticPaths() {
  return services.map(service => ({
    params: { slug: service.slug },
    props: { service }
  }));
}

interface Props {
  service: Service;
}

const { service } = Astro.props;

// Associated reviews
const serviceReviews = reviews.filter(r => r.targetId === service.id || r.targetId === service.builderId);
const builderProfile = builders.find(b => b.id === service.builderId) || builders[0];
const relatedServices = services.filter(s => s.id !== service.id && s.category === service.category).slice(0, 3);
---

<MarketplaceLayout
  title={`${service.title} | CraftGrid`}
  description={service.shortDescription}
  breadcrumbs={[
    { label: 'Services', href: '/services' },
    { label: service.category, href: `/services?category=${service.category.toLowerCase().replace(/\s+/g, '-')}` },
    { label: service.title }
  ]}
>
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-10 items-start">
    
    <!-- Left Main Content Column -->
    <div class="lg:col-span-2 space-y-10">
      
      <!-- Service Header Block -->
      <div class="space-y-4">
        <div class="flex flex-wrap items-center gap-2">
          <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-soft-primary text-primary">
            {service.category}
          </span>
          <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-slate-100 text-slate-700">
            {service.platform}
          </span>
          {service.featured && (
            <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-amber-50 text-amber-700 border border-amber-200">
              Featured Service
            </span>
          )}
        </div>

        <h1 class="text-2xl sm:text-3xl lg:text-4xl font-black text-dark tracking-tight leading-tight">
          {service.title}
        </h1>

        <!-- Builder Meta Row -->
        <div class="flex flex-wrap items-center gap-4 text-xs text-secondary pt-1">
          <a href={`/talent/${service.builder.username}`} class="flex items-center gap-2 text-dark font-bold hover:text-primary transition">
            <img
              src={service.builder.avatar}
              alt={service.builder.name}
              onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=150&auto=format&fit=crop&q=80';"
              class="w-7 h-7 rounded-full object-cover border border-border"
            />
            <span>{service.builder.name}</span>
            {service.builder.verified && <span class="text-primary">✓</span>}
          </a>
          <span>·</span>
          <RatingStars rating={service.rating} reviewsCount={service.reviewsCount} size="sm" />
          <span>·</span>
          <span>{service.builder.completedProjectsCount} projects completed</span>
          <span>·</span>
          <span>{service.builder.location}</span>
        </div>
      </div>

      <!-- Portfolio Gallery / Main Showcase -->
      <div class="space-y-3">
        <div class="rounded-2xl overflow-hidden border border-border shadow-card aspect-[16/9] bg-slate-100">
          <img
            src={service.thumbnail}
            alt={service.title}
            onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1460925895917-afdab827c52f?w=1200&auto=format&fit=crop&q=80';"
            class="w-full h-full object-cover"
          />
        </div>

        {service.galleryImages.length > 1 && (
          <div class="grid grid-cols-3 gap-3">
            {service.galleryImages.map((img, i) => (
              <div class="rounded-xl overflow-hidden border border-border aspect-video bg-slate-100">
                <img
                  src={img}
                  alt={`Preview ${i + 1}`}
                  onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1460925895917-afdab827c52f?w=800&auto=format&fit=crop&q=80';"
                  class="w-full h-full object-cover"
                />
              </div>
            ))}
          </div>
        )}
      </div>

      <!-- About This Service -->
      <section class="space-y-4 pt-4 border-t border-border">
        <h2 class="text-xl font-bold text-dark">About This Service</h2>
        <div class="prose prose-sm max-w-none text-secondary leading-relaxed space-y-3">
          <p class="whitespace-pre-wrap">{service.fullDescription}</p>
        </div>
      </section>

      <!-- Delivery Process -->
      <section class="space-y-4 pt-6 border-t border-border">
        <h2 class="text-xl font-bold text-dark">How I Deliver Your Website</h2>
        <p class="text-xs text-secondary">A transparent, step-by-step milestone progression from discovery to launch.</p>
        
        <div class="space-y-3 pt-2">
          {service.deliveryProcess.map(step => (
            <div class="bg-white rounded-xl border border-border p-4 shadow-subtle flex items-start gap-4">
              <span class="w-8 h-8 rounded-full bg-soft-primary text-primary font-bold flex items-center justify-center text-xs shrink-0 mt-0.5">
                {step.step}
              </span>
              <div>
                <h3 class="text-sm font-bold text-dark">{step.title}</h3>
                <p class="text-xs text-secondary mt-1 leading-relaxed">{step.description}</p>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- What I'll Need From You -->
      <section class="space-y-4 pt-6 border-t border-border">
        <h2 class="text-xl font-bold text-dark">What I'll Need From You</h2>
        <div class="bg-white rounded-xl border border-border p-5 space-y-2.5 text-xs text-secondary">
          {service.requirements.map(req => (
            <div class="flex items-start gap-2.5">
              <span class="text-primary font-bold mt-0.5">→</span>
              <span class="text-slate-700">{req}</span>
            </div>
          ))}
        </div>
      </section>

      <!-- About the Builder Card -->
      <section class="space-y-4 pt-6 border-t border-border">
        <h2 class="text-xl font-bold text-dark">About the Builder</h2>
        <div class="bg-white rounded-2xl border border-border p-6 shadow-card space-y-4">
          <div class="flex items-start justify-between gap-4">
            <div class="flex items-center gap-3.5">
              <img
                src={builderProfile.avatar}
                alt={builderProfile.name}
                class="w-14 h-14 rounded-full object-cover border border-border"
              />
              <div>
                <a href={`/talent/${builderProfile.username}`} class="text-base font-bold text-dark hover:text-primary transition">
                  {builderProfile.name}
                </a>
                <p class="text-xs text-primary font-medium">{builderProfile.title}</p>
                <p class="text-xs text-secondary mt-0.5">{builderProfile.location} · {builderProfile.responseTime}</p>
              </div>
            </div>

            <a
              href={`/talent/${builderProfile.username}`}
              class="px-4 py-2 border border-border hover:bg-slate-50 text-xs font-bold rounded-lg transition"
            >
              View Profile
            </a>
          </div>

          <p class="text-xs text-secondary leading-relaxed">{builderProfile.bio}</p>

          <div class="grid grid-cols-3 gap-2 pt-3 border-t border-border text-center text-xs">
            <div>
              <span class="text-slate-400 block text-[11px]">Rating</span>
              <span class="font-bold text-dark">{builderProfile.rating} ★</span>
            </div>
            <div>
              <span class="text-slate-400 block text-[11px]">Projects</span>
              <span class="font-bold text-dark">{builderProfile.completedProjectsCount} completed</span>
            </div>
            <div>
              <span class="text-slate-400 block text-[11px]">Rate</span>
              <span class="font-bold text-dark">{formatCurrency(builderProfile.hourlyRate)}/hr</span>
            </div>
          </div>
        </div>
      </section>

      <!-- Client Reviews & Rating Distribution -->
      <section class="space-y-6 pt-6 border-t border-border" id="reviews">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div>
            <h2 class="text-xl font-bold text-dark">Client Reviews</h2>
            <div class="flex items-center gap-2 mt-1">
              <RatingStars rating={service.rating} reviewsCount={service.reviewsCount} size="md" />
              <span class="text-xs text-secondary">Verified buyer ratings</span>
            </div>
          </div>

          <!-- Mini Rating Breakdown -->
          <div class="w-48 space-y-1 text-[11px] text-secondary">
            <div class="flex items-center gap-2">
              <span>5 ★</span>
              <div class="flex-1 bg-slate-100 rounded-full h-1.5 overflow-hidden">
                <div class="bg-amber-400 h-full w-[94%]" />
              </div>
              <span class="w-6 text-right">94%</span>
            </div>
            <div class="flex items-center gap-2">
              <span>4 ★</span>
              <div class="flex-1 bg-slate-100 rounded-full h-1.5 overflow-hidden">
                <div class="bg-amber-400 h-full w-[6%]" />
              </div>
              <span class="w-6 text-right">6%</span>
            </div>
          </div>
        </div>

        <div class="space-y-4">
          {serviceReviews.length > 0 ? (
            serviceReviews.map(r => (
              <ReviewCard review={r} />
            ))
          ) : (
            <p class="text-xs text-secondary italic">No reviews yet for this listing.</p>
          )}
        </div>
      </section>

      <!-- FAQ -->
      <section class="space-y-4 pt-6 border-t border-border">
        <h2 class="text-xl font-bold text-dark">Frequently Asked Questions</h2>
        <div class="space-y-3">
          {service.faq.map(item => (
            <div class="bg-white rounded-xl border border-border p-4 shadow-subtle space-y-1.5">
              <h3 class="text-sm font-bold text-dark">{item.question}</h3>
              <p class="text-xs text-secondary leading-relaxed">{item.answer}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- Related Services -->
      {relatedServices.length > 0 && (
        <section class="space-y-4 pt-6 border-t border-border">
          <h2 class="text-xl font-bold text-dark">Related Website Services</h2>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            {relatedServices.map(rel => (
              <ServiceCard service={rel} showSaveButton={false} />
            ))}
          </div>
        </section>
      )}

    </div>

    <!-- Right Sticky Order & Package Selector Card -->
    <div class="lg:col-span-1">
      <ServicePackageTabs client:load service={service} />
    </div>

  </div>
</MarketplaceLayout>
