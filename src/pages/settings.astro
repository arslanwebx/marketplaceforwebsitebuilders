---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { siteConfig } from '@/config/site';

const tabs = [
  { id: 'profile', label: 'Profile' },
  { id: 'account', label: 'Account' },
  { id: 'notifications', label: 'Notifications' },
  { id: 'billing', label: 'Billing & Invoices' },
  { id: 'privacy', label: 'Privacy & Data' },
  { id: 'security', label: 'Security & Auth' },
];
---

<BaseLayout title="Account & Preferences Settings" description="Manage your CraftGrid client profile, notification preferences, billing payment methods, and account security.">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-12">
    
    <!-- Page Header -->
    <div class="pb-6 border-b border-border mb-8">
      <h1 class="text-3xl font-black text-dark tracking-tight">Settings & Preferences</h1>
      <p class="text-sm text-secondary mt-1">Manage your identity, notification digests, billing details, and login credentials.</p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
      
      <!-- Settings Tab Nav Sidebar -->
      <aside class="lg:col-span-1">
        <nav class="flex lg:flex-col gap-1 overflow-x-auto pb-2 lg:pb-0" id="settings-tabs">
          {tabs.map((tab, i) => (
            <button
              type="button"
              data-tab={tab.id}
              class={`text-left px-4 py-2.5 rounded-xl text-sm font-semibold transition whitespace-nowrap ${
                i === 0 
                  ? 'bg-soft-primary text-primary font-bold' 
                  : 'text-secondary hover:text-dark hover:bg-slate-100'
              }`}
              onclick={`
                document.querySelectorAll('#settings-tabs button').forEach(b => {
                  b.classList.remove('bg-soft-primary', 'text-primary', 'font-bold');
                  b.classList.add('text-secondary', 'hover:text-dark');
                });
                this.classList.add('bg-soft-primary', 'text-primary', 'font-bold');
                this.classList.remove('text-secondary');
                document.querySelectorAll('.settings-panel').forEach(p => p.classList.add('hidden'));
                document.getElementById('panel-' + this.dataset.tab).classList.remove('hidden');
              `}
            >
              {tab.label}
            </button>
          ))}
        </nav>

        <div class="mt-8 p-4 bg-slate-50 border border-border rounded-xl hidden lg:block text-xs text-secondary space-y-2">
          <p class="font-bold text-dark">Need account support?</p>
          <p>Contact our Austin-based member operations team at {siteConfig.supportEmail}.</p>
        </div>
      </aside>

      <!-- Settings Content Panels -->
      <div class="lg:col-span-3 space-y-6">

        <!-- 1. Profile Panel -->
        <div id="panel-profile" class="settings-panel bg-white border border-border rounded-2xl p-6 sm:p-8 shadow-card space-y-6">
          <div>
            <h2 class="text-lg font-bold text-dark">Public Profile Details</h2>
            <p class="text-xs text-secondary mt-0.5">This information will be displayed on your proposals and reviews.</p>
          </div>

          <form
            class="space-y-5"
            onsubmit="event.preventDefault(); window.dispatchEvent(new CustomEvent('craftgrid_toast', { detail: { message: 'Profile updated successfully!', type: 'success' } }));"
          >
            <!-- Avatar Upload Row -->
            <div class="flex items-center gap-5">
              <img
                src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=150&auto=format&fit=crop&q=80"
                alt="Olivia Vance"
                class="w-16 h-16 rounded-full object-cover border-2 border-primary/20"
              />
              <div class="space-y-1">
                <div class="flex gap-2">
                  <button type="button" class="px-3 py-1.5 bg-white border border-border rounded-lg text-xs font-semibold text-dark hover:border-primary transition">
                    Change Photo
                  </button>
                  <button type="button" class="px-3 py-1.5 text-xs text-rose-600 font-semibold hover:bg-rose-50 rounded-lg transition">
                    Remove
                  </button>
                </div>
                <p class="text-[11px] text-slate-400">JPG, GIF or PNG. Max size of 2MB.</p>
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-semibold text-dark mb-1.5">First Name</label>
                <input type="text" value="Olivia" class="w-full px-3.5 py-2.5 rounded-xl border border-border text-sm focus:outline-none focus:border-primary" />
              </div>
              <div>
                <label class="block text-xs font-semibold text-dark mb-1.5">Last Name</label>
                <input type="text" value="Vance" class="w-full px-3.5 py-2.5 rounded-xl border border-border text-sm focus:outline-none focus:border-primary" />
              </div>
            </div>

            <div>
              <label class="block text-xs font-semibold text-dark mb-1.5">Company / Organization</label>
              <input type="text" value="Lumina Botanicals" class="w-full px-3.5 py-2.5 rounded-xl border border-border text-sm focus:outline-none focus:border-primary" />
            </div>

            <div>
              <label class="block text-xs font-semibold text-dark mb-1.5">Headline / Professional Bio</label>
              <textarea rows="3" class="w-full px-3.5 py-2.5 rounded-xl border border-border text-sm focus:outline-none focus:border-primary">Founder & Head of Product at Lumina Botanicals. Creating sustainable skincare rituals with direct-to-consumer ecommerce.</textarea>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-semibold text-dark mb-1.5">Location</label>
                <input type="text" value="Austin, TX, United States" class="w-full px-3.5 py-2.5 rounded-xl border border-border text-sm focus:outline-none focus:border-primary" />
              </div>
              <div>
                <label class="block text-xs font-semibold text-dark mb-1.5">Website</label>
                <input type="url" value="https://luminabotanicals.demo" class="w-full px-3.5 py-2.5 rounded-xl border border-border text-sm focus:outline-none focus:border-primary" />
              </div>
            </div>

            <div class="pt-4 border-t border-border flex justify-end">
              <button type="submit" class="px-5 py-2.5 bg-primary hover:bg-primary-hover text-white text-xs font-bold rounded-xl shadow-subtle transition">
                Save Profile Changes
              </button>
            </div>
          </form>
        </div>

        <!-- 2. Account Panel -->
        <div id="panel-account" class="settings-panel bg-white border border-border rounded-2xl p-6 sm:p-8 shadow-card space-y-6 hidden">
          <div>
            <h2 class="text-lg font-bold text-dark">Account Credentials</h2>
            <p class="text-xs text-secondary mt-0.5">Manage your primary sign-in email and platform username.</p>
          </div>

          <div class="space-y-4">
            <div>
              <label class="block text-xs font-semibold text-dark mb-1.5">Email Address</label>
              <input type="email" value="olivia.vance@luminabotanicals.demo" class="w-full px-3.5 py-2.5 rounded-xl border border-border text-sm focus:outline-none focus:border-primary" />
            </div>
            <div>
              <label class="block text-xs font-semibold text-dark mb-1.5">Username Handle</label>
              <div class="flex items-center">
                <span class="px-3.5 py-2.5 bg-slate-100 border border-r-0 border-border text-xs text-secondary rounded-l-xl">craftgrid.com/users/</span>
                <input type="text" value="oliviavance" class="w-full px-3.5 py-2.5 rounded-r-xl border border-border text-sm focus:outline-none focus:border-primary" />
              </div>
            </div>
          </div>
        </div>

        <!-- 3. Notifications Panel -->
        <div id="panel-notifications" class="settings-panel bg-white border border-border rounded-2xl p-6 sm:p-8 shadow-card space-y-6 hidden">
          <div>
            <h2 class="text-lg font-bold text-dark">Notification Preferences</h2>
            <p class="text-xs text-secondary mt-0.5">Control which updates are delivered to your email and in-app bell.</p>
          </div>

          <div class="space-y-3">
            <label class="flex items-center justify-between p-4 border border-border rounded-xl cursor-pointer hover:bg-slate-50 transition">
              <div>
                <p class="text-sm font-semibold text-dark">New Proposal Notifications</p>
                <p class="text-xs text-secondary">Get instant alert when a builder applies to your project brief</p>
              </div>
              <input type="checkbox" checked class="w-4 h-4 accent-primary" />
            </label>

            <label class="flex items-center justify-between p-4 border border-border rounded-xl cursor-pointer hover:bg-slate-50 transition">
              <div>
                <p class="text-sm font-semibold text-dark">Direct Chat Messages</p>
                <p class="text-xs text-secondary">Alert me when a collaborator sends a message</p>
              </div>
              <input type="checkbox" checked class="w-4 h-4 accent-primary" />
            </label>

            <label class="flex items-center justify-between p-4 border border-border rounded-xl cursor-pointer hover:bg-slate-50 transition">
              <div>
                <p class="text-sm font-semibold text-dark">Milestone Submissions & Releases</p>
                <p class="text-xs text-secondary">Notify when deliverables are submitted for client review</p>
              </div>
              <input type="checkbox" checked class="w-4 h-4 accent-primary" />
            </label>
          </div>
        </div>

        <!-- 4. Billing Panel -->
        <div id="panel-billing" class="settings-panel bg-white border border-border rounded-2xl p-6 sm:p-8 shadow-card space-y-6 hidden">
          <div>
            <h2 class="text-lg font-bold text-dark">Billing & Payment Methods</h2>
            <p class="text-xs text-secondary mt-0.5">Cards on file for milestone escrow funding and invoices.</p>
          </div>

          <div class="p-4 border border-border rounded-xl flex items-center justify-between">
            <div class="flex items-center gap-3">
              <div class="w-10 h-7 bg-slate-900 text-white text-[10px] font-black rounded flex items-center justify-center">
                VISA
              </div>
              <div>
                <p class="text-xs font-bold text-dark">Visa ending in 4242</p>
                <p class="text-[11px] text-secondary">Expires 09/2028 · Primary for escrow</p>
              </div>
            </div>
            <span class="px-2 py-0.5 bg-emerald-50 text-emerald-700 text-[11px] font-bold rounded">Active</span>
          </div>

          <a href="/dashboard/client/payments" class="inline-block text-xs font-bold text-primary hover:underline">
            View All Escrow Invoices & Transaction History →
          </a>
        </div>

        <!-- 5. Privacy Panel -->
        <div id="panel-privacy" class="settings-panel bg-white border border-border rounded-2xl p-6 sm:p-8 shadow-card space-y-6 hidden">
          <div>
            <h2 class="text-lg font-bold text-dark">Privacy & Public Visibility</h2>
            <p class="text-xs text-secondary mt-0.5">Manage search engine indexing and proposal confidentiality.</p>
          </div>

          <div class="space-y-3">
            <label class="flex items-center justify-between p-4 border border-border rounded-xl cursor-pointer hover:bg-slate-50 transition">
              <div>
                <p class="text-sm font-semibold text-dark">Search Engine Indexing</p>
                <p class="text-xs text-secondary">Allow search engines to index your public client profile and feedback</p>
              </div>
              <input type="checkbox" checked class="w-4 h-4 accent-primary" />
            </label>

            <label class="flex items-center justify-between p-4 border border-border rounded-xl cursor-pointer hover:bg-slate-50 transition">
              <div>
                <p class="text-sm font-semibold text-dark">Public Project Briefs</p>
                <p class="text-xs text-secondary">Show your completed projects on hired builder portfolio showcases</p>
              </div>
              <input type="checkbox" checked class="w-4 h-4 accent-primary" />
            </label>
          </div>
        </div>

        <!-- 6. Security Panel -->
        <div id="panel-security" class="settings-panel bg-white border border-border rounded-2xl p-6 sm:p-8 shadow-card space-y-6 hidden">
          <div>
            <h2 class="text-lg font-bold text-dark">Security & Multi-Factor Auth</h2>
            <p class="text-xs text-secondary mt-0.5">Keep your account secure with strong passwords and two-factor authentication.</p>
          </div>

          <div class="space-y-4">
            <div>
              <label class="block text-xs font-semibold text-dark mb-1.5">Current Password</label>
              <input type="password" placeholder="••••••••••••" class="w-full px-3.5 py-2.5 rounded-xl border border-border text-sm focus:outline-none focus:border-primary" />
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-semibold text-dark mb-1.5">New Password</label>
                <input type="password" placeholder="••••••••••••" class="w-full px-3.5 py-2.5 rounded-xl border border-border text-sm focus:outline-none focus:border-primary" />
              </div>
              <div>
                <label class="block text-xs font-semibold text-dark mb-1.5">Confirm New Password</label>
                <input type="password" placeholder="••••••••••••" class="w-full px-3.5 py-2.5 rounded-xl border border-border text-sm focus:outline-none focus:border-primary" />
              </div>
            </div>
            <div class="pt-2">
              <button type="button" onclick="alert('Password updated in demo session.');" class="px-4 py-2 bg-dark text-white text-xs font-bold rounded-xl hover:bg-black transition">
                Update Password
              </button>
            </div>
          </div>
        </div>

      </div>

    </div>

  </div>
</BaseLayout>
