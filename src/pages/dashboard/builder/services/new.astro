---
import DashboardLayout from '@/layouts/DashboardLayout.astro';
---

<DashboardLayout title="Create New Service" role="builder" activeTab="services">
  <div class="max-w-3xl space-y-6">
    <div class="flex items-center justify-between pb-4 border-b border-border">
      <div>
        <span class="text-xs font-bold text-primary uppercase tracking-wider">Service Listing Builder</span>
        <h1 class="text-xl font-bold text-dark mt-0.5">Create a Packaged Website Service</h1>
        <p class="text-xs text-secondary mt-0.5">Publish a fixed-price service package with transparent milestone tiers.</p>
      </div>
      <a href="/dashboard/builder/services" class="text-xs text-secondary hover:text-dark">
        Cancel
      </a>
    </div>

    <form
      onsubmit="event.preventDefault(); alert('Demo Service published successfully to the marketplace!'); window.location.href = '/dashboard/builder/services';"
      class="space-y-6"
    >
      <!-- Step 1: Basic Info -->
      <div class="bg-white rounded-2xl border border-border p-6 shadow-card space-y-4 text-xs">
        <h3 class="text-sm font-bold text-dark border-b border-border pb-2">1. Basic Information</h3>
        <div>
          <label class="block font-bold text-dark mb-1.5">Service Listing Title *</label>
          <input
            type="text"
            required
            placeholder="e.g. I will design and build a conversion-focused Webflow website"
            class="w-full p-2.5 text-sm bg-slate-50 border border-border rounded-xl focus:bg-white focus:outline-none focus:ring-1 focus:ring-primary"
          />
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block font-bold text-dark mb-1.5">Category *</label>
            <select class="w-full p-2.5 text-sm bg-slate-50 border border-border rounded-xl focus:bg-white focus:outline-none">
              <option>Business Websites</option>
              <option>Ecommerce</option>
              <option>Landing Pages</option>
              <option>SaaS Websites</option>
              <option>Web Applications</option>
              <option>Website Redesign</option>
            </select>
          </div>

          <div>
            <label class="block font-bold text-dark mb-1.5">Platform *</label>
            <select class="w-full p-2.5 text-sm bg-slate-50 border border-border rounded-xl focus:bg-white focus:outline-none">
              <option>Webflow</option>
              <option>Shopify</option>
              <option>WordPress</option>
              <option>Framer</option>
              <option>Astro</option>
              <option>Next.js</option>
            </select>
          </div>
        </div>
      </div>

      <!-- Step 2: 3-Tier Pricing Packages -->
      <div class="bg-white rounded-2xl border border-border p-6 shadow-card space-y-4 text-xs">
        <h3 class="text-sm font-bold text-dark border-b border-border pb-2">2. Package Tiers (Starter, Growth, Advanced)</h3>
        
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <!-- Starter -->
          <div class="p-3.5 rounded-xl border border-border bg-slate-50 space-y-3">
            <span class="font-bold text-primary block uppercase text-[11px]">Starter Tier</span>
            <input type="text" placeholder="Package Title" value="Core Launch" class="w-full p-1.5 bg-white border border-border rounded text-xs font-semibold" />
            <div class="flex items-center gap-1">
              <span class="text-slate-400">$</span>
              <input type="number" placeholder="Price" value="2800" class="w-full p-1.5 bg-white border border-border rounded text-xs font-bold" />
            </div>
            <input type="number" placeholder="Delivery Days" value="14" class="w-full p-1.5 bg-white border border-border rounded text-xs" />
          </div>

          <!-- Growth -->
          <div class="p-3.5 rounded-xl border border-primary/40 bg-soft-primary/20 space-y-3">
            <span class="font-bold text-primary block uppercase text-[11px]">Growth (Popular)</span>
            <input type="text" placeholder="Package Title" value="Authority Engine" class="w-full p-1.5 bg-white border border-border rounded text-xs font-semibold" />
            <div class="flex items-center gap-1">
              <span class="text-slate-400">$</span>
              <input type="number" placeholder="Price" value="4800" class="w-full p-1.5 bg-white border border-border rounded text-xs font-bold" />
            </div>
            <input type="number" placeholder="Delivery Days" value="21" class="w-full p-1.5 bg-white border border-border rounded text-xs" />
          </div>

          <!-- Advanced -->
          <div class="p-3.5 rounded-xl border border-border bg-slate-50 space-y-3">
            <span class="font-bold text-primary block uppercase text-[11px]">Advanced Tier</span>
            <input type="text" placeholder="Package Title" value="Enterprise Platform" class="w-full p-1.5 bg-white border border-border rounded text-xs font-semibold" />
            <div class="flex items-center gap-1">
              <span class="text-slate-400">$</span>
              <input type="number" placeholder="Price" value="7800" class="w-full p-1.5 bg-white border border-border rounded text-xs font-bold" />
            </div>
            <input type="number" placeholder="Delivery Days" value="35" class="w-full p-1.5 bg-white border border-border rounded text-xs" />
          </div>
        </div>
      </div>

      <!-- Step 3: Description & Requirements -->
      <div class="bg-white rounded-2xl border border-border p-6 shadow-card space-y-4 text-xs">
        <h3 class="text-sm font-bold text-dark border-b border-border pb-2">3. Detailed Description & Client Requirements</h3>
        <div>
          <label class="block font-bold text-dark mb-1.5">Detailed Service Scope *</label>
          <textarea
            rows={5}
            required
            placeholder="Describe your design and engineering process, what technologies you use, and why clients should choose your service..."
            class="w-full p-2.5 text-sm bg-slate-50 border border-border rounded-xl focus:bg-white focus:outline-none focus:ring-1 focus:ring-primary leading-relaxed"
          />
        </div>

        <div>
          <label class="block font-bold text-dark mb-1.5">What You Will Need From the Client</label>
          <input
            type="text"
            placeholder="e.g. Brand guidelines, copywriting drafts, and platform admin access"
            class="w-full p-2.5 text-sm bg-slate-50 border border-border rounded-xl focus:bg-white focus:outline-none"
          />
        </div>
      </div>

      <div class="flex items-center justify-end gap-3 pt-2">
        <a href="/dashboard/builder/services" class="px-5 py-2.5 border border-border hover:bg-slate-50 text-slate-700 text-xs font-bold rounded-xl transition">
          Discard Draft
        </a>
        <button
          type="submit"
          class="px-7 py-3 bg-primary hover:bg-primary-hover text-white text-xs font-bold rounded-xl shadow-sm transition"
        >
          Publish Service Listing
        </button>
      </div>
    </form>
  </div>
</DashboardLayout>
