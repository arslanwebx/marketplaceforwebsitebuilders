---
import BaseLayout from '@/layouts/BaseLayout.astro';

const helpCategories = [
  { title: 'Getting Started', desc: 'Account creation, role switcher, and navigating the marketplace.', count: '8 articles' },
  { title: 'Hiring Website Builders', desc: 'How to compare proposals, review portfolios, and verify credentials.', count: '12 articles' },
  { title: 'Selling Services as a Builder', desc: 'Publishing packages, configuring milestones, and winning contracts.', count: '15 articles' },
  { title: 'Project Briefs & Proposals', desc: 'Writing effective scopes, timeline estimation, and proposal terms.', count: '10 articles' },
  { title: 'Direct Messaging & Files', desc: 'Workspace communication, file sharing, and video embeds.', count: '7 articles' },
  { title: 'Milestones & Escrow Payments', desc: 'Funding escrow, approving milestones, fees, and dispute mediation.', count: '14 articles' },
  { title: 'Account Security & 2FA', desc: 'Password resets, two-factor auth, and privacy protection.', count: '6 articles' }
];

const popularArticles = [
  'How does milestone escrow protect my project funds?',
  'What is the difference between Packaged Services and Custom Projects?',
  'How can I request revisions before approving a deliverable?',
  'What are the platform fees on CraftGrid?',
  'How do I connect my custom domain to a completed Webflow or Shopify site?'
];
---

<BaseLayout
  title="Help Center & Knowledge Base | CraftGrid"
  description="Guides, tutorials, and frequently asked questions for clients and website builders on CraftGrid."
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16 space-y-12">
    
    <!-- Hero Search -->
    <div class="text-center max-w-2xl mx-auto space-y-4">
      <span class="text-xs font-bold text-primary uppercase tracking-wider">Knowledge Base</span>
      <h1 class="text-3xl sm:text-4xl font-black text-dark tracking-tight">How can we help you?</h1>
      <p class="text-xs sm:text-sm text-secondary">Search articles, guides, and documentation for clients and builders.</p>

      <div class="relative max-w-lg mx-auto pt-2">
        <input
          type="text"
          placeholder="Search help topics (e.g. escrow, milestones, refunds)..."
          class="w-full pl-4 pr-10 py-3 text-sm bg-white border border-border rounded-xl shadow-card focus:outline-none focus:ring-2 focus:ring-primary/20"
        />
        <button class="absolute right-3 top-1/2 -translate-y-1/2 text-primary font-bold text-xs mt-1">
          Search
        </button>
      </div>
    </div>

    <!-- Category Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {helpCategories.map(cat => (
        <div class="bg-white rounded-xl border border-border p-5 shadow-card hover:border-primary/40 transition space-y-2 cursor-pointer">
          <span class="text-[11px] font-bold text-primary uppercase tracking-wide">{cat.count}</span>
          <h3 class="text-base font-bold text-dark">{cat.title}</h3>
          <p class="text-xs text-secondary leading-relaxed">{cat.desc}</p>
        </div>
      ))}
    </div>

    <!-- Popular Articles List -->
    <div class="bg-white rounded-2xl border border-border p-6 sm:p-8 shadow-card space-y-4">
      <h2 class="text-lg font-bold text-dark">Frequently Consulted Guides</h2>
      <div class="divide-y divide-border text-xs">
        {popularArticles.map(art => (
          <div class="py-3 flex items-center justify-between hover:text-primary transition cursor-pointer">
            <span class="font-medium text-slate-800">{art}</span>
            <span class="text-primary font-bold">Read →</span>
          </div>
        ))}
      </div>
    </div>

    <!-- Support CTA -->
    <div class="text-center bg-soft-primary/40 rounded-2xl border border-primary/20 p-8 space-y-3">
      <h3 class="text-lg font-bold text-dark">Still have questions?</h3>
      <p class="text-xs text-secondary max-w-md mx-auto">
        Our customer support team is available Monday–Friday, 9:00 AM–6:00 PM CT to assist with active orders and disputes.
      </p>
      <a
        href="/contact"
        class="inline-block px-6 py-2.5 bg-primary hover:bg-primary-hover text-white text-xs font-bold rounded-xl shadow-xs transition"
      >
        Contact Support Team
      </a>
    </div>

  </div>
</BaseLayout>
